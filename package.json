{
  "name": "cadencelab-astro7",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev --ignore-lock\"",
    "build": "tinacms build --content=local --skip-cloud-checks --skip-indexing && astro build && node scripts/generate-agent-markdown.mjs",
    "check": "tinacms build --content=local --skip-cloud-checks --skip-indexing && astro check",
    "build:ci": "tinacms build --local --skip-indexing --skip-cloud-checks && astro build && node scripts/generate-agent-markdown.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "mcp:sync": "node scripts/sync-mcp-config.mjs",
    "mcp:check": "node scripts/sync-mcp-config.mjs --check",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/react": "7.1.9",
    "@astrojs/sitemap": "3.7.6",
    "@astrojs/ts-plugin": "^1.11.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tinacms/astro": "^0.8.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.13",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tinacms": "^3.15.2",
    "wrangler": "^4.165.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true,
    "fsevents@2.3.3": true,
    "better-sqlite3@12.11.1": true,
    "core-js@3.49.0": true,
    "workerd@1.20261118.1": true
  },
  "devDependencies": {
    "@tinacms/cli": "^4.0.5",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^7.0.2"
  }
}
