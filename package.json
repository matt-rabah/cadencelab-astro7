{
  "name": "cadencelab-astro7",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "tinacms build --content=local --skip-cloud-checks --skip-indexing && astro build",
    "check": "tinacms build --content=local --skip-cloud-checks --skip-indexing && astro check",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write --ignore-unknown",
    "format:check": "prettier --check --ignore-unknown",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tinacms/astro": "^0.6.1",
    "astro": "^7.1.3",
    "astro-font": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fs-extra": "11.3.6",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tinacms": "^3.11.0",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.114.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true,
    "better-sqlite3@12.11.1": true,
    "core-js@3.49.0": true,
    "esbuild@0.24.2": true,
    "esbuild@0.18.20": true,
    "workerd@1.20260714.1": true
  },
  "devDependencies": {
    "@tinacms/cli": "^2.5.6",
    "@types/node": "^26.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
