---
import StructuredCapabilityPage from "../../../components/StructuredCapabilityPage.astro";

const page = {
  meta: {
    title: "AI Customer Experience Design | Cadence Lab",
    description:
      "Design AI experiences with clear roles, trustworthy context, useful controls, human judgment, complete handoffs, safe recovery, and measurable outcomes.",
    canonicalURL: "/product/ai-experience/",
  },
  hero: {
    breadcrumb: "AI Experience",
    eyebrow: "Product · AI Experience",
    title: "A confident answer is not the same as a trustworthy experience.",
    lead: "An AI assistant gives a polished answer based on an old policy. The customer acts on it, reaches a human, and has to explain everything again. The output looked good. The experience failed. AI Experience designs what people should expect, what the system can do, where human judgment belongs, and how the organization recovers when AI gets it wrong.",
    primaryCta: {
      label: "Review AI Service Readiness",
      href: "/services/ai-service-readiness-review/",
    },
    secondaryCta: {
      label: "Start a fit check",
      href: "/fit-check/",
    },
    trigger: {
      introduction:
        "An AI use case can answer a question or complete a task, but the organization has not resolved what people should expect, which evidence they can trust, who remains accountable, or what happens when the result is wrong.",
      items: [
        {
          label: "Visible symptom",
          value: "The AI works, but the experience does not",
        },
        {
          label: "Experience",
          value: "Expect, understand, control, act, recover",
        },
        {
          label: "Decision",
          value: "What role AI should play in the relationship",
        },
      ],
    },
  },
  signals: {
    eyebrow: "Where it breaks",
    title: "AI friction starts when people cannot judge the system.",
    introduction:
      "People need more than a fast answer. They need to understand why AI is involved, what it knows, what it can do, and where accountable human help begins.",
    items: [
      {
        title: "People cannot tell when AI is involved",
        description:
          "Generated responses, recommendations, summaries, routing, or automation shape the interaction without making the system’s role clear.",
      },
      {
        title: "The answer sounds more certain than the evidence",
        description:
          "Fluent language hides old sources, missing context, conflicting records, inference, or uncertainty that could change the decision.",
      },
      {
        title: "Personalization feels intrusive",
        description:
          "The experience uses history, behavior, profile data, or inferred details without explaining why they matter or what control the person has.",
      },
      {
        title: "AI stands between the customer and real help",
        description:
          "People must repeat themselves, prove the system failed, or navigate another loop before reaching someone who can take responsibility.",
      },
      {
        title: "Employees clean up the mistakes in private",
        description:
          "Teams correct answers, rebuild context, reconcile records, and repair trust while the dashboard counts only speed, use, or deflection.",
      },
      {
        title: "Use is mistaken for value",
        description:
          "Adoption rises because AI is available or required, but task success, effort, trust, fairness, recovery, and customer outcomes stay unclear.",
      },
    ],
  },
  framework: {
    eyebrow: "The AI experience",
    title: "Design the AI role and the human responsibility together.",
    introduction:
      "The model is one part of the experience. These six conditions determine whether people can use it with appropriate confidence and get help when they need it.",
    items: [
      {
        label: "Outcome",
        question: "What should improve for the person?",
        title: "Outcome",
        description:
          "Define the person, situation, task, expected benefit, current friction, meaningful risk, and why AI belongs in this part of the journey.",
      },
      {
        label: "Role",
        question: "What is AI allowed to do?",
        title: "Role",
        description:
          "Clarify whether AI finds, summarizes, recommends, creates, predicts, routes, or acts, and what must remain outside its authority.",
      },
      {
        label: "Context",
        question: "What may the system know and use?",
        title: "Context",
        description:
          "Set boundaries for data, history, memory, retrieval, personalization, permissions, freshness, provenance, and sensitive information.",
      },
      {
        label: "Control",
        question: "Can people understand and direct the interaction?",
        title: "Control",
        description:
          "Design disclosure, evidence, uncertainty, choices, corrections, confirmations, feedback, accessibility, and a clear way to stop or change course.",
      },
      {
        label: "Handoff",
        question: "When must a person or another path take over?",
        title: "Handoff",
        description:
          "Define escalation, context transfer, urgent cases, unsupported requests, disagreement, failure, and how accountable support continues the work.",
      },
      {
        label: "Learning",
        question: "What will change the experience over time?",
        title: "Learning",
        description:
          "Connect corrections, overrides, complaints, failure patterns, customer impact, employee effort, and operating results to product decisions.",
      },
    ],
  },
  path: {
    eyebrow: "How the experience moves",
    title: "Follow the person from first expectation through recovery.",
    introduction:
      "Test the complete situation, not just the AI response. The experience includes what happens before, during, and after the model produces an output.",
    items: [
      {
        phase: "Expect",
        question: "Does the person know what AI will do?",
        evidence:
          "Need, channel, prior relationship, disclosure, AI role, expected benefit, alternatives, urgency, accessibility, and known limits.",
      },
      {
        phase: "Inform",
        question: "Does the system have the right context?",
        evidence:
          "User input, records, history, retrieval, memory, permissions, provenance, freshness, missing information, and sensitive data.",
      },
      {
        phase: "Interact",
        question: "Can the person make sense of the result?",
        evidence:
          "Response, choices, evidence, citations, uncertainty, correction, confirmation, refusal, accessibility, language, and interface behavior.",
      },
      {
        phase: "Act",
        question: "Who owns the next decision or action?",
        evidence:
          "Recommendation, human judgment, permission, tool use, record change, reversibility, notification, downstream effect, and accountability.",
      },
      {
        phase: "Recover",
        question: "What happens when AI is wrong?",
        evidence:
          "Escalation, context transfer, complaint, correction, remediation, human support, incident response, customer outcome, and product learning.",
      },
    ],
  },
  evidence: {
    eyebrow: "What to examine",
    title: "Measure what people experience and what the system causes.",
    introduction:
      "A strong model score cannot prove the experience works. Evidence should connect the interaction to the data, workflow, human decisions, and real outcomes around it.",
    items: [
      {
        title: "Human needs and expectations",
        description:
          "Research, goals, context, mental models, trust, accessibility, language, prior experience, vulnerability, and the cost of misunderstanding.",
      },
      {
        title: "Interaction behavior",
        description:
          "Task completion, comprehension, prompts, choices, corrections, abandonment, repeated effort, escalation, feedback, and workarounds.",
      },
      {
        title: "Sources and model behavior",
        description:
          "Data, retrieval, provenance, prompts, models, tools, variation, accuracy, groundedness, latency, refusals, limits, and prohibited outputs.",
      },
      {
        title: "Human judgment and oversight",
        description:
          "Review, edits, overrides, disagreement, authority, automation bias, time burden, expertise, and the evidence available at the decision point.",
      },
      {
        title: "Workflow and action behavior",
        description:
          "Permissions, tool calls, record changes, routing, handoffs, reversibility, exceptions, audit history, failure recovery, and downstream effects.",
      },
      {
        title: "Customer and operating outcomes",
        description:
          "Task success, effort, trust, access, fairness, service quality, resolution, capacity, rework, complaints, retention, risk, and unintended harm.",
      },
    ],
    note: {
      label: "Trust should match the evidence",
      description:
        "The goal is not to make AI feel human or earn blind trust. People should have enough information and control to judge the system’s role, limits, evidence, and the accountable organization behind it.",
    },
  },
  failures: {
    eyebrow: "What goes wrong",
    title: "AI fails the experience when confidence hides the limits.",
    introduction:
      "Speed and personality can make an answer feel complete while hiding weak context, uncertain evidence, unavailable support, or an action no one is ready to own.",
    items: [
      {
        title: "Chat becomes the strategy",
        description:
          "The organization adds a conversational interface without defining the human need, AI role, approved evidence, intended outcome, or alternative path.",
      },
      {
        title: "The system acts more human than it is",
        description:
          "Names, tone, emotion, or visual cues lead people to infer understanding, memory, judgment, or care the system cannot provide.",
      },
      {
        title: "Explanation becomes decoration",
        description:
          "Confidence scores, citations, or generic reasons appear without helping the person check the source, understand uncertainty, or challenge the result.",
      },
      {
        title: "The human handoff starts from zero",
        description:
          "Escalation sends the person to another queue without the history, evidence, urgency, choices, or failed attempts already captured.",
      },
      {
        title: "The customer must find and fix the error",
        description:
          "People must detect the mistake, save the evidence, locate support, and pursue correction because the service has no useful recovery path.",
      },
      {
        title: "The benchmark misses the harm",
        description:
          "Average accuracy looks acceptable while a specific group, sensitive situation, exception, or high-impact failure remains hard to see.",
      },
    ],
  },
  outputs: {
    eyebrow: "What teams receive",
    title: "Leave with an AI experience teams can own.",
    introduction:
      "The outputs define the intended human relationship, the complete service path, the required controls, and how the organization will evaluate real use.",
    items: [
      {
        title: "AI role and experience rules",
        description:
          "The human need, intended benefit, AI role, exclusions, interaction rules, decision boundaries, accountable owner, and implications for delivery.",
      },
      {
        title: "End-to-end AI service blueprint",
        description:
          "The visible journey connected to data, models, tools, workflows, employees, policies, handoffs, exceptions, recovery, and operating dependencies.",
      },
      {
        title: "Interaction and handoff requirements",
        description:
          "Disclosure, context, evidence, uncertainty, controls, confirmation, accessibility, escalation, human support, continuity, and recovery behavior.",
      },
      {
        title: "Evaluation and governance plan",
        description:
          "Representative cases, quality criteria, experience measures, outcomes, review behavior, monitoring, complaints, incident triggers, owners, and review cadence.",
      },
    ],
  },
  fit: {
    eyebrow: "When it fits",
    title: "Use AI Experience when AI changes a meaningful interaction.",
    introduction:
      "This work fits when AI shapes how a customer, employee, patient, member, citizen, or partner gets information, makes a decision, completes a task, or receives support. It is not the right fit for a demo or an automation target that ignores accountability and recovery.",
    items: [
      "A bounded AI use case changes a meaningful task, decision, or service interaction.",
      "The experience depends on identifiable data, sources, models, tools, workflows, and human roles.",
      "Trust, comprehension, accessibility, fairness, privacy, or escalation affects the outcome.",
      "Product, design, operations, technical, risk, data, and frontline owners can decide together.",
      "The organization will narrow or stop the experience when the evidence does not support responsible use.",
    ],
  },
  diagnostics: {
    eyebrow: "Related paths",
    title: "Choose the next step based on what is still unresolved.",
    items: [
      {
        title: "AI Service Readiness Review",
        href: "/services/ai-service-readiness-review/",
        useWhen:
          "A use case needs a readiness decision across workflow, data, human oversight, safeguards, adoption, measurement, and implementation conditions.",
      },
      {
        title: "Experience Foundations",
        href: "/product/experience-foundations/",
        useWhen:
          "Teams need shared customer, journey, ownership, service, and measurement decisions before defining AI’s role in the broader experience.",
      },
      {
        title: "Agent Copilots",
        href: "/ai-tooling/co-pilot/",
        useWhen:
          "The experience supports an employee or specialist with context, recommendations, bounded actions, and accountable human judgment.",
      },
    ],
  },
};
---

<StructuredCapabilityPage {...page} />
