---
import StructuredCapabilityPage from "../../../components/StructuredCapabilityPage.astro";

const page = {
  meta: {
    title: "Customer Experience Foundations | Cadence Lab",
    description:
      "Build the shared customer understanding, journey ownership, workflows, service rules, and measures that digital, location, and AI experiences need to work.",
    canonicalURL: "/product/experience-foundations/",
  },
  hero: {
    breadcrumb: "Experience Foundations",
    eyebrow: "Product · Experience Foundations",
    title: "Fix the foundation before you scale the experience.",
    lead: "When one customer journey crosses five teams, five teams can make sensible choices and still create a mess. Experience Foundations gives them one view of the customer problem, the work behind it, who owns what, and how success will be measured. It creates the operating clarity digital, location, and AI experiences need before more money goes into delivery.",
    primaryCta: {
      label: "Start a fit check",
      href: "/fit-check/",
    },
    secondaryCta: {
      label: "Review diagnostic offers",
      href: "/services/",
    },
    trigger: {
      introduction:
        "The organization is investing in new channels, platforms, automation, or AI, but teams still disagree about the customer problem, the experience they are trying to create, or the operating changes required to deliver it.",
      items: [
        {
          label: "Visible symptom",
          value: "Teams improve their part while the journey stays broken",
        },
        {
          label: "Foundation",
          value: "Customer, journey, rules, ownership, evidence",
        },
        {
          label: "Decision",
          value: "What must be clear before delivery expands",
        },
      ],
    },
  },
  signals: {
    eyebrow: "When it is needed",
    title: "The experience breaks between teams, not inside one screen.",
    introduction:
      "Customers do not care which department owns a problem. They care whether the organization remembers the context, keeps its promises, and helps them finish what they started.",
    items: [
      {
        title: "Every team has a different customer",
        description:
          "Marketing, sales, product, service, and operations use different segments, needs, journeys, and measures to make decisions about the same people.",
      },
      {
        title: "Channels make conflicting promises",
        description:
          "The website says one thing, the CRM records another, and the frontline team has to explain what actually happens.",
      },
      {
        title: "Research does not change the work",
        description:
          "Interviews, surveys, analytics, and journey maps exist, but they are not connected to funding, ownership, workflow, or delivery priorities.",
      },
      {
        title: "The solution arrives before the problem",
        description:
          "A platform, redesign, automation, or AI request starts moving before anyone agrees on the customer outcome or operating cause.",
      },
      {
        title: "No one owns the complete journey",
        description:
          "Each team can improve its touchpoint, but no accountable owner can resolve the policies, handoffs, data, and decisions between them.",
      },
      {
        title: "Launch activity stands in for progress",
        description:
          "Teams track releases, campaigns, and adoption while customer effort, service quality, rework, and business outcomes remain disconnected.",
      },
    ],
  },
  framework: {
    eyebrow: "The foundation",
    title: "Give teams the same facts and clearer decisions.",
    introduction:
      "This is not another vision deck. It is a working agreement that connects what customers need to the way teams prioritize, deliver, and run the experience.",
    items: [
      {
        label: "Customer",
        question: "Whose problem are we solving?",
        title: "Customer",
        description:
          "Define the people, situation, need, expected progress, and consequences that make the experience worth changing.",
      },
      {
        label: "Journey",
        question: "Where does the outcome take shape?",
        title: "Journey",
        description:
          "Identify the moments, decisions, transitions, and breakdowns that matter across channels and organizational boundaries.",
      },
      {
        label: "Rules",
        question: "What should teams decide the same way?",
        title: "Rules",
        description:
          "Set practical service principles, priorities, promises, exceptions, and tradeoffs teams can apply when the usual path does not fit.",
      },
      {
        label: "Ownership",
        question: "Who can change the work behind the journey?",
        title: "Ownership",
        description:
          "Connect each important moment to decision rights, workflows, systems, handoffs, and an owner with enough authority to act.",
      },
      {
        label: "Evidence",
        question: "How will we know what is true?",
        title: "Evidence",
        description:
          "Combine customer research, behavior, service signals, workflow data, frontline knowledge, and business measures without hiding the gaps.",
      },
      {
        label: "Learning",
        question: "How will the foundation stay useful?",
        title: "Learning",
        description:
          "Define who reviews new evidence, when decisions change, how conflicts are resolved, and what triggers another look at the journey.",
      },
    ],
  },
  path: {
    eyebrow: "How the work moves",
    title: "Start with one real problem, then prove the foundation works.",
    introduction:
      "The work stays grounded in a consequential journey. Each step should reduce uncertainty and improve a decision teams already need to make.",
    items: [
      {
        phase: "Frame",
        question: "Which customer problem is worth solving now?",
        evidence:
          "Customer consequence, business impact, scope, affected people, current initiatives, accountable sponsor, and the decision the work must support.",
      },
      {
        phase: "Trace",
        question: "How does the organization create the experience today?",
        evidence:
          "Customer goals, key moments, research, service signals, workflows, policies, systems, handoffs, ownership, measures, and frontline behavior.",
      },
      {
        phase: "Decide",
        question: "What must teams agree on?",
        evidence:
          "Experience intent, priority moments, service rules, ownership, constraints, measures, assumptions, and questions that still need evidence.",
      },
      {
        phase: "Test",
        question: "Does the foundation improve a real choice?",
        evidence:
          "A live use case, policy decision, workflow change, concept, channel requirement, or investment choice tested against the shared foundation.",
      },
      {
        phase: "Run",
        question: "Who will keep it active?",
        evidence:
          "Named owners, review cadence, decision forums, measures, documentation, onboarding, evidence updates, and clear change triggers.",
      },
    ],
  },
  evidence: {
    eyebrow: "What supports it",
    title: "Use evidence from the journey and the work behind it.",
    introduction:
      "Customer feedback alone cannot explain why an experience fails. The foundation should show what customers encounter, what employees do, what systems record, and what no one knows yet.",
    items: [
      {
        title: "Customer goals and context",
        description:
          "Needs, expectations, circumstances, accessibility, language, trust, prior history, desired progress, and the cost of delay or repeated effort.",
      },
      {
        title: "Behavior across the journey",
        description:
          "Research, observation, search, analytics, contact reasons, complaints, drop-off, repeat visits, exceptions, recovery, and channel changes.",
      },
      {
        title: "Workflow and service reality",
        description:
          "Queues, approvals, handoffs, workarounds, capacity, service rules, escalation, and the gap between the intended process and actual work.",
      },
      {
        title: "Ownership and incentives",
        description:
          "Accountability, authority, funding, targets, dependencies, and the places where a customer outcome crosses team boundaries.",
      },
      {
        title: "Systems and information",
        description:
          "CRM records, product data, knowledge, content, identity, integrations, automation, permissions, and the context available at each step.",
      },
      {
        title: "Customer and operating results",
        description:
          "Effort, completion, trust, accessibility, service quality, adoption, retention, cycle time, rework, cost, risk, and evidence that change helped.",
      },
    ],
    note: {
      label: "Shared facts, not false certainty",
      description:
        "The foundation should make evidence, assumptions, gaps, and disagreements visible. It helps teams make better decisions. It does not pretend one map can represent every person or predict every situation.",
    },
  },
  failures: {
    eyebrow: "What goes wrong",
    title: "If it cannot change a decision, it is just an artifact.",
    introduction:
      "Journey maps and principles can create a good workshop. The harder test comes later, when teams must choose what to fund, change, measure, or stop.",
    items: [
      {
        title: "The journey map becomes the answer",
        description:
          "Pain points are documented, but no one assigns decisions, owners, dependencies, measures, or a practical order for fixing them.",
      },
      {
        title: "One persona hides meaningful differences",
        description:
          "A simple profile overlooks differences in context, ability, language, history, risk, intent, and support needs that change the journey.",
      },
      {
        title: "The principles never settle a tradeoff",
        description:
          "Words such as simple or customer-first sound good but offer no help when customer need conflicts with policy, cost, capacity, or risk.",
      },
      {
        title: "Ownership ends at the touchpoint",
        description:
          "A channel team owns the visible interaction but cannot change the policy, workflow, data, or upstream decision causing the problem.",
      },
      {
        title: "Internal opinion replaces customer evidence",
        description:
          "Leadership intent and workshop consensus carry more weight than observed behavior, frontline reality, service data, and people affected by failure.",
      },
      {
        title: "Governance protects the document",
        description:
          "Teams preserve approved language while customer behavior, business conditions, policy, technology, and evidence continue to change.",
      },
    ],
  },
  outputs: {
    eyebrow: "What teams receive",
    title: "Leave with decisions teams can use.",
    introduction:
      "The outputs give teams one practical source for customer priorities, operating ownership, delivery choices, and measurement.",
    items: [
      {
        title: "Experience foundation",
        description:
          "A clear view of the customer problem, priority journey, intended outcome, service rules, operating dependencies, constraints, assumptions, and supporting evidence.",
      },
      {
        title: "Decision guide",
        description:
          "A small set of principles with examples, tradeoffs, exclusions, and questions teams can use when choosing policy, design, workflow, and technology.",
      },
      {
        title: "Journey ownership map",
        description:
          "Named owners, decision rights, workflows, systems, handoffs, and the changes required to manage the journey across team boundaries.",
      },
      {
        title: "Action and measurement plan",
        description:
          "Priority use cases, sequence, owners, customer measures, operating measures, evidence gaps, review cadence, and triggers for changing course.",
      },
    ],
  },
  fit: {
    eyebrow: "When it fits",
    title: "Use Experience Foundations when several teams shape one outcome.",
    introduction:
      "This work fits when digital, physical, service, or AI initiatives need the same customer and operating direction. It is not the right tool for one isolated interface update or for a leadership team that wants alignment without changing ownership, policy, workflow, or measurement.",
    items: [
      "Several teams, systems, or channels influence the same customer outcome.",
      "Research and journey artifacts exist but do not guide priorities or delivery.",
      "A platform, service, digital, location, or AI initiative needs a shared starting point.",
      "An accountable sponsor can resolve cross-functional decisions and assign owners.",
      "The organization is willing to change the work when the evidence supports it.",
    ],
  },
  diagnostics: {
    eyebrow: "Related paths",
    title: "Choose the next step based on what is still unclear.",
    items: [
      {
        title: "CX Systems Diagnostic",
        href: "/services/cx-systems-diagnostic/",
        useWhen:
          "Customer friction crosses teams, systems, service rules, ownership, or handoffs and the operating cause is still unclear.",
      },
      {
        title: "Digital Experiences",
        href: "/product/digital-experiences/",
        useWhen:
          "The foundation needs to become a website, portal, service interface, or connected digital journey.",
      },
      {
        title: "AI Experience",
        href: "/product/ai-experience/",
        useWhen:
          "The journey includes AI assistance, recommendations, automation, or agent behavior that needs clear human and operating boundaries.",
      },
    ],
  },
};
---

<StructuredCapabilityPage {...page} />
