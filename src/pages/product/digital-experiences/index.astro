      "This fits an important website, portal, app, or path that crosses channels, with clear owners on the business and technical side. It isn’t the right fit for a cosmetic refresh if the processes and service behind the screen can’t change.",
    items: [
      "An online path affects whether customers can get help, buy, sign up, trust you, or get things done.",
      "The task involves content, design, accessibility, data, systems, processes, or help from a person.",
      "Teams can inspect what happens before, during, and after a digital request.",
      "The owners of the business, content, design, technology, data, service, and accessibility can decide together.",
      "The organization can maintain the service and measure results after launch.",
    ],
  },
  diagnostics: {
    eyebrow: "Related paths",
    title: "Choose the next step by what stops people from finishing.",
    items: [
      {
        title: "Experience Foundations",
        href: "/product/experience-foundations/",
        useWhen:
          "Several teams or channels need to agree on customers, the path, ownership, and measures before online work starts.",
      },
      {
        title: "CRM Workflow Audit",
        href: "/services/crm-workflow-audit/",
        useWhen:
          "Online requests create records or service work that’s incomplete, unreliable, duplicated, or has no clear owner.",
      },
      {
        title: "CX on Location",
        href: "/product/cx-on-location/",
        useWhen:
          "The path crosses a store, branch, clinic, venue, or other site where online and in-person service have to connect.",
      },
    ],
  },
};

const simplifiedPage = {
  ...page,
  hero: {
    ...page.hero,
    secondaryCta: { label: "See what you receive", href: "#outputs" },
  },
  signals: { ...page.signals, items: page.signals.items.slice(0, 3) },
  framework: undefined,
  path: {
    ...page.path,
    items: [page.path.items[0], page.path.items[2], page.path.items[4]],
  },
  evidence: {
    ...page.evidence,
    items: [
      page.evidence.items[0],
      page.evidence.items[2],
      page.evidence.items[5],
    ],
  },
  failures: undefined,
};
---

<StructuredCapabilityPage {...simplifiedPage} simplified />
