    eyebrow: "The digital service",
    title: "Design the task and everything required to complete it.",
    introduction:
      "The visible interface matters. So does what happens after the click. These six parts need to work as one service.",
    items: [
      {
        label: "Task",
        question: "What is the person trying to finish?",
        title: "Task",
        description:
          "Define the goal, situation, urgency, prior knowledge, constraints, desired result, and cost of confusion or incomplete work.",
      },
      {
        label: "Guidance",
        question: "What does the person need to know?",
        title: "Guidance",
        description:
          "Organize language, requirements, choices, policy, proof, timing, help, and next steps around the decision at hand.",
      },
      {
        label: "Interaction",
        question: "Can people act with confidence?",
        title: "Interaction",
        description:
          "Design navigation, forms, states, feedback, accessibility, identity, consent, errors, and recovery as one understandable flow.",
      },
      {
        label: "Connection",
        question: "What continues the work behind the screen?",
