      {
        title: "Delivery requirements",
        description:
          "Content, interfaces, components, accessibility, identity, data, integrations, workflows, analytics, errors, exceptions, handoffs, and acceptance criteria.",
      },
      {
        title: "Operating and measurement plan",
        description:
          "Product and content ownership, accessibility review, release and incident rhythms, customer measures, operating measures, and evidence for improvement.",
      },
    ],
