        question: "Can the organization deliver the promise?",
        evidence:
          "Identity, data, records, integrations, routing, notifications, handoffs, exceptions, security, privacy, support, and operating readiness.",
      },
      {
        phase: "Run",
        question: "Does the live service improve the outcome?",
        evidence:
          "Completion, quality, accessibility, customer effort, service demand, rework, incidents, feedback, ownership, releases, and outcome measures.",
      },
    ],
  },
  evidence: {
    eyebrow: "What to examine",
