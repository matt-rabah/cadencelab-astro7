---
import StructuredCapabilityPage from "../../../components/StructuredCapabilityPage.astro";

const page = {
  meta: {
    title: "Digital Customer Experiences | Cadence Lab",
    description:
      "Design accessible websites, portals, apps, and digital services that connect customer tasks to clear content, working systems, accountable teams, and measurable outcomes.",
    canonicalURL: "/product/digital-experiences/",
  },
  hero: {
    breadcrumb: "Digital Experiences",
    eyebrow: "Product · Digital Experiences",
    title: "A better screen won’t fix a broken service.",
    lead: "A customer completes a clean, simple form. Then the request lands in a shared inbox and disappears. That’s not just a user experience problem. It’s a service problem. Digital Experiences connects the screen to the content, data, workflows, systems, and people required to help someone finish what they started.",
    primaryCta: {
      label: "Start a fit check",
      href: "/fit-check/",
    },
    secondaryCta: {
      label: "Review Experience Foundations",
      href: "/product/experience-foundations/",
    },
    trigger: {
      introduction:
        "A website, portal, app, or digital service is being redesigned, but the largest sources of friction sit outside the interface in unclear content, policy, data, routing, ownership, and follow-up.",
      items: [
        {
          label: "Visible symptom",
          value: "The screen works, but the service does not",
        },
        {
          label: "Experience",
          value: "Find, understand, act, complete, recover",
        },
        {
          label: "Decision",
          value: "What the complete digital path must deliver",
        },
      ],
    },
  },
