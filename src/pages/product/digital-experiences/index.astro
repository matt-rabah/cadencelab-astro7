      {
        phase: "Shape",
        question: "How should the complete path work?",
        evidence:
          "Information architecture, content model, task flow, states, decisions, channels, service blueprint, ownership, and technical boundaries.",
      },
      {
        phase: "Test",
        question: "Can people understand and complete the task?",
        evidence:
          "The words, steps, forms, and error messages, on phones and computers, with people of different abilities. Do they understand it and finish?",
      },
      {
        phase: "Connect",
        question: "Can the organization deliver the promise?",
        evidence:
          "Identity, data, records, integrations, routing, notifications, handoffs, exceptions, security, privacy, support, and operating readiness.",
      },
      {
        phase: "Run",
        question: "Does the live service improve the outcome?",
        evidence:
          "Whether people finish, how hard it is, whether it works for everyone, how many still call for help, and what has to be redone.",
      },
    ],
  },
  evidence: {
    eyebrow: "What to examine",
    title: "Measure the screen, the service, and the result.",
    introduction:
      "An online path can look great in your analytics and still cause confusion or extra work somewhere else. So I follow the customer and the work all the way to the end.",
    items: [
      {
        title: "Customer intent and behavior",
        description:
          "What people search for, their most common tasks, where they give up, when they come back or ask for help, the devices they use, and the barriers they hit.",
      },
      {
        title: "Content quality",
        description:
          "Accuracy, findability, reading level, hierarchy, terminology, requirements, metadata, duplication, ownership, freshness, and channel consistency.",
      },
      {
        title: "Interaction and accessibility",
        description:
          "Whether it works with a keyboard and a screen reader, text is readable and can be enlarged, forms and error messages make sense, and pages load fast.",
      },
      {
        title: "System and data behavior",
        description:
          "Identity, consent, records, integrations, APIs, automation, state, permissions, reliability, latency, data quality, security, and failure handling.",
      },
      {
        title: "Workflow and support behavior",
        description:
          "Routing, queues, ownership, handoffs, fulfillment, notifications, exceptions, support context, capacity, workarounds, and recovery.",
      },
      {
        title: "Customer and operating outcomes",
        description:
          "Whether people finish and get what they needed, how hard it was, how long it took, how many still need help, cost, risk, and side effects nobody planned for.",
      },
    ],
    note: {
      label: "Accessibility is part of the service",
      description:
        "Accessibility (making it work for people with disabilities) should shape the work from the start. A check at the end can’t undo every decision made before it.",
    },
  },
  failures: {
    eyebrow: "What goes wrong",
    title: "A redesign fails when the broken work stays in place.",
    introduction:
      "A polished interface can make a weak service look more credible. That only moves the frustration further down the journey.",
    items: [
      {
        title: "The homepage becomes the whole strategy",
        description:
          "Brand, navigation, campaigns, and stakeholder requests fill the first screen while the tasks, forms, support paths, and service outcomes receive less attention.",
      },
      {
        title: "The design system repeats the wrong behavior",
        description:
          "Components create visual consistency while content, workflow states, error recovery, accessibility, and channel decisions remain inconsistent.",
      },
      {
        title: "Old content moves into a new platform",
        description:
          "Pages are migrated without deciding what is necessary, accurate, owned, findable, duplicated, or connected to a customer task.",
      },
      {
        title: "The form improves but the queue doesn’t",
        description:
          "Submission gets easier while missing context, duplicate entry, manual review, unclear routing, and slow follow-up continue behind it.",
      },
      {
        title: "Responsive is mistaken for inclusive",
        description:
          "The layout adapts to screen size, but language, cognition, motion, focus, identity, forms, media, timing, or unavailable support still excludes people.",
      },
      {
        title: "Launch ends the learning",
        description:
          "The project closes when the new experience ships, leaving no durable owner for content, accessibility, journey quality, service results, or improvement.",
      },
    ],
  },
  outputs: {
    eyebrow: "What teams receive",
    title: "Leave with a service teams can build and run.",
    introduction:
      "What you get connects what customers need to do with the content, technology, processes, owners, and measures it takes to deliver.",
    items: [
      {
        title: "Direction for the online service",
        description:
          "Which customers and tasks matter most, the results you want, what’s in and out of scope, and the evidence behind each choice.",
      },
      {
        title: "Map of the path and the content",
        description:
          "How information is organized, the steps, what happens when people switch to phone or in person, who owns each part, and the whole path from start to result.",
      },
      {
        title: "Requirements to build it",
        description:
          "The content, screens, accessibility, data, connections to other systems, processes, error handling, and what counts as done.",
      },
      {
        title: "Plan to run and measure it",
        description:
          "Who owns the product and content, accessibility reviews, how often you release changes and handle problems, and the measures that show what to improve.",
      },
    ],
  },
  fit: {
    eyebrow: "When it fits",
    title:
      "Use Digital Experiences when the screen and service must improve together.",
