---
import StructuredCapabilityPage from "../../../components/StructuredCapabilityPage.astro";

const page = {
  meta: {
    title: "Digital Customer Experiences | Cadence Lab",
    description:
      "Design accessible websites, portals, apps, and digital services that connect customer tasks to clear content, working systems, accountable teams, and measurable outcomes.",
    canonicalURL: "/product/digital-experiences/",
  },
  hero: {
    breadcrumb: "Digital Experiences",
    eyebrow: "Product · Digital Experiences",
    title: "A better screen won’t fix a broken service.",
    lead: "A customer completes a clean, simple form. Then the request lands in a shared inbox and disappears. That’s not just a user experience problem. It’s a service problem. Digital Experiences connects the screen to the words, data, processes, systems, and people it takes to help someone finish what they started.",
    primaryCta: {
      label: "Start a FitCheck™",
      href: "/fit-check/",
    },
    secondaryCta: {
      label: "Review Experience Foundations",
      href: "/product/experience-foundations/",
    },
    trigger: {
      introduction:
        "You’re redesigning a website, portal, or app. But the biggest problems sit behind the screen: unclear content and policy, bad data, requests going to the wrong place, no clear owner, and weak follow-up.",
      items: [
        {
          label: "Visible symptom",
          value: "The screen works, but the service doesn’t",
        },
        {
          label: "Experience",
          value: "Find it, understand it, do it, finish it, fix mistakes",
        },
        {
          label: "Decision",
          value: "What the whole online path has to deliver",
        },
      ],
    },
  },
  signals: {
    eyebrow: "Where it breaks",
    title: "Online problems rarely stay on the screen.",
    introduction:
      "Customers see one task. Inside the business, it’s often split across pages, tools, teams, and support channels. Every gap adds work for the customer.",
    items: [
      {
        title: "People can’t find the right starting point",
        description:
          "The menus follow your org chart, not what customers came to do. The next step is hard to spot.",
      },
      {
        title: "The content explains but doesn’t help",
        description:
          "The information may be accurate, but what people need, their options, deadlines, and how to finish are scattered across pages.",
      },
      {
        title: "A form creates more manual work",
        description:
          "The form turns into an email or a half-finished record that someone has to read, fix, send on, and type in again.",
      },
      {
        title: "Customers restart when the channel changes",
        description:
          "Identity, history, documents, and prior decisions don’t follow people from web to phone, chat, location, sales, or service.",
      },
      {
        title: "Accessibility is checked too late",
        description:
          "Language, structure, forms, focus, errors, media, motion, and assistive technology are reviewed after the experience is already difficult to change.",
      },
      {
        title: "The dashboard says success while service demand rises",
        description:
          "Traffic and submissions improve, but repeat contact, rework, abandonment, unresolved needs, and customer effort remain out of view.",
      },
    ],
  },
  framework: {
    eyebrow: "The digital service",
    title: "Design the task and everything required to complete it.",
    introduction:
      "The visible interface matters. So does what happens after the click. These six parts need to work as one service.",
    items: [
      {
        label: "Task",
        question: "What is the person trying to finish?",
        title: "Task",
        description:
          "Define the goal, situation, urgency, prior knowledge, constraints, desired result, and cost of confusion or incomplete work.",
      },
      {
        label: "Guidance",
        question: "What does the person need to know?",
        title: "Guidance",
        description:
          "Organize language, requirements, choices, policy, proof, timing, help, and next steps around the decision at hand.",
      },
      {
        label: "Interaction",
        question: "Can people act with confidence?",
        title: "Interaction",
        description:
          "Design navigation, forms, states, feedback, accessibility, identity, consent, errors, and recovery as one understandable flow.",
      },
      {
        label: "Connection",
        question: "What continues the work behind the screen?",
        title: "Connection",
        description:
          "Connect records, integrations, routing, automation, notifications, fulfillment, and the context required after submission.",
      },
      {
        label: "Continuity",
        question: "What happens when the digital path isn’t enough?",
        title: "Continuity",
        description:
          "Give customers a clear route to human help, another channel, an exception, or recovery without making them start over.",
      },
      {
        label: "Operation",
        question: "Who keeps the service useful?",
        title: "Operation",
        description:
          "Assign owners for content, product, accessibility, platform, service, incidents, measurement, and changes after launch.",
      },
    ],
  },
  path: {
    eyebrow: "How the work moves",
    title: "Follow the task from first question to final result.",
