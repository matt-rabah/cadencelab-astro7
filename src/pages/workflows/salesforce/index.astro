---
import BreadcrumbSchema from "../../../components/BreadcrumbSchema.astro";
import Footer from "../../../components/Footer.astro";
import NavHeader from "../../../components/NavHeader.astro";
import SectionNav from "../../../components/SectionNav.astro";
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/solution-depth.css";

const traceStages = [
  {
    number: "01",
    label: "Customer event",
    question: "What happened, and where did it enter?",
    description:
      "Identify the request, risk, or service event, and the channel, form, connected system, or person that first recorded it.",
  },
  {
    number: "02",
    label: "Record behavior",
    question: "How did Salesforce represent the work?",
    description:
      "Trace the record, its fields and history, related records, and the information available to the people expected to act.",
  },
  {
    number: "03",
    label: "Assignment and action",
    question: "Who or what decided what happened next?",
    description:
      "Follow assignments, queues, automation, approvals, alerts, changes of owner, and decisions people made by hand.",
  },
  {
    number: "04",
    label: "Handoffs and exceptions",
    question: "Where did information or ownership get lost?",
    description:
      "Look at transfers, exceptions, stuck records, workarounds, and how problems got fixed.",
  },
  {
    number: "05",
    label: "Outcome and evidence",
    question: "Can you tell whether the work succeeded?",
    description:
      "Connect the result for the customer and the business to the records, measures, and reviews.",
  },
];

const evidenceSources = [
  {
    title: "Records and fields",
    description:
      "How Salesforce is meant to store information about customers, accounts, cases, deals, tasks, and customer stages.",
  },
  {
    title: "Rules and automation",
    description:
      "The logic that assigns work, changes status, creates tasks, notifies teams, and moves records.",
  },
  {
    title: "Queues, roles, and ownership",
    description:
      "Who receives, decides, acts, approves, and recovers the work.",
  },
  {
    title: "Reports and measures",
    description:
      "The dashboards, definitions, filters, and reviews leaders use to read activity and outcomes.",
  },
  {
    title: "Connections to other systems",
    description:
      "The handoffs between Salesforce and your service, marketing, billing, product, data, or help-content systems.",
  },
  {
    title: "Frontline behavior and workarounds",
    description:
      "The spreadsheets, messages, double data entry, reminders, and informal coordination that get the real work done.",
  },
];

const failureModes = [
  {
    cue: "The record is complete, but the context isn’t",
    consequence:
      "Required fields are filled while the customer history, urgency, or reason for action remains unclear.",
  },
  {
    cue: "Automation moves the record, not the work",
    consequence:
      "Statuses and tasks change correctly, but ownership and the next customer action remain unclear.",
  },
  {
    cue: "Every team has a different version of the workflow",
    consequence:
      "Salesforce shows the official process, while teams rely on their own rules and tools to handle real cases.",
  },
  {
    cue: "Reporting explains activity after the useful window",
    consequence:
      "Dashboards show volume and completion, but risk or delay isn't visible early enough to act.",
  },
];

const traceOutputs = [
  {
    number: "01",
    title: "Trace of how the work really moved",
    description:
      "One shared view of the event as it moves through records, rules, roles, systems, decisions, and exceptions.",
  },
  {
    number: "02",
    title: "Missing information",
    description:
      "The information that’s missing, late, unreliable, duplicated, or unavailable when a decision is made.",
  },
  {
    number: "03",
    title: "Ownership and automation findings",
    description:
      "Where responsibility is unclear, system behavior conflicts with the work, or automation adds risk.",
  },
  {
    number: "04",
    title: "Repair sequence",
    description:
      "A practical order for changes to the process, ownership, data, reports, training, and setup.",
  },
];

const usefulWhen = [
  "Teams don’t trust Salesforce to tell them what requires attention.",
  "Customer work crosses sales, success, service, operations, or technical teams.",
  "Important cases depend on spreadsheets, messages, or individual memory.",
  "Automation exists, but exceptions and handoffs still have to be fixed by hand.",
  "Leaders see activity reports, but no reliable view of results for customers or the business.",
];
---

<Layout
  title="Salesforce Tracing | Cadence Lab"
  description="Follow customer work through Salesforce records, automation, ownership, handoffs, and outcomes to find where the workflow breaks."
  canonicalURL="/workflows/salesforce/"
  pageType="website"
>
  <NavHeader />
  <BreadcrumbSchema currentName="Salesforce tracing" />

  <main id="main-content" class="salesforce-page" tabindex="-1">
    <section class="salesforce-hero" aria-labelledby="salesforce-title">
      <div class="page-container hero-layout">
        <div class="hero-copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
              <li>
                <a href="/">Home</a>
              </li>
              <li aria-current="page">Salesforce tracing</li>
            </ol>
          </nav>

          <p class="eyebrow">Workflow · Salesforce tracing</p>
          <h1 id="salesforce-title">
            Find where Salesforce stops helping the work.
          </h1>
          <p class="hero-lead">
            I take one real customer event and follow it through Salesforce: the
            records, the automatic rules, the owners, the connections to other
            systems, and the decisions. That shows where Salesforce helps the
            work and where information or responsibility gets lost.
          </p>

          <div class="hero-actions" aria-label="Salesforce tracing actions">
            <a
              class="button button-primary"
              href="/services/crm-workflow-audit/"
            >
              Review the CRM Workflow Audit
            </a>
            <a class="button button-text" href="/fit-check/">
              Start a FitCheck™
              <span aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </div>

        <aside class="trigger-card" aria-labelledby="trigger-title">
          <p id="trigger-title" class="note-label">
            Recognizable trigger
          </p>
          <p>
            Salesforce is full of records and dashboards, but people still piece
            together the customer’s story from messages, spreadsheets, meetings,
            and memory.
          </p>
          <dl>
            <div>
              <dt>Visible symptom</dt>
              <dd>Nobody trusts the CRM, so people work around it by hand</dd>
            </div>
            <div>
              <dt>Trace</dt>
              <dd>
                The event, the record, the rules, the owner, the action, the
                result
              </dd>
            </div>
            <div>
              <dt>Decision</dt>
              <dd>What to fix before adding more automation</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <SectionNav
      items={[
        { label: "What tracing does", href: "#what-tracing-does" },
        { label: "Explore", href: "#details" },
        { label: "Outputs", href: "#outputs" },
        { label: "Fit", href: "#fit" },
      ]}
    />

    <section
      id="what-tracing-does"
      class="tracing-purpose section-block"
      aria-labelledby="tracing-purpose-title"
    >
      <div class="page-container purpose-layout">
        <div>
          <p class="eyebrow">What tracing does</p>
          <h2 id="tracing-purpose-title">
            Start with a real event, not the setup.
          </h2>
        </div>

        <div class="purpose-copy">
          <p>
            Pick an escalation, a renewal at risk, a slow customer start, a
            service exception, a lead passed from marketing to sales, or an
            account change. Then follow what people and systems did from start
            to finish.
          </p>
          <p>
            How Salesforce is set up matters, but it isn’t where I start. An
            automation can be technically correct and still hide information,
            create duplicate work, support the wrong decision, or leave nobody
            responsible.
          </p>
        </div>
      </div>
    </section>

    <div id="details" class="solution-depth-group">
      <details class="solution-depth" name="salesforce-details" open>
        <summary class="disclosure-summary">
          <span class="solution-depth-title">How the trace works</span>
          <span class="solution-depth-description">
            Follow one customer event through records, assignments, handoffs,
            and results.
          </span>
        </summary>
        <section
          data-band
          id="trace-stages"
          class="trace-stages"
          aria-labelledby="trace-stages-title"
        >
          <div class="page-container section-stack">
            <div class="section-intro section-intro-inverse">
              <p class="eyebrow eyebrow-inverse">Trace stages</p>
              <h2 id="trace-stages-title">
                Follow the event from start to finish.
              </h2>
              <p>
                At each stage, ask whether the next person or system has enough
                information, authority, and evidence to act.
              </p>
            </div>

            <ol class="trace-list">
              {traceStages.map((stage) => (
                <li>
                  <div class="trace-marker">
                    <p class="seq-number">{stage.number}</p>
                  </div>
                  <div class="trace-content">
                    <p class="seq-label trace-label">{stage.label}</p>
                    <h3>{stage.question}</h3>
                    <p>{stage.description}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </section>
      </details>

      <details class="solution-depth" name="salesforce-details">
        <summary class="disclosure-summary">
          <span class="solution-depth-title">What evidence matters</span>
          <span class="solution-depth-description">
            Compare how Salesforce is set up with real records, what teams do,
            and the results.
          </span>
        </summary>
        <section
          id="evidence"
          class="evidence section-block"
          aria-labelledby="evidence-title"
        >
          <div class="page-container section-stack">
            <div class="section-intro section-intro-split">
              <div>
                <p class="eyebrow">Evidence</p>
                <h2 id="evidence-title">
                  Compare the planned process with the real one.
                </h2>
              </div>
              <p>
                Put Salesforce’s setup and automation next to real records,
                measures, handoffs to other systems, and the experience of the
                people doing the work.
              </p>
            </div>

            <div class="evidence-grid">
              {evidenceSources.map((source, index) => (
                <article>
                  <h3>{source.title}</h3>
                  <p>{source.description}</p>
                </article>
              ))}
            </div>

            <div class="evidence-note">
              <p class="note-label">Evidence before certainty</p>
              <p>
                Keep what the system actually did separate from what teams think
                happened. Say where missing records or data limit what you can
                conclude.
              </p>
            </div>
          </div>
        </section>
      </details>

      <details class="solution-depth" name="salesforce-details">
        <summary class="disclosure-summary">
          <span class="solution-depth-title">Where workflows fail</span>
          <span class="solution-depth-description">
            See how complete records and working automation can still hide
            broken work.
          </span>
        </summary>
        <section
          data-band
          id="failure-modes"
          class="failure-modes"
          aria-labelledby="failure-modes-title"
        >
          <div class="page-container failure-layout">
            <div class="failure-intro">
              <p class="eyebrow eyebrow-inverse">Common failure modes</p>
              <h2 id="failure-modes-title">
                A clean record can hide a broken process.
              </h2>
              <p>
                Salesforce can look tidy while the work around it is in pieces.
                These patterns show where to look more closely.
              </p>
            </div>

            <div class="failure-list">
              {failureModes.map((failure, index) => (
                <article>
                  <h3>{failure.cue}</h3>
                  <p>{failure.consequence}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      </details>
    </div>

    <section
      id="outputs"
      class="outputs section-block"
      aria-labelledby="outputs-title"
    >
      <div class="page-container section-stack">
        <div class="section-intro">
          <p class="eyebrow">Outputs</p>
          <h2 id="outputs-title">Turn the trace into a repair plan.</h2>
          <p>
            Make today’s process clear enough for leaders to decide what to
            change first.
          </p>
        </div>

        <ol class="output-list">
          {traceOutputs.map((output) => (
            <li>
              <div>
                <h3>{output.title}</h3>
                <p>{output.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="fit" class="fit" aria-labelledby="fit-title">
      <div class="page-container fit-layout">
        <div class="fit-copy">
          <p class="eyebrow">Fit</p>
          <h2 id="fit-title">
            Use tracing when Salesforce records the work but doesn't guide it.
          </h2>
          <p>
            This fits problems that cross records, roles, automation, connected
            systems, and customer-facing teams. It isn’t routine admin support
            or a setup project that’s already been decided.
          </p>

          <a class="button button-primary" href="/fit-check/">
            Start a FitCheck™
          </a>
        </div>

        <aside class="fit-list" aria-labelledby="fit-list-title">
          <p id="fit-list-title" class="note-label">
            Useful when
          </p>
          <ul>
            {usefulWhen.map((condition) => (
              <li>{condition}</li>
            ))}
          </ul>
        </aside>
      </div>
    </section>

    <section class="independence-note" aria-labelledby="independence-title">
      <div class="page-container">
        <p id="independence-title" class="note-label">
          Independent perspective
        </p>
        <p>
          Cadence Lab is an independent practice and isn’t affiliated with,
          sponsored by, or endorsed by Salesforce. Salesforce is a trademark of
          Salesforce, Inc.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .salesforce-page {
    width: 100%;
    overflow: clip;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .page-container {
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
  }

  .section-block {
    padding-block: var(--section-space);
  }

  .salesforce-hero {
    padding-block: var(--section-space);
    border-bottom: var(--border-width) solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(19rem, 0.65fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .hero-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumb li {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .breadcrumb li + li::before {
    margin-inline-end: 0.5rem;
    color: var(--color-border-strong);
    content: "/";
  }

  .breadcrumb a {
    color: var(--color-blue);
    text-underline-offset: 0.25em;
  }

  .eyebrow,
  .note-label {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    letter-spacing: 0;
    font-feature-settings: var(--fea-eyebrow);
  }

  .trace-label {
    margin: 0;
  }

  .item-number {
    margin: 0;
  }

  .eyebrow-inverse {
    color: var(--color-text-muted);
  }

  h1,
  h2,
  h3,
  p,
  li,
  a,
  dt,
  dd {
    font-family: var(--font-sans);
    font-feature-settings: var(--fea-graphik);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  h1 {
    max-width: 17ch;
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  .hero-lead {
    max-width: 64ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .button {
    display: inline-flex;
    min-height: var(--control-min-size);
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.75rem 1rem;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    text-decoration: none;
  }

  .button-primary {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-light);
  }

  .button-text {
    color: var(--color-blue);
  }

  .trigger-card {
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: var(--border-width) solid var(--color-border);
    border-top: 2px solid var(--color-text);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card-ambient);
    background: var(--color-surface-pure);
  }

  .trigger-card > p:not(.note-label) {
    margin: 1rem 0 0;
    color: var(--color-ink);
    font-size: var(--fs-body-ui);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .trigger-card dl {
    display: grid;
    margin: 1.5rem 0 0;
  }

  .trigger-card dl > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.9rem;
    border-top: var(--border-width) solid var(--color-border);
  }

  .trigger-card dt,
  .trigger-card dd {
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .trigger-card dt {
    color: var(--color-text-muted);
  }

  .trigger-card dd {
    margin: 0;
    color: var(--color-ink);
    font-weight: var(--fw-medium);
  }

  .purpose-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .purpose-layout h2,
  .section-intro h2,
  .failure-intro h2,
  .fit-copy h2 {
    max-width: 19ch;
    margin-top: 0.75rem;
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  .purpose-copy {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .purpose-copy p,
  .section-intro > p:not(.eyebrow),
  .failure-intro > p:not(.eyebrow),
  .fit-copy > p:not(.eyebrow) {
    max-width: var(--measure-ui);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .section-stack {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  .section-intro {
    display: flex;
    max-width: 52rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .section-intro h2,
  .failure-intro h2 {
    margin-top: -0.5rem;
  }

  .section-intro-inverse h2,
  .failure-intro h2 {
    color: var(--color-light);
  }

  .section-intro-inverse > p:not(.eyebrow),
  .failure-intro > p:not(.eyebrow) {
    color: var(--color-text-inverse-muted);
  }

  .section-intro-split {
    display: grid;
    max-width: none;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .section-intro-split > p {
    align-self: end;
  }

  .trace-stages,
  .failure-modes {
    padding-block: var(--section-space);
    background: var(--color-ink);
    color: var(--color-light);
  }

  .trace-list {
    display: grid;
    margin: 0;
    padding: 0;
    border-bottom: var(--border-width) solid var(--color-border);
    list-style: none;
  }

  .trace-list li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    padding-block: 1.5rem;
    border-top: var(--border-width) solid var(--color-border);
  }

  .trace-content h3 {
    max-width: 34ch;
    margin-top: 0.65rem;
    color: var(--color-light);
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: 1.35;
  }

  .trace-content > p:last-child {
    max-width: var(--measure-ui);
    margin: 0.75rem 0 0;
    color: var(--color-text-inverse-muted);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--border-width) solid var(--color-border);
    border-inline-start: var(--border-width) solid var(--color-border);
  }

  .evidence-grid article {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2rem);
    border-inline-end: var(--border-width) solid var(--color-border);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .evidence-grid h3 {
    margin-top: 1.75rem;
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: 1.35;
  }

  .evidence-grid article > p:last-child {
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .evidence-note {
    max-width: 52rem;
    padding: clamp(1.5rem, 4vw, 2rem);
    border-inline-start: 2px solid var(--color-text);
    background: var(--color-surface-subtle);
  }

  .evidence-note > p:last-child {
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .failure-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .failure-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .failure-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: var(--border-width) solid var(--color-border-inverse);
    border-inline-start: var(--border-width) solid var(--color-border-inverse);
  }

  .failure-list article {
    padding: clamp(1.5rem, 4vw, 2rem);
    border-inline-end: var(--border-width) solid var(--color-border-inverse);
    border-bottom: var(--border-width) solid var(--color-border-inverse);
  }

  .failure-list h3 {
    margin-top: 1.5rem;
    color: var(--color-light);
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
