---
import BreadcrumbSchema from "../../../components/BreadcrumbSchema.astro";
import Footer from "../../../components/Footer.astro";
import NavHeader from "../../../components/NavHeader.astro";
import SectionNav from "../../../components/SectionNav.astro";
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/solution-depth.css";

const routingConditions = [
  {
    number: "01",
    title: "Serious consequences",
    description:
      "Send a decision to a person if it could affect a customer, a promise, a payment, access, safety, or anything hard to undo.",
  },
  {
    number: "02",
    title: "Not enough information",
    description:
      "Stop when needed information is missing, contradictory, out of date, unavailable, or outside the data the AI is allowed to use.",
  },
  {
    number: "03",
    title: "Doubt it can’t resolve",
    description:
      "Hand over when the AI can’t clear up something important, or can’t back up its next step with evidence.",
  },
  {
    number: "04",
    title: "An exception to the rules",
    description:
      "Stop the AI from making up permission when a request falls outside the approved rules.",
  },
  {
    number: "05",
    title: "Customer request or distress",
    description:
      "Respect a request for a person, and recognize signs of urgency, vulnerability, frustration, or lost trust.",
  },
  {
    number: "06",
    title: "System or tool failure",
    description:
      "Have a way to recover when something it relies on fails, an action can’t be confirmed, or the response may break down.",
  },
];

const routingPath = [
  {
    phase: "Recognize",
    question: "What’s happening that the AI isn’t meant to handle?",
    evidence:
      "A serious consequence, doubt, missing information, an exception, a request for a person, or a failure.",
  },
  {
    phase: "Pause",
    question: "What must stop while a person takes responsibility?",
    evidence:
      "Actions about to happen, promises to the customer, automatic follow-ups, and anything the AI was about to do.",
  },
  {
    phase: "Transfer",
    question: "What information and urgency must go with the case?",
    evidence:
      "What the customer wants, the conversation, the evidence, what’s been done, what’s unclear, and the deadline.",
  },
  {
    phase: "Decide",
    question: "Who can judge the case and has the authority to act?",
    evidence:
      "Who receives it, what they can decide, their expertise, how they respond, and how they update the customer.",
  },
  {
    phase: "Return",
    question: "How does the outcome update the customer and the system?",
    evidence:
      "The resolution, the reasons, updated records, follow-up, feedback, and any changes to the handover rules.",
  },
];

const contextRequirements = [
  {
    label: "Customer intent",
    description:
      "What the customer is trying to do, not just the latest message or classified topic.",
  },
  {
    label: "Conversation and prior action",
    description:
      "Relevant history, promises made, what the AI did or changed, what it showed the customer, and what’s already been tried.",
  },
  {
    label: "Reason for routing",
    description:
      "The limit, doubt, exception, failure, or request that made the AI stop.",
  },
  {
    label: "Consequence and timing",
    description:
      "The impact, urgency, how long it’s been, what was promised, and how soon someone needs to respond.",
  },
  {
    label: "Evidence and uncertainty",
    description:
      "The sources used, missing or conflicting information, how sure the AI was, and questions that still need a person’s judgment.",
  },
  {
    label: "Ownership and next action",
    description:
      "Who receives it, how fast they should confirm, what they can do, the customer update, and a backup if they can’t act.",
  },
];

const failurePatterns = [
  {
    cue: "The conversation transfers but the reasoning doesn’t",
    description:
      "A person gets a chat log, but not what the customer wants, what’s been tried, the evidence, or the open question.",
  },
  {
    cue: "Uncertainty is hidden behind a confident response",
    description:
      "The AI keeps going because the process can’t spot doubt, missing evidence, or a case it shouldn’t handle.",
  },
  {
    cue: "The route reaches a person without decision authority",
    description:
      "A person owns the conversation but can't approve the exception, correct the record, or change the outcome.",
  },
  {
    cue: "The human queue loses the consequence",
    description:
      "The case arrives with a generic priority that hides the impact, how long it’s waited, or what was promised.",
  },
  {
    cue: "Automation continues while the case waits",
    description:
      "Messages or actions keep going out after the handover, causing contradictions, duplicate work, or more harm.",
  },
  {
    cue: "Human decisions never improve the route",
    description:
      "Corrections, overrides, and repeat causes stay outside the review process, so the same failures continue.",
  },
];

const evidenceSources = [
  {
    title: "Conversations and customer signals",
    description:
      "What customers asked, the words they used, how often they repeated themselves, requests for a person, and what happened next.",
  },
  {
    title: "System decisions and tool activity",
    description:
      "The AI’s instructions, how it sorted requests, its sources and answers, and every record or action it changed or tried.",
  },
  {
    title: "Routing triggers and boundaries",
    description:
      "The approved conditions, rules for stopping, actions it must never take, known exceptions, backups, and why each case was handed over.",
  },
  {
    title: "How people pick up and respond",
    description:
      "Who gets the case, its priority, how fast they confirm, workload, authority, waiting time, teamwork, and customer updates.",
  },
  {
    title: "Corrections and overrides",
    description:
      "What people changed, rejected, approved, or fixed, and whether the cause was data, the AI’s instructions, the process, or policy.",
  },
  {
    title: "Customer and operating outcomes",
    description:
      "How well problems were solved, repeat contacts, rework, delays, trust, cost, safety, and whether the handover improved the result.",
  },
];

const routingOutputs = [
  {
    number: "01",
    title: "Map of what AI may decide",
    description:
      "One shared view of what the AI may handle, what needs a person’s judgment, and which actions need approval.",
  },
  {
    number: "02",
    title: "Handover and priority rules",
    description:
      "Clear triggers, when to stop, response expectations, who receives each case, what they can do, backups, and how to update customers.",
  },
  {
    number: "03",
    title: "What the person receives",
    description:
      "What the customer wants, the history, the evidence, what’s been tried, what’s unclear, the impact, and the next question.",
  },
  {
    number: "04",
    title: "Review and improvement loop",
    description:
      "Measures and reviews that link handovers, overruled decisions, failures, people’s decisions, results, and changes to the system.",
  },
];

const strongFit = [
  "An AI tool can talk to customers or take actions that matter.",
  "Cases can go to a person, but they arrive without enough information or urgency.",
  "Teams can’t explain when the AI should stop, wait, ask, or hand over.",
  "The same exceptions, corrections, and overruled decisions keep happening, and nothing changes.",
  "A senior sponsor can bring process owners, frontline teams, risk and compliance partners, and technical owners together.",
];
---

<Layout
  title="AI-to-human Routing | Cadence Lab"
  description="Design AI-to-human routing around clear boundaries, safe pauses, useful context, human authority, and accountable outcomes."
  canonicalURL="/workflows/agent-routing/"
  pageType="website"
>
  <NavHeader />
  <BreadcrumbSchema currentName="AI-to-human routing" />

  <main id="main-content" class="routing-page" tabindex="-1">
    <section class="routing-hero" aria-labelledby="routing-title">
      <div class="page-container hero-layout">
        <div class="hero-copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
              <li>
                <a href="/">Home</a>
              </li>
              <li aria-current="page">AI-to-human routing</li>
            </ol>
          </nav>

          <p class="eyebrow">Workflow · AI-to-human routing</p>
          <h1 id="routing-title">
            Human oversight only works when the person can act.
          </h1>
          <p class="hero-lead">
            Decide when AI must stop and hand over to a person, and what that
            person needs to know. Then decide who has the authority to act, and
            how the result gets back into your systems.
          </p>

          <div class="hero-actions" aria-label="AI-to-human routing actions">
            <a
              class="button button-primary"
              href="/services/ai-service-readiness-review/"
            >
              Review the AI Service Readiness Review
            </a>
            <a class="button button-text" href="/fit-check/">
              Start a FitCheck™
              <span aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </div>

        <aside class="trigger-card" aria-labelledby="trigger-title">
          <p id="trigger-title" class="note-label">
            Recognizable trigger
          </p>
          <p>
            AI can answer, sort, suggest, or act. But nobody can clearly say
            when it must stop, who takes over, or what that person needs.
          </p>
          <dl>
            <div>
              <dt>Boundary</dt>
              <dd>Where the AI has to stop</dd>
            </div>
            <div>
              <dt>Transfer</dt>
              <dd>
                What the customer wants, the evidence, what’s been done, what’s
                unclear, the impact
              </dd>
            </div>
            <div>
              <dt>Outcome</dt>
              <dd>A person decides and closes the case</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <SectionNav
      items={[
        { label: "What routing does", href: "#what-routing-does" },
        { label: "Explore", href: "#details" },
        { label: "Evidence and outputs", href: "#evidence-outputs" },
        { label: "Fit", href: "#fit" },
      ]}
    />

    <section
      id="what-routing-does"
      class="routing-purpose section-block"
      aria-labelledby="routing-purpose-title"
    >
      <div class="page-container purpose-layout">
        <div>
          <p class="eyebrow">What routing does</p>
          <h2 id="routing-purpose-title">
            Plan exactly where automation stops and a person takes over.
          </h2>
        </div>

        <div class="purpose-copy">
          <p>
            Human checks only help if the process can spot when judgment is
            needed, stop safely, and pass the work to someone who can change the
            outcome.
          </p>
          <p>
            A routing map covers each of those moments: the impact, the
            evidence, the urgency, and who owns it. It also covers what they can
            do, how you update the customer, and how you fix and review it. The
            person becomes part of the process, not a last resort.
          </p>
        </div>
      </div>
    </section>

    <div id="details" class="solution-depth-group solution-depth-group-four">
      <details class="solution-depth" name="routing-details" open>
        <summary class="disclosure-summary">
          <span class="solution-depth-title">When AI should hand off</span>
          <span class="solution-depth-description">
            Define the risks, doubts, customer requests, policies, and
            exceptions that need a person.
          </span>
        </summary>
        <section
          data-band
          id="route-conditions"
          class="route-conditions"
          aria-labelledby="route-conditions-title"
        >
          <div class="page-container section-stack">
            <div class="section-intro section-intro-inverse">
              <p class="eyebrow eyebrow-inverse">Route conditions</p>
              <h2 id="route-conditions-title">
                Define when a person must take control.
              </h2>
              <p>
                The rules depend on what the AI does. These six are a practical
                place to start.
              </p>
            </div>

            <ol class="condition-grid">
              {routingConditions.map((condition) => (
                <li>
                  <h3>{condition.title}</h3>
                  <p>{condition.description}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>
      </details>

      <details class="solution-depth" name="routing-details">
        <summary class="disclosure-summary">
          <span class="solution-depth-title">How the route works</span>
          <span class="solution-depth-description">
            Go from a safe stop, through urgency and handover, to a person
            acting and closing the case.
          </span>
        </summary>
        <section
          id="routing-path"
          class="routing-path section-block"
          aria-labelledby="routing-path-title"
        >
          <div class="page-container section-stack">
            <div class="section-intro section-intro-split">
              <div>
                <p class="eyebrow">Routing path</p>
                <h2 id="routing-path-title">
                  Go from a clear stopping point to a case someone closes.
                </h2>
              </div>
              <p>
                At each stage, check that the information stays with the case,
                the wrong action stops, and the decision goes to someone who can
                act.
              </p>
            </div>

            <ol class="seq-list path-list">
              {routingPath.map((stage, index) => (
                <li>
                  <div class="seq-head path-heading">
                    <p class="seq-number path-number">
                      {String(index + 1).padStart(2, "0")}
                    </p>
                    <p class="seq-label path-phase">{stage.phase}</p>
                  </div>
                  <h3>{stage.question}</h3>
                  <p>{stage.evidence}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>
      </details>

      <details class="solution-depth" name="routing-details">
        <summary class="disclosure-summary">
          <span class="solution-depth-title">What context must travel</span>
          <span class="solution-depth-description">
            Give the person what the customer wants, the history, what’s been
            tried, what’s unclear, the impact, and the decision needed.
          </span>
        </summary>
        <section
          id="context-transfer"
          class="context-transfer section-block"
          aria-labelledby="context-transfer-title"
        >
          <div class="page-container context-layout">
            <div class="context-intro">
              <p class="eyebrow">Context transfer</p>
              <h2 id="context-transfer-title">
                Give the person a case, not a transcript.
              </h2>
              <p>
                The person should know why the work arrived, what the customer
                needs, what already happened, what remains uncertain, and what
                decision is required.
              </p>
            </div>

            <dl class="context-list">
              {contextRequirements.map((item, index) => (
                <div>
                  <dt>
                    <span aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    {item.label}
                  </dt>
                  <dd>{item.description}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      </details>

      <details class="solution-depth" name="routing-details">
        <summary class="disclosure-summary">
          <span class="solution-depth-title">Where routing fails</span>
          <span class="solution-depth-description">
            Find handovers that pass along a chat log but lose urgency,
            authority, or responsibility.
          </span>
        </summary>
        <section
          data-band
          id="failure-patterns"
          class="failure-patterns"
          aria-labelledby="failure-patterns-title"
        >
          <div class="page-container failure-layout">
            <div class="failure-intro">
              <p class="eyebrow eyebrow-inverse">Common failure patterns</p>
              <h2 id="failure-patterns-title">
                Having a person involved doesn’t mean they’re in control.
              </h2>
              <p>
                These patterns show where a handover feature fails to make the
                response safe and owned.
              </p>
            </div>

            <div class="failure-list">
              {failurePatterns.map((failure, index) => (
                <article>
                  <h3>{failure.cue}</h3>
                  <p>{failure.description}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      </details>
    </div>

    <section
      id="evidence-outputs"
      class="evidence-outputs section-block"
      aria-labelledby="evidence-title"
    >
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Evidence and outputs</p>
            <h2 id="evidence-title">Inspect the whole decision path.</h2>
          </div>
          <p>
            Compare the rules you meant to follow with real conversations, what
            the system did, how people responded, corrections, and results. Keep
            what you saw separate from guesses about what the AI or people did.
          </p>
        </div>

        <div class="evidence-grid">
          {evidenceSources.map((source, index) => (
            <article>
              <h3>{source.title}</h3>
              <p>{source.description}</p>
            </article>
          ))}
        </div>

        <div class="output-block">
          <div class="output-intro">
            <p class="note-label">Practical outputs</p>
            <h2>Build a route people and systems can operate.</h2>
          </div>

          <ol class="output-list">
            {routingOutputs.map((output) => (
              <li>
                <div>
                  <h3>{output.title}</h3>
                  <p>{output.description}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section id="fit" class="fit" aria-labelledby="fit-title">
      <div class="page-container fit-layout">
        <div class="fit-copy">
          <p class="eyebrow">Fit</p>
          <h2 id="fit-title">
            Use routing design when AI can affect the customer outcome.
          </h2>
          <p>
            This fits when AI can answer, suggest, sort, or act while people
            stay accountable for the result. It isn’t setting up a chatbot, a
            staffing forecast, or a replacement for a wider decision on AI
            readiness.
          </p>

          <a class="button button-primary" href="/fit-check/">
            Start a FitCheck™
          </a>
        </div>

        <aside class="fit-list" aria-labelledby="fit-list-title">
          <p id="fit-list-title" class="note-label">
            Strong fit
          </p>
          <ul>
            {strongFit.map((condition) => (
              <li>{condition}</li>
            ))}
          </ul>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .routing-page {
    width: 100%;
    overflow: clip;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .page-container {
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
  }

  .section-block {
    padding-block: var(--section-space);
  }

  .routing-hero {
    padding-block: var(--section-space);
    border-bottom: var(--border-width) solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(19rem, 0.65fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .hero-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumb li {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .breadcrumb li + li::before {
    margin-inline-end: 0.5rem;
    color: var(--color-border-strong);
    content: "/";
  }

  .breadcrumb a {
    color: var(--color-blue);
    text-underline-offset: 0.25em;
  }

  .eyebrow,
  .note-label {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    letter-spacing: 0;
    font-feature-settings: var(--fea-eyebrow);
  }

  .path-phase {
    margin: 0;
  }

  .item-number,
  .path-number {
    margin: 0;
  }

  .eyebrow-inverse {
    color: var(--color-text-muted);
  }

  h1,
  h2,
  h3,
  p,
  li,
  a,
  dt,
  dd {
    font-family: var(--font-sans);
    font-feature-settings: var(--fea-graphik);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  h1 {
    max-width: 17ch;
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  .hero-lead {
    max-width: 64ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .button {
    display: inline-flex;
    min-height: var(--control-min-size);
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.75rem 1rem;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    text-decoration: none;
  }

  .button-primary {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-light);
  }

  .button-text {
    color: var(--color-blue);
  }

  .trigger-card {
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: var(--border-width) solid var(--color-border);
    border-top: 2px solid var(--color-text);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card-ambient);
    background: var(--color-surface-pure);
  }

  .trigger-card > p:not(.note-label) {
    margin: 1rem 0 0;
    color: var(--color-ink);
    font-size: var(--fs-body-ui);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .trigger-card dl {
    display: grid;
    margin: 1.5rem 0 0;
  }

  .trigger-card dl > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.9rem;
    border-top: var(--border-width) solid var(--color-border);
  }

  .trigger-card dt,
  .trigger-card dd {
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .trigger-card dt {
    color: var(--color-text-muted);
  }

  .trigger-card dd {
    margin: 0;
    color: var(--color-ink);
    font-weight: var(--fw-medium);
  }

  .purpose-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .purpose-layout h2,
  .section-intro h2,
  .context-intro h2,
  .failure-intro h2,
  .output-intro h2,
  .fit-copy h2 {
    max-width: 20ch;
    margin-top: 0.75rem;
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  .purpose-copy {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .purpose-copy p,
  .section-intro > p:not(.eyebrow),
  .context-intro > p:not(.eyebrow),
  .failure-intro > p:not(.eyebrow),
  .fit-copy > p:not(.eyebrow) {
    max-width: var(--measure-ui);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .section-stack {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  .section-intro {
    display: flex;
    max-width: 52rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .section-intro h2,
  .failure-intro h2 {
    margin-top: -0.5rem;
  }

  .section-intro-inverse h2,
  .failure-intro h2 {
    color: var(--color-light);
  }

  .section-intro-inverse > p:not(.eyebrow),
