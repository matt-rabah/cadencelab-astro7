---
import BreadcrumbSchema from "../../../components/BreadcrumbSchema.astro";
import Footer from "../../../components/Footer.astro";
import NavHeader from "../../../components/NavHeader.astro";
import SectionNav from "../../../components/SectionNav.astro";
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/solution-depth.css";

const linkRequirements = [
  {
    number: "01",
    title: "A recognizable trigger",
    description:
      "The next team can tell what happened, why the work moved, and what needs attention now.",
  },
  {
    number: "02",
    title: "Enough information",
    description:
      "Customer history, prior action, urgency, constraints, and the open question travel with the work.",
  },
  {
    number: "03",
    title: "An accountable owner",
    description:
      "A named role accepts responsibility for the next decision instead of simply seeing the work.",
  },
  {
    number: "04",
    title: "Authority to act",
    description:
      "The owner can decide, get approval, or escalate without rebuilding the case.",
  },
  {
    number: "05",
    title: "A clear deadline",
    description:
      "The handoff says when action is needed, and how urgency rises as the impact grows.",
  },
  {
    number: "06",
    title: "A report back",
    description:
      "The first team can see what happened, whether the need was resolved, and what should change.",
  },
];

const handoffPath = [
  {
    phase: "Origin",
    question: "What event created the need for another team?",
    evidence:
      "What the customer said or did, what was happening, what was already tried, and how urgent it was.",
  },
  {
    phase: "Transfer",
    question: "What information and responsibility moved with the work?",
    evidence:
      "The information needed, a named owner, a deadline, and the reason it moved.",
  },
  {
    phase: "Acceptance",
    question: "Who acknowledged responsibility for the next decision?",
    evidence:
      "Who received it, how long it waited, their workload, their authority, and how they responded.",
  },
  {
    phase: "Action",
    question: "What decision or customer response followed?",
    evidence:
      "Work completed, exception handled, approvals, and system updates.",
  },
  {
    phase: "Closure",
    question: "Did the result get back to everyone who needed it?",
    evidence:
      "The resolution, what was learned, the effect on later steps, and who follows up.",
  },
];

const failurePatterns = [
  {
    cue: "Visible everywhere, owned nowhere",
    description:
      "Several teams see the issue, but shared responsibility prevents anyone from making the next decision.",
  },
  {
    cue: "The activity moved without the story",
    description:
      "A task or record reaches the next team, but the customer’s history, earlier decisions, and urgency stay behind.",
  },
  {
    cue: "The receiving team must reopen the diagnosis",
    description:
      "Missing information forces the next team to start over, ask the customer again, or rebuild the case.",
  },
  {
    cue: "Escalation begins after the response window",
    description:
      "The right owner is found only after the delay has increased the customer or business impact.",
  },
  {
    cue: "The handoff completes but the outcome disappears",
    description:
      "The first team can’t see what happened, so reports count transfers instead of solved problems.",
  },
  {
    cue: "Exceptions depend on personal networks",
    description:
      "Experienced staff know who to call, but the official process has no reliable path for unusual cases.",
  },
];

const evidenceSources = [
  "Customer timelines, case histories, and escalation records",
  "Queues, assignments, changes of owner, and when work was transferred",
  "Messages, meetings, spreadsheets, and other ways teams coordinate outside official systems",
  "Policies, service rules, who approves what, and who can decide",
  "Frontline accounts of routine work, exceptions, and recovery",
  "Measures of customer results, how work flows, workload, and quality",
];

const linkOutputs = [
  {
    title: "Map of handoffs between teams",
    description:
      "One shared view of the teams, systems, decisions, information, and dependencies around the work.",
  },
  {
    title: "Information each team needs",
    description:
      "The minimum information each receiving role needs to understand the case and decide what comes next.",
  },
  {
    title: "Ownership and authority model",
    description:
      "Clear responsibility for accepting, deciding, escalating, solving, and reviewing each handoff.",
  },
  {
    title: "The order to fix handoffs",
    description:
      "The order to change the process, systems, data, roles, service rules, and measures, most important first.",
  },
];

const strongFit = [
  "The customer problem crosses teams, systems, or stages of the customer relationship.",
  "Customers repeat information or receive conflicting explanations.",
  "Important work stalls between teams, departments, or layers of approval.",
  "Teams rely on messages and meetings because the official process has gaps.",
  "Leadership can assign owners and change who decides and how work flows.",
];
---

<Layout
  title="Cross-functional Links | Cadence Lab"
  description="Find and repair the handoffs where customer context, ownership, or urgency gets lost between teams and systems."
  canonicalURL="/workflows/cross-functional/"
  pageType="website"
>
  <NavHeader />
  <BreadcrumbSchema currentName="Cross-functional links" />

  <main id="main-content" class="links-page" tabindex="-1">
    <section class="links-hero" aria-labelledby="links-title">
      <div class="page-container hero-layout">
        <div class="hero-copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
              <li>
                <a href="/">Home</a>
              </li>
              <li aria-current="page">Cross-functional links</li>
            </ol>
          </nav>

          <p class="eyebrow">Workflow · Cross-functional links</p>
          <h1 id="links-title">
            A handoff isn’t done just because the ticket moved.
          </h1>
          <p class="hero-lead">
            A handoff is when work passes from one team to another. A good one
            carries the customer’s story, the urgency, a clear owner, and the
            authority to act. Mapping each handoff shows where your systems move
            the work but your teams drop it.
          </p>

          <div class="hero-actions" aria-label="Cross-functional link actions">
            <a
              class="button button-primary"
              href="/services/cx-systems-diagnostic/"
            >
              Review the CX Systems Diagnostic
            </a>
            <a class="button button-text" href="/fit-check/">
              Start a FitCheck™
              <span aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </div>

        <aside class="trigger-card" aria-labelledby="trigger-title">
          <p id="trigger-title" class="note-label">
            Recognizable trigger
          </p>
          <p>
            Customers repeat their story, teams get half the information, and
            important work is visible to everyone but owned by no one.
          </p>
          <dl>
            <div>
              <dt>Visible symptom</dt>
              <dd>Delays, customers repeating themselves, mixed answers</dd>
            </div>
            <div>
              <dt>Trace</dt>
              <dd>
                What started it, what was known, who owned it, what they could
                do
              </dd>
            </div>
            <div>
              <dt>Decision</dt>
              <dd>Which handoff to fix first</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <SectionNav
      items={[
        { label: "The operating link", href: "#operating-link" },
        { label: "Explore", href: "#details" },
        { label: "Evidence and outputs", href: "#evidence-outputs" },
        { label: "Fit", href: "#fit" },
      ]}
    />

    <section
      id="operating-link"
      class="operating-link section-block"
      aria-labelledby="operating-link-title"
    >
      <div class="page-container operating-layout">
        <div>
          <p class="eyebrow">The operating link</p>
          <h2 id="operating-link-title">
            The work moves only when accountability moves with it.
          </h2>
        </div>

        <div class="operating-copy">
          <p>
            Changing the owner, sending a message, or holding a meeting doesn’t
            finish a handoff. The person receiving it must understand the case,
            take responsibility, have the authority to act, and report back the
            result.
          </p>
          <p>
            Handoff mapping follows that transfer across teams, queues, systems,
            policies, and decisions. It tells a simple communication gap apart
            from a deeper problem with ownership, authority, workload, process,
            or evidence.
          </p>
        </div>
      </div>
    </section>

    <div id="details" class="solution-depth-group">
      <details class="solution-depth" name="handoff-details" open>
        <summary class="disclosure-summary">
          <span class="solution-depth-title">What must travel</span>
          <span class="solution-depth-description">
            See the information, ownership, authority, action, and report-back a
            handoff needs.
          </span>
        </summary>
        <section
          data-band
          id="link-requirements"
          class="link-requirements"
          aria-labelledby="link-requirements-title"
        >
          <div class="page-container section-stack">
            <div class="section-intro section-intro-inverse">
              <p class="eyebrow eyebrow-inverse">Link requirements</p>
              <h2 id="link-requirements-title">
                Six things must travel with the work.
              </h2>
              <p>
                A strong handoff keeps the information needed to decide and
                makes the next owner clear.
              </p>
            </div>

            <ol class="requirement-grid">
              {linkRequirements.map((requirement) => (
                <li>
                  <h3>{requirement.title}</h3>
                  <p>{requirement.description}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>
      </details>

      <details class="solution-depth" name="handoff-details">
        <summary class="disclosure-summary">
          <span class="solution-depth-title">How to trace the handoff</span>
          <span class="solution-depth-description">
            Follow responsibility from what started it, through acceptance and
            action, to closing it.
          </span>
        </summary>
        <section
          id="handoff-path"
          class="handoff-path section-block"
          aria-labelledby="handoff-path-title"
        >
          <div class="page-container section-stack">
            <div class="section-intro">
              <p class="eyebrow">Handoff path</p>
              <h2 id="handoff-path-title">
                Follow the handoff from start to finish.
              </h2>
              <p>
                At each stage, check whether the customer problem and
                responsibility remain intact.
              </p>
            </div>

            <ol class="seq-list path-list">
              {handoffPath.map((item, index) => (
                <li>
                  <div class="seq-head path-heading">
                    <p class="seq-number path-number">
                      {String(index + 1).padStart(2, "0")}
                    </p>
                    <p class="seq-label path-phase">{item.phase}</p>
                  </div>
                  <h3>{item.question}</h3>
                  <p>{item.evidence}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>
      </details>

      <details class="solution-depth" name="handoff-details">
        <summary class="disclosure-summary">
          <span class="solution-depth-title">Where handoffs fail</span>
          <span class="solution-depth-description">
            Find where information, ownership, authority, capacity, or
            follow-through keeps getting lost.
          </span>
        </summary>
        <section
          data-band
          id="failure-patterns"
          class="failure-patterns"
          aria-labelledby="failure-patterns-title"
        >
          <div class="page-container failure-layout">
            <div class="failure-intro">
              <p class="eyebrow eyebrow-inverse">Failure patterns</p>
              <h2 id="failure-patterns-title">
                Context gets lost when nobody owns the link.
              </h2>
              <p>
                These patterns separate a one-time miss from a failure that
                keeps happening.
              </p>
            </div>

            <div class="failure-list">
              {failurePatterns.map((failure, index) => (
                <article>
                  <h3>{failure.cue}</h3>
                  <p>{failure.description}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      </details>
    </div>

    <section
      id="evidence-outputs"
      class="evidence-outputs section-block"
      aria-labelledby="evidence-outputs-title"
    >
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Evidence and outputs</p>
            <h2 id="evidence-outputs-title">
              Compare the formal handoff with the real one.
            </h2>
          </div>
          <p>
            Put the records and service rules next to timestamps, conversations,
            what frontline staff really do, exceptions, and results for
            customers.
          </p>
        </div>

        <div class="evidence-panel">
          <div>
            <p class="note-label">Evidence sources</p>
            <h3>Follow the work wherever people actually do it.</h3>
          </div>
          <ul>
            {evidenceSources.map((source) => (
              <li>{source}</li>
            ))}
          </ul>
        </div>

        <div class="output-grid">
          {linkOutputs.map((output, index) => (
            <article>
              <h3>{output.title}</h3>
              <p>{output.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="fit" class="fit" aria-labelledby="fit-title">
      <div class="page-container fit-layout">
        <div class="fit-copy">
          <p class="eyebrow">Fit</p>
          <h2 id="fit-title">
            Use handoff mapping when the problem lives between teams.
          </h2>
          <p>
            This fits when teams agree on the problem but each blames a
            different part of the business. It needs access to the people and
            evidence around the work, plus a senior sponsor who can settle who
            owns what and who decides.
          </p>
          <a class="button button-primary" href="/fit-check/">
            Start a FitCheck™
          </a>
        </div>

        <aside class="fit-list" aria-labelledby="fit-list-title">
          <p id="fit-list-title" class="note-label">
            Strong fit
          </p>
          <ul>
            {strongFit.map((condition) => (
              <li>{condition}</li>
            ))}
          </ul>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .links-page {
    width: 100%;
    overflow: clip;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .page-container {
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
  }

  .section-block {
    padding-block: var(--section-space);
  }

  .links-hero {
    padding-block: var(--section-space);
    border-bottom: var(--border-width) solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(19rem, 0.65fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .hero-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumb li {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .breadcrumb li + li::before {
    margin-inline-end: 0.5rem;
    color: var(--color-border-strong);
    content: "/";
  }

  .breadcrumb a {
    color: var(--color-blue);
    text-underline-offset: 0.25em;
  }

  .eyebrow,
  .note-label {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    letter-spacing: 0;
    font-feature-settings: var(--fea-eyebrow);
  }

  .path-phase {
    margin: 0;
  }

  .item-number,
  .path-number {
    margin: 0;
  }

  .eyebrow-inverse {
    color: var(--color-text-muted);
  }

  h1,
  h2,
  h3,
  p,
  li,
  a,
  dt,
  dd {
    font-family: var(--font-sans);
    font-feature-settings: var(--fea-graphik);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  h1 {
    max-width: 16ch;
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  .hero-lead {
    max-width: 64ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .button {
    display: inline-flex;
    min-height: var(--control-min-size);
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.75rem 1rem;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    text-decoration: none;
  }

  .button-primary {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-light);
  }

  .button-text {
    color: var(--color-blue);
  }

  .trigger-card {
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: var(--border-width) solid var(--color-border);
    border-top: 2px solid var(--color-text);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card-ambient);
    background: var(--color-surface-pure);
  }

  .trigger-card > p:not(.note-label) {
    margin: 1rem 0 0;
    color: var(--color-ink);
    font-size: var(--fs-body-ui);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .trigger-card dl {
    display: grid;
    margin: 1.5rem 0 0;
  }

  .trigger-card dl > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.9rem;
    border-top: var(--border-width) solid var(--color-border);
  }

  .trigger-card dt,
  .trigger-card dd {
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .trigger-card dt {
    color: var(--color-text-muted);
  }

  .trigger-card dd {
    margin: 0;
    color: var(--color-ink);
    font-weight: var(--fw-medium);
  }

  .operating-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .operating-layout h2,
  .section-intro h2,
  .failure-intro h2,
  .fit-copy h2 {
    max-width: 19ch;
    margin-top: 0.75rem;
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  .operating-copy {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .operating-copy p,
  .section-intro > p:not(.eyebrow),
  .failure-intro > p:not(.eyebrow),
  .fit-copy > p:not(.eyebrow) {
    max-width: var(--measure-ui);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .section-stack {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  .section-intro {
    display: flex;
    max-width: 52rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .section-intro h2,
  .failure-intro h2 {
    margin-top: -0.5rem;
  }

  .section-intro-inverse h2,
  .failure-intro h2 {
    color: var(--color-light);
  }

  .section-intro-inverse > p:not(.eyebrow),
  .failure-intro > p:not(.eyebrow) {
    color: var(--color-text-inverse-muted);
  }

  .section-intro-split {
    display: grid;
    max-width: none;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .section-intro-split > p {
    align-self: end;
  }

  .link-requirements,
  .failure-patterns {
    padding-block: var(--section-space);
    background: var(--color-ink);
    color: var(--color-light);
  }

  .requirement-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: var(--border-width) solid var(--color-border-inverse);
    border-inline-start: var(--border-width) solid var(--color-border-inverse);
    list-style: none;
  }

  .requirement-grid li {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2rem);
    border-inline-end: var(--border-width) solid var(--color-border-inverse);
    border-bottom: var(--border-width) solid var(--color-border-inverse);
  }

  .requirement-grid h3,
  .failure-list h3 {
    margin-top: 1.75rem;
    color: var(--color-light);
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: 1.35;
  }

  .requirement-grid li > p:last-child,
  .failure-list article > p:last-child {
    margin: 0.75rem 0 0;
    color: var(--color-text-inverse-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .failure-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .failure-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .failure-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: var(--border-width) solid var(--color-border-inverse);
    border-inline-start: var(--border-width) solid var(--color-border-inverse);
  }

  .failure-list article {
    padding: clamp(1.5rem, 4vw, 2rem);
    border-inline-end: var(--border-width) solid var(--color-border-inverse);
    border-bottom: var(--border-width) solid var(--color-border-inverse);
  }

  .evidence-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding: clamp(1.75rem, 5vw, 3rem);
    border-top: 2px solid var(--color-text);
    background: var(--color-surface-subtle);
  }

  .evidence-panel h3 {
    max-width: 24ch;
    margin-top: 0.75rem;
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    line-height: var(--lh-h3);
  }

  .evidence-panel ul {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    margin: 0;
    padding-inline-start: 1.3rem;
  }

  .evidence-panel li {
    color: var(--color-text);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .evidence-panel li::marker {
    color: var(--color-text-subtle);
  }

  .output-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: var(--border-width) solid var(--color-border);
    border-inline-start: var(--border-width) solid var(--color-border);
  }

  .output-grid article {
    min-width: 0;
