---
import Footer from "../../components/Footer.astro";
import NavHeader from "../../components/NavHeader.astro";
import SectionNav from "../../components/SectionNav.astro";
import Layout from "../../layouts/Layout.astro";
import { FOUNDER } from "../../lib/founder";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Photos live in src/assets/about/. Each block renders only when its file
// exists, so the page works before the photos are added.
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/about/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const photo = (name: string): ImageMetadata | undefined =>
  Object.entries(photoFiles).find(([path]) =>
    path.split("/").pop()?.startsWith(`${name}.`),
  )?.[1].default;

const headshot = photo("matt-rabah-headshot");

const results = [
  {
    figure: "14%",
    text: "Average lift in early adoption and repeat engagement across six Cadence Lab client lifecycle redesigns.",
  },
  {
    figure: "18%",
    text: "Faster time-to-value after rebuilding sales-to-service handoffs in Salesforce for Cadence Lab clients.",
  },
  {
    figure: "4 hrs",
    text: "Back every week for each team member at a multi-location client, from HubSpot lifecycle automation.",
  },
  {
    figure: "32% → 86%",
    text: "CRM-driven outreach across 1,100 accounts at Shinola, without putting high-touch coverage on every account.",
  },
  {
    figure: "35%",
    text: "Fewer escalations at Shinola after tracing broken customer handoffs and rewriting the service workflows behind them.",
  },
  {
    figure: "95%",
    text: "Multi-year client retention at NeuroSync, built on CRM stage gates, mutual action plans, and clean sales-to-implementation handoffs.",
  },
];

const talks = [
  {
    event: "1 Million Cups Detroit",
    topic: "CX decisions and designing systems for AI adoption",
    date: "September 2026",
    photo: photo("1-million-cups-detroit"),
    alt: "Matt Rabah presenting at 1 Million Cups Detroit",
  },
  {
    event: "Creative Mornings Detroit",
    topic: "Systems Thinking in Customer Experience",
    date: "May 2024",
    photo: photo("creative-mornings-detroit"),
    alt: "Matt Rabah speaking at Creative Mornings Detroit",
  },
  {
    event: "MSU CXM360 Conference",
    topic: "Loyalty Programs in Luxury Retail",
    date: "October 2023",
    photo: undefined,
    alt: "",
  },
  {
    event: "University of Michigan",
    topic: "Customer Experience Operations",
    date: "July 2022",
    photo: undefined,
    alt: "",
  },
];

const pointsOfView = [
  {
    number: "01",
    title: "Customer experience reflects how the work gets done",
    description:
      "Customers feel every handoff, every data gap, and every tool your team doesn’t trust. Fix one touchpoint without looking at the work around it and the problem just moves.",
  },
  {
    number: "02",
    title: "A good diagnosis protects your next investment",
    description:
      "Before you buy a platform, launch a program, or scale AI, a focused diagnostic shows what’s known, what’s still fuzzy, and which decision matters first.",
  },
  {
    number: "03",
    title: "AI readiness starts with the workflow",
    description:
      "Useful AI needs a clear purpose, inputs you trust, real owners, a workflow people can follow, human review, and a way to catch it when it’s wrong.",
  },
];

const workingPrinciples = [
  {
    number: "01",
    title: "Follow the evidence",
    description:
      "Separate what you can observe from what people assume. Be clear about what the evidence supports and where uncertainty remains.",
  },
  {
    number: "02",
    title: "Name the owner",
    description:
      "Make it clear who decides, who does the work, who handles exceptions, and who owns the customer outcome.",
  },
  {
    number: "03",
    title: "Design for the work people actually do",
    description:
      "Work with the real limits of teams, systems, incentives, data, and frontline behavior. A process diagram won’t change the work. Neither will a launch.",
  },
  {
    number: "04",
    title: "Measure what changed",
    description:
      "Name the business value before you start. Pick the measures that should move. Then check the results and adjust.",
  },
];

const cadenceLabBrings = [
  "One clear diagnostic question, not a broad consulting exercise.",
  "A view across customer friction, teams, workflows, systems, and ownership.",
  "A clear separation between facts, assumptions, limits, and decisions.",
  "A practical recommendation that shows what to do first and what can wait.",
];

const engagementRequires = [
  "A customer or business problem worth solving.",
  "Access to the people, data, and examples around the work.",
  "A sponsor who can help teams make decisions together.",
  "A willingness to change ownership or workflows when the evidence points there.",
];
---

<Layout
  title="About Matt Rabah and Cadence Lab | Customer Experience"
  description="Meet Matt Rabah, founder of Cadence Lab. Learn how he helps organizations fix customer experience problems across teams, CRM workflows, lifecycle risk, and AI."
  canonicalURL="/about/"
  pageType="website"
>
  <NavHeader />

  <main id="main-content" class="about-page" tabindex="-1">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="page-container hero-layout">
        <div class="hero-copy">
          <p class="eyebrow">About Cadence Lab</p>

          <h1 id="about-title">
            Work directly with the person doing the work.
          </h1>

          <p class="hero-lead">
            I’m Matt Rabah, and Cadence Lab is me. I help companies figure out
            why customer problems keep coming back, then fix the work behind
            them. You’ll work with me directly, from the first question through
            the plan, the workflow design, and how we’ll measure what changed.
          </p>

          <div class="hero-actions" aria-label="About page actions">
            <a class="button button-primary" href="/services/">
              See how I can help
            </a>

            <a class="button button-text" href="/fit-check/">
              Start a FitCheck™
              <span aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <SectionNav
      items={[
        { label: "Official bio", href: "#founder" },
        { label: "Results", href: "#results" },
        { label: "Speaking", href: "#speaking" },
        { label: "Point of view", href: "#point-of-view" },
        { label: "How I work", href: "#working-standard" },
        { label: "Fit", href: "#engagement-fit" },
      ]}
    />

    <section
      id="founder"
      class="founder-profile"
      aria-labelledby="official-bio-title"
    >
      <div
        class:list={[
          "page-container",
          "founder-layout",
          { "has-photo": headshot },
        ]}
      >
        {
          headshot && (
            <figure class="headshot">
              <Image
                src={headshot}
                alt="Matt Rabah, founder of Cadence Lab"
                widths={[480, 720, 960]}
                sizes="(min-width: 64rem) 28rem, 100vw"
                loading="eager"
              />
              <figcaption>
                <strong>Matt Rabah</strong>
                Founder, Cadence Lab. Detroit, Michigan.
              </figcaption>
            </figure>
          )
        }
        <div class="official-bio" aria-labelledby="official-bio-title">
          <p class="eyebrow">Official bio</p>
          <h2 id="official-bio-title">
            Twelve years across customer experience and customer success.
          </h2>

          <div class="bio-copy">
            <p>
              Matt Rabah is a customer experience strategist and the founder of
              Cadence Lab, a Detroit practice that helps companies fix the
              systems behind customer friction. He holds an M.S. in Customer
              Experience Management from Michigan State University’s Eli Broad
              College of Business and is a Salesforce Certified Agentforce
              Specialist.
            </p>

            <p>
              Before Cadence Lab, he led customer experience at{" "}
              <a href="https://www.shinola.com/" rel="noopener">Shinola</a>, the
              Detroit luxury brand, for its flagship location and an $8M
              corporate portfolio. Before that, he was Vice President of Sales
              at{" "}
              <a href="https://www.neurosync.health/" rel="noopener"
                >NeuroSync</a
              >, an AI-enabled health technology company, where he owned
              post-implementation customer success across clinical and legal
              accounts.
            </p>

            <p>
              His work spans service operations, customer lifecycle programs,
              CRM workflows, and practical AI adoption. Different labels, same
              job: understand the customer’s problem, decide what’s worth
              building, ship it, and prove it worked.
            </p>

            <p>
              He’s worked hands-on with Salesforce, HubSpot, Gainsight,
              ChurnZero, Zendesk, Delighted, and Oracle.
            </p>

            <p>
              His AI work includes ChatGPT, Gemini, Claude, local models,
              Salesforce Agentforce, and task-specific agents. He helps teams
              pick the use cases worth building, decide where people stay in the
              loop, and get the workflows and data ready before launch.
            </p>

            <p>
              <a href={FOUNDER.linkedIn} rel="me noopener">
                Connect with Matt on LinkedIn{" "}
                <span aria-hidden="true">↗</span>
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="results" class="about-results" aria-labelledby="results-title">
      <div class="page-container results-stack">
        <div class="results-intro">
          <p class="eyebrow">Results</p>
          <h2 id="results-title">Numbers I can stand behind.</h2>
          <p>
            Every number here comes from real work. No projections, no borrowed
            case studies. Same pattern every time: find the problem, ship the
            change, measure what moved.
          </p>
        </div>

        <ul class="results-grid" role="list">
          {
            results.map((result) => (
              <li>
                <p class="result-figure">{result.figure}</p>
                <p class="result-text">{result.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section
      id="speaking"
      class="about-speaking"
      aria-labelledby="speaking-title"
    >
      <div class="page-container speaking-stack">
        <div class="results-intro">
          <p class="eyebrow">Speaking</p>
          <h2 id="speaking-title">Where I’ve talked about this work.</h2>
        </div>

        <ul class="talk-list" role="list">
          {
            talks.map((talk) => (
              <li class:list={{ "has-photo": talk.photo }}>
                {talk.photo && (
                  <Image
                    src={talk.photo}
                    alt={talk.alt}
                    widths={[640, 960, 1280]}
                    sizes="(min-width: 64rem) 40rem, 100vw"
                  />
                )}
                <div class="talk-copy">
                  <p class="talk-date">{talk.date}</p>
                  <h3>{talk.event}</h3>
                  <p>{talk.topic}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section
      id="point-of-view"
      class="point-of-view"
      aria-labelledby="point-of-view-title"
    >
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Point of view</p>
            <h2 id="point-of-view-title">
              The problem you see isn’t always where the problem starts.
            </h2>
          </div>

          <p>
            A problem may show up in service, retention, CRM reporting, or an AI
            project. Its cause may sit in another team, system, rule, or
            decision. I follow those connections without losing sight of what
            the customer experiences.
          </p>
        </div>

        <ol class="view-list">
          {
            pointsOfView.map((item) => (
              <li>
                <article>
                  <p class="item-number" aria-hidden="true">
                    {item.number}
                  </p>
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      data-band
      id="working-standard"
      class="working-standard"
      aria-labelledby="working-standard-title"
    >
      <div class="page-container standard-layout">
        <div class="standard-intro">
          <p class="eyebrow eyebrow-inverse">How I work</p>
          <h2 id="working-standard-title">
            The recommendation has to work in real life.
          </h2>
          <p>
            The goal is a decision people can understand, own, carry out, and
            improve as new evidence appears.
          </p>
        </div>

        <ol class="principle-grid">
          {
            workingPrinciples.map((principle) => (
              <li>
                <article>
                  <p class="principle-number" aria-hidden="true">
                    {principle.number}
                  </p>
                  <h3>{principle.title}</h3>
                  <p>{principle.description}</p>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      id="engagement-fit"
      class="engagement-boundaries"
      aria-labelledby="boundaries-title"
    >
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Working together</p>
            <h2 id="boundaries-title">
              The best work starts with honesty on both sides.
            </h2>
          </div>

          <p>
            This works best when your team wants to understand the problem
            before picking a solution, and is ready to act on what we find.
          </p>
        </div>

        <div class="boundary-grid">
          <article class="boundary-panel boundary-panel-primary">
            <p class="boundary-label">Cadence Lab brings</p>
            <h3>A clear way to turn a messy problem into a decision</h3>
            <ul role="list">
              {cadenceLabBrings.map((item) => <li>{item}</li>)}
            </ul>
          </article>

          <article class="boundary-panel">
            <p class="boundary-label boundary-label-muted">
              The engagement requires
            </p>
            <h3>The access and authority to get to the truth</h3>
            <ul role="list">
              {engagementRequires.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="about-close" aria-labelledby="about-close-title">
      <div class="page-container close-layout">
        <div>
          <p class="eyebrow">Start with an honest FitCheck™</p>
          <h2 id="about-close-title">
            Sometimes the honest answer is that I’m not the right fit.
          </h2>
        </div>

        <div class="close-action">
          <p>
            Tell me what customers are going through, who’s involved, and what
            needs to change. I’ll read it and tell you straight whether I can
            help.
          </p>

          <a class="button button-primary" href="/fit-check/">
            Start a FitCheck™
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .about-page {
    width: 100%;
    overflow: clip;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .page-container {
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
  }

  .about-hero,
  .founder-profile,
  .point-of-view,
  .working-standard,
  .system-view,
  .engagement-boundaries,
  .about-close {
    padding-block: var(--section-space);
  }

  .about-hero {
    background: var(--color-surface-subtle);
  }

  .founder-profile {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-pure);
  }

  .founder-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .founder-card,
  .official-bio,
  .founder-summary,
  .bio-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .founder-card {
    gap: 1.75rem;
  }

  .founder-summary {
    gap: 0.75rem;
  }

  .founder-summary h2 {
    font-size: var(--fs-h3);
  }

  .founder-summary > p:last-child,
  .bio-copy p {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .founder-summary > p:last-child {
    font-size: var(--fs-small);
  }

  .official-bio {
    gap: 1rem;
  }

  .founder-layout.has-photo {
    grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.25fr);
  }

  .headshot {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .headshot img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .headshot figcaption {
    display: grid;
    gap: 0.25rem;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .headshot figcaption strong {
    color: var(--color-ink);
  }

  .about-results,
  .about-speaking {
    padding-block: var(--section-space);
    border-top: var(--border-width) solid var(--color-border);
  }

  .about-results {
    background: var(--color-surface-subtle);
  }

  .results-stack,
  .speaking-stack {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .results-intro {
    display: grid;
    max-width: 46rem;
    gap: 1rem;
  }

  .results-intro p:not(.eyebrow) {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .results-grid,
  .talk-list {
    display: grid;
    gap: clamp(1rem, 2vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .results-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .results-grid li,
  .talk-list li {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-pure);
    box-shadow: var(--shadow-card-ambient);
  }

  .result-figure {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.75rem);
    font-weight: var(--fw-semibold);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .result-text,
  .talk-copy p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .talk-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .talk-list li.has-photo {
    padding: 0;
    overflow: clip;
  }

  .talk-list li.has-photo .talk-copy {
    padding: 0 clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3vw, 1.75rem);
  }

  .talk-list img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .talk-copy {
    display: grid;
    gap: 0.5rem;
  }

  .talk-copy h3 {
    margin: 0;
    font-size: var(--fs-h4);
  }

  .talk-copy .talk-date {
    color: var(--color-blue);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 64rem) {
    .founder-layout.has-photo,
    .results-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 44rem) {
    .founder-layout.has-photo,
    .results-grid,
    .talk-list {
      grid-template-columns: 1fr;
    }
  }

  .official-bio h2 {
    max-width: 19ch;
  }

  .bio-copy {
    max-width: 66ch;
    gap: 1.25rem;
    margin-top: clamp(1rem, 3vw, 2rem);
  }

  .bio-copy p {
    font-size: var(--fs-body-ui);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .hero-copy,
  .standard-intro,
  .system-intro,
  .close-action {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-copy {
    gap: 1.25rem;
  }

  .eyebrow,
  .note-label,
  .item-number,
  .principle-number,
  .sequence-number,
  .boundary-label {
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    letter-spacing: var(--ls-eyebrow);
    font-feature-settings: var(--fea-eyebrow);
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    font-feature-settings: var(--fea-graphik);
  }

  h1,
  h2,
  h3 {
    color: var(--color-ink);
    font-family: var(--font-sans);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  h1 {
    max-width: 17ch;
    margin: 0;
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  h2 {
    margin: 0;
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
  }

  h3 {
    margin: 0;
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .hero-lead,
  .section-intro-split > p,
  .standard-intro > p:not(.eyebrow),
  .system-intro > p:not(.eyebrow),
  .view-list article p,
  .principle-grid article > p:last-child,
  .system-sequence article p,
  .close-action p {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .hero-lead {
    max-width: 62ch;
    font-size: var(--fs-body-ui);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding-top: 0.5rem;
  }

  .button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.2;
    text-decoration: none;
  }

  .button-primary {
    padding: 0.875rem 1.25rem;
    border: 1px solid var(--color-ink);
    background: var(--color-ink);
    color: var(--color-light);
  }

  /* Same as every other page: black, blue on hover. */
  .button-primary:hover {
    border-color: var(--color-blue);
    background: var(--color-blue);
  }

  .button-text {
    padding: 0.875rem 0;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .button-text:hover {
    color: var(--color-blue);
    text-decoration-color: currentColor;
  }

  .premise-note {
    display: grid;
    min-width: 0;
    gap: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 1px solid var(--color-border);
