---
import BreadcrumbSchema from "../../../components/BreadcrumbSchema.astro";
import RelatedPaths from "../../../components/RelatedPaths.astro";
import Footer from "../../../components/Footer.astro";
import NavHeader from "../../../components/NavHeader.astro";
import SectionNav from "../../../components/SectionNav.astro";
import Layout from "../../../layouts/Layout.astro";

const diagnosticQuestions = [
  {
    number: "01",
    question: "Where does risk show up first?",
    explanation:
      "Find the early signs in onboarding, adoption, service activity, account behavior, and feedback. Before the renewal’s in danger, not after.",
  },
  {
    number: "02",
    question: "Which signals matter enough to act on?",
    explanation:
      "Separate a real change in behavior from normal noise, missing data, and activity that looks busy but tells you nothing.",
  },
  {
    number: "03",
    question: "Who should respond, and when?",
    explanation:
      "Set who owns it, what triggers a response, where it escalates, and what context each team needs while there’s still time to act.",
  },
  {
    number: "04",
    question: "How will you know the response worked?",
    explanation:
      "Name the business value up front (retention, expansion, or cost to serve). Then tie every response back to it, so you can prove it helped.",
  },
];

const evidenceAreas = [
  {
    title: "Lifecycle stages and expectations",
    description:
      "How your team defines onboarding, adoption, customer value, renewal readiness, and other important stages in the relationship.",
  },
  {
    title: "Customer and account signals",
    description:
      "Product or service use, shifts in engagement, support patterns, feedback, and who’s left or joined on the customer side.",
  },
  {
    title: "Handoffs and intervention paths",
    description:
      "How customer context moves across sales, onboarding, success, service, operations, and leadership when teams need to act together.",
  },
  {
    title: "Health measures and data quality",
    description:
      "The inputs, assumptions, missing data, age, and real use of current health scores, dashboards, alerts, and account reviews.",
  },
  {
    title: "Ownership and escalation rules",
    description:
      "Who watches for risk, makes sense of unclear signals, contacts the customer, removes blockers, and makes cross-team decisions.",
  },
  {
    title: "Outcomes and review cadence",
    description:
      "How your team reviews its response, learns from preventable losses, and updates signals or rules as customer behavior changes.",
  },
];

const deliverables = [
  {
    number: "01",
    title: "Lifecycle risk model",
    description:
      "A shared definition of customer stages, risk conditions, and the points where earlier action can still change the outcome.",
    decision:
      "Where to watch for risk and which lifecycle stages need clearer attention.",
  },
  {
    number: "02",
    title: "Signal inventory and assessment",
    description:
      "A review of available signals, the strength of their evidence, known gaps, age, ownership, and value for a specific decision.",
    decision:
      "Which signals you can act on today, which need work, and which you shouldn’t trust yet.",
  },
  {
    number: "03",
    title: "Intervention and ownership map",
    description:
      "A practical view of triggers, owners, escalation paths, needed context, and the response expected when risk appears.",
    decision:
      "Who acts, when they act, what they need to know, and where teams must work together.",
  },
  {
    number: "04",
    title: "Prioritized improvement plan",
    description:
      "An ordered set of changes to lifecycle definitions, data, workflows, reviews, and measurement based on impact and dependencies.",
    decision:
      "What to improve first, and what has to be ready before you add automation or predictive tools.",
  },
];

const strongFit = [
  "Onboarding slips, adoption falls, accounts go quiet, or renewal risk appears too late for an effective response.",
  "Customer context and risk signals are spread across teams, systems, or account reviews.",
  "A sponsor can bring customer-facing, operations, data, and commercial owners together.",
  "You’re willing to change lifecycle definitions, workflows, and who owns what.",
];

const limitedFit = [
  "The goal is only to buy a predictive tool without changing how teams understand and respond to risk.",
  "You need an urgent recovery plan for one known account.",
  "The customer, account, workflow, or outcome evidence just isn’t available.",
  "Nobody accountable can change response rules, escalation paths, or how teams work together.",
];

const relatedPaths = [
  {
    title: "SLA Escalation Maps",
    href: "/workflows/escalation/",
    description:
      "Map the conditions, authority, and response needed before a service issue becomes a failure.",
  },
  {
    title: "Dirty CRM Data and Siloed Pipelines",
    href: "/solutions/dirty-data/",
    description:
      "Find the workflow that keeps recreating unreliable CRM data, pipeline stages, and reports.",
  },
  {
    title: "Solutions by Use Case",
    href: "/solutions/use-case/",
    description:
      "Find the right CX, CRM, lifecycle, digital, location, or AI path for the problem in front of you.",
  },
];
---

<Layout
  title="Lifecycle Risk Review | Cadence Lab"
  description="Find customer lifecycle risk earlier. Learn which signals matter, who should respond, and what to improve before renewal risk becomes urgent."
  canonicalURL="/services/lifecycle-risk-review/"
  pageType="website"
>
  <NavHeader />
  <BreadcrumbSchema
    items={[
      { name: "Services", href: "/services/" },
      { name: "Lifecycle Risk Review" },
    ]}
  />

  <main id="main-content" class="diagnostic-page" tabindex="-1">
    <section class="diagnostic-hero" aria-labelledby="diagnostic-title">
      <div class="page-container hero-layout">
        <div class="hero-copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
              <li><a href="/services/">Services</a></li>
              <li aria-current="page">Lifecycle Risk Review</li>
            </ol>
          </nav>

          <p class="eyebrow">Diagnostic 02</p>
          <h1 id="diagnostic-title">
            See customer risk before it’s too late to act.
          </h1>
          <p class="hero-lead">
            Most unhappy customers won’t tell you. They just go quiet, then
            leave. This review finds the early warning signs across onboarding,
            adoption, account health, feedback, and renewal, so you know which
            signals matter, who should act, and what has to change while there’s
            still time.
          </p>

          <div class="hero-actions" aria-label="Lifecycle Risk Review actions">
            <a class="button button-primary" href="/fit-check/">
              Start a fit check
            </a>
            <a class="button button-text" href="#outputs">
              See what you receive
            </a>
          </div>
        </div>

        <aside class="trigger" aria-labelledby="trigger-title">
          <p id="trigger-title" class="trigger-label">You may be seeing this</p>
          <p>
            Onboarding slips. Adoption dips. Your main contact stops replying.
            And nobody’s sure whose move it is.
          </p>
          <p>
            By the time the risk is obvious, the window’s nearly closed. The
            signals, the ownership, and the customer context are scattered
            across teams and systems.
          </p>
        </aside>
      </div>
    </section>

    <SectionNav
      items={[
        { label: "Outputs", href: "#outputs" },
        { label: "Explore", href: "#questions" },
        { label: "Fit", href: "#fit" },
        { label: "Next step", href: "#next-step" },
      ]}
    />

    <section
      id="questions"
      class="questions section-block"
      aria-labelledby="questions-title"
    >
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Questions answered</p>
            <h2 id="questions-title">
              Turn late surprises into earlier action.
            </h2>
          </div>
          <p>
            I start with the decisions your team needs to make. Then I test
            whether your signals and workflows let someone act in time, and own
            it.
          </p>
        </div>

        <details class="diagnostic-disclosure" name="diagnostic-details">
          <summary>
            <span>Questions this diagnostic answers</span>
            <span class="summary-action">View questions</span>
          </summary>
          <ol class="question-list" role="list">
            {
              diagnosticQuestions.map((item) => (
                <li>
                  <article class="question">
                    <p class="item-number" aria-hidden="true">
                      {item.number}
                    </p>
                    <div>
                      <h3>{item.question}</h3>
                      <p>{item.explanation}</p>
                    </div>
                  </article>
                </li>
              ))
            }
          </ol>
        </details>
      </div>
    </section>

    <section
      id="scope"
      class="scope section-block"
      aria-labelledby="scope-title"
    >
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Scope and evidence</p>
            <h2 id="scope-title">See how risk is tracked and handled today.</h2>
          </div>
          <p>
            What I look at depends on how your customer lifecycle works and what
            you can share. Then I compare the process on paper with what
            actually happens when a signal shows up.
          </p>
        </div>

        <details class="diagnostic-disclosure" name="diagnostic-details">
          <summary>
            <span>Evidence we review</span>
            <span class="summary-action">View evidence</span>
          </summary>
          <ul class="evidence-grid" role="list">
            {
              evidenceAreas.map((area, index) => (
                <li>
                  <article>
                    <p class="item-number" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </p>
                    <h3>{area.title}</h3>
                    <p>{area.description}</p>
                  </article>
                </li>
              ))
            }
          </ul>

          <aside class="scope-note" aria-labelledby="scope-note-title">
            <h3 id="scope-note-title">Signals before scores</h3>
            <p>
              A health score is only useful if you know what’s in it and it
              changes a real decision. You’ll see what’s evidence, what’s
              assumption, and where missing data should make you careful.
            </p>
          </aside>
        </details>
      </div>
    </section>

    <section
      data-band
      id="outputs"
      class="outputs"
      aria-labelledby="outputs-title"
    >
      <div class="page-container section-stack">
        <div class="outputs-intro">
          <p class="eyebrow eyebrow-inverse">Deliverables and decisions</p>
          <h2 id="outputs-title">
            Know what to watch, who acts, and what happens next.
          </h2>
          <p>
            You’ll get a working system for turning signals into action. Each
            deliverable makes it clear what to watch, who acts, how they
            respond, and what to improve next.
          </p>
        </div>

        <ol class="output-list" role="list">
          {
            deliverables.map((deliverable) => (
              <li>
                <article class="output">
                  <div class="output-heading">
                    <p class="output-number" aria-hidden="true">
                      {deliverable.number}
                    </p>
                    <h3>{deliverable.title}</h3>
                  </div>
                  <p class="output-description">{deliverable.description}</p>
                  <p class="output-decision">
                    <span>Supports the decision</span>
                    {deliverable.decision}
                  </p>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="fit" class="fit section-block" aria-labelledby="fit-title">
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Engagement fit</p>
            <h2 id="fit-title">Use this review when risk shows up too late.</h2>
          </div>
          <p>
            I’ll need access to the teams, customer context, lifecycle data, and
            the decisions behind your response. And you’ll need to be open to
            changing how risk gets defined, owned, and reviewed.
          </p>
        </div>

        <div class="fit-grid">
          <article class="fit-panel fit-panel-strong">
            <p class="fit-label">Strong fit</p>
            <h3>This is likely a good fit when</h3>
            <ul role="list">
              {strongFit.map((criterion) => <li>{criterion}</li>)}
            </ul>
          </article>

          <article class="fit-panel">
            <p class="fit-label fit-label-muted">Limited fit</p>
            <h3>Another path may work better when</h3>
            <ul role="list">
              {limitedFit.map((criterion) => <li>{criterion}</li>)}
            </ul>
          </article>
        </div>
      </div>
    </section>

    <RelatedPaths
      title="Go deeper on the risks this review looks for."
      items={relatedPaths}
    />

    <section
      id="next-step"
      class="next-step section-block"
      aria-labelledby="next-step-title"
    >
      <div class="page-container next-step-layout">
        <div>
          <p class="eyebrow">Next step</p>
          <h2 id="next-step-title">Tell me where risk appears too late.</h2>
        </div>

        <div class="next-step-copy">
          <p>
            Tell me when risk usually shows up, which stages it hits, who’s
            involved, and what signals you already have. I’ll tell you straight
            whether this review is the right start, or whether another path
            makes more sense.
          </p>

          <dl class="next-step-details">
            <div>
              <dt>Useful context</dt>
              <dd>
                Lifecycle concern, available signals, teams involved, and
                accountable sponsor
              </dd>
            </div>
            <div>
              <dt>Expected outcome</dt>
              <dd>A direct answer about fit and the best next step</dd>
            </div>
          </dl>

          <div class="next-step-actions">
            <a class="button button-accent" href="/fit-check/">
              Start a fit check
            </a>
            <a class="services-link" href="/services/">
              Compare all diagnostics
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .diagnostic-page {
    display: flex;
    width: 100%;
    flex-direction: column;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .page-container {
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
  }

  .section-block {
    padding-block: var(--section-space);
    border-top: var(--border-width) solid var(--color-border);
  }

  .section-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2.75rem, 6vw, 5rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-blue);
  }

  .eyebrow-inverse {
    color: var(--color-green);
  }

  h1,
  h2,
  h3,
  p,
  dl,
  dd {
    margin-block: 0;
  }

  h1,
  h2,
  h3 {
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-feature-settings: var(--fea-graphik);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  h1 {
    max-width: 17ch;
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  h2 {
    max-width: 19ch;
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  h3 {
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
  }

  .diagnostic-hero {
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(4.5rem, 10vw, 8rem);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.65fr);
    gap: clamp(3rem, 10vw, 8rem);
    align-items: end;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .breadcrumb {
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
    margin: 0;
    padding: 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    line-height: var(--lh-small);
    list-style: none;
  }

  .breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .breadcrumb li + li::before {
    color: var(--color-border-strong);
    content: "/" / "";
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
  }

  .breadcrumb a:hover {
    color: var(--color-blue);
    text-decoration-color: currentColor;
  }

  .hero-lead {
    max-width: var(--measure-ui);
    margin-top: 1.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    margin-top: 2rem;
  }

  .trigger {
    padding: clamp(1.5rem, 3vw, 2rem);
    border-top: 0.25rem solid var(--color-blue);
    background: var(--color-surface-subtle);
  }

  .trigger-label {
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
  }

  .trigger > p:not(.trigger-label) {
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .trigger > p:nth-child(2) {
    margin-top: 1rem;
    font-size: var(--fs-body-ui);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
  }

  .trigger > p + p {
    margin-top: 1rem;
  }

  .questions,
  .fit {
    background: var(--color-surface-subtle);
  }

  .questions {
    scroll-margin-top: var(--header-offset);
  }

  .section-intro-split {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(18rem, 0.75fr);
    gap: clamp(2rem, 8vw, 7rem);
    align-items: end;
  }

  .section-intro-split > p,
  .next-step-copy > p {
    max-width: var(--measure-ui);
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .question-list,
  .evidence-grid,
  .output-list,
  .fit-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .diagnostic-disclosure {
    border-block: var(--border-width) solid var(--color-border-strong);
  }

  .diagnostic-disclosure + .diagnostic-disclosure {
    margin-top: calc(-1 * var(--border-width));
  }

  .diagnostic-disclosure summary {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    padding-block: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    line-height: var(--lh-h3);
    cursor: pointer;
    list-style: none;
  }

  .diagnostic-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .summary-action {
    flex: none;
    color: var(--color-blue);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }

  .summary-action::after {
    display: inline-block;
    margin-left: 0.65rem;
    content: "+";
  }

  .diagnostic-disclosure[open] .summary-action::after {
    content: "−";
  }

  .diagnostic-disclosure summary:focus-visible {
    outline: 0.1875rem solid var(--color-blue);
    outline-offset: 0.35rem;
  }

  .diagnostic-disclosure .question-list,
  .diagnostic-disclosure .evidence-grid {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .question-list {
    border-top: var(--border-width) solid var(--color-border-strong);
  }

  .question-list > li {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .question {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .item-number,
  .output-number {
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    font-feature-settings: var(--fea-tabular);
  }

  .question h3 {
    max-width: 31ch;
  }

  .question div > p {
    max-width: var(--measure-ui);
    margin-top: 0.75rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--border-width) solid var(--color-border-strong);
    border-left: var(--border-width) solid var(--color-border-strong);
  }

  .evidence-grid > li {
    min-width: 0;
    border-right: var(--border-width) solid var(--color-border-strong);
    border-bottom: var(--border-width) solid var(--color-border-strong);
  }

  .evidence-grid article {
    height: 100%;
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .evidence-grid h3 {
    margin-top: 0.75rem;
  }

  .evidence-grid article > p:last-child {
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .scope-note {
    display: grid;
    grid-template-columns: minmax(12rem, 0.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-left: 0.25rem solid var(--color-blue);
    background: var(--color-surface-subtle);
  }

  .scope-note p {
    max-width: var(--measure-ui);
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .outputs {
    padding-block: var(--section-space);
    background: var(--color-ink);
    color: var(--color-text-inverse);
  }

  .outputs-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.75fr);
    gap: 1rem clamp(2rem, 8vw, 7rem);
    align-items: end;
  }

  .outputs-intro .eyebrow {
    grid-column: 1 / -1;
  }

  .outputs h2,
  .outputs h3 {
    color: var(--color-text-inverse);
  }

  .outputs-intro > p:last-child {
    max-width: var(--measure-ui);
    color: var(--color-text-inverse-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .output-list {
    border-top: var(--border-width) solid rgb(252 254 255 / 28%);
  }

  .output-list > li {
    border-bottom: var(--border-width) solid rgb(252 254 255 / 28%);
  }

  .output {
