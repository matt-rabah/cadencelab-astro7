---
import Footer from "../../components/Footer.astro";
import NavHeader from "../../components/NavHeader.astro";
import SectionNav from "../../components/SectionNav.astro";
import Layout from "../../layouts/Layout.astro";

const diagnostics = [
  {
    id: "cx-systems-diagnostic",
    number: "01",
    name: "CX Systems Diagnostic",
    situation:
      "Customers get different answers, repeat themselves, or wait too long, and no team can see where it starts.",
    output:
      "A map of where friction occurs, who owns each part, which issues matter most, and what to fix first.",
    linkLabel: "See the CX Systems Diagnostic",
    href: "/services/cx-systems-diagnostic/",
  },
  {
    id: "lifecycle-risk-review",
    number: "02",
    name: "Lifecycle Risk Review",
    situation:
      "Onboarding drifts, accounts go quiet, adoption drops, and renewal risk shows up when it’s almost too late.",
    output:
      "A lifecycle risk model, a list of useful signals, a response map, and clear recommendations for earlier action.",
    linkLabel: "See the Lifecycle Risk Review",
    href: "/services/lifecycle-risk-review/",
  },
  {
    id: "crm-workflow-audit",
    number: "03",
    name: "CRM Workflow Audit",
    situation:
      "The CRM is full of fields, notes, and dashboards. Your team still runs the real work on spreadsheets, messages, and memory.",
    output:
      "A map of the current workflow, clear data and adoption findings, a cleanup plan, and requirements for a CRM people can trust.",
    linkLabel: "See the CRM Workflow Audit",
    href: "/services/crm-workflow-audit/",
  },
  {
    id: "ai-service-readiness-review",
    number: "04",
    name: "AI Service Readiness Review",
    situation:
      "You’re looking at AI for service, success, or operations, but the workflow, data, and human decision rules aren’t ready yet.",
    output:
      "A clear readiness decision, a map of where people stay involved, required guardrails, and a practical order for implementation.",
    linkLabel: "See the AI Service Readiness Review",
    href: "/services/ai-service-readiness-review/",
  },
];

const workingStages = [
  {
    number: "01",
    title: "Find the real cause",
    description:
      "Follow the customer problem through teams, systems, data, and frontline work until the source is obvious.",
    artifact: "A clear problem definition backed by current evidence",
  },
  {
    number: "02",
    title: "Agree on what must change",
    description:
      "Name the business value you’re moving, the owner, and the order of work before anything gets built.",
    artifact: "A clear decision about the future workflow and priorities",
  },
  {
    number: "03",
    title: "Build the next workable version",
    description:
      "Turn the decision into workflows, CRM requirements, handoff rules, team habits, governance, and the right amount of AI.",
    artifact: "Workflow requirements, clear ownership, and adoption needs",
  },
  {
    number: "04",
    title: "Measure and improve",
    description:
      "Measure against the value you named at the start. See what improved, prove it, and decide what’s next.",
    artifact: "A measurement plan with scheduled review points",
  },
];

const evidenceStandards = [
  {
    title: "Trace the problem",
    description:
      "Every recommendation comes from what I saw: real workflows, system behavior, customer signals, and the people doing the work.",
  },
  {
    title: "Name the decision and owner",
    description:
      "Say what has to be decided, who can decide it, and who owns the work after.",
  },
  {
    title: "Set the measure of success",
    description:
      "Tie it to a business value stream: revenue, retention, cost to serve, or risk. Say what the evidence can’t prove, and when you’ll check.",
  },
];
---

<Layout
  title="Customer Experience Diagnostic Services | Cadence Lab"
  description="Compare four Cadence Lab diagnostics for customer experience systems, lifecycle risk, CRM workflows, and AI service readiness. Find what to fix first."
  canonicalURL="/services/"
  pageType="website"
>
  <NavHeader />

  <main id="main-content" class="services-page" tabindex="-1">
    <section class="services-hero" aria-labelledby="services-title">
      <div class="page-container hero-layout">
        <div class="hero-copy">
          <p class="eyebrow">Services</p>

          <h1 id="services-title">
            Find the real problem before you fund the solution.
          </h1>

          <p class="hero-lead">
            Four focused diagnostics: customer experience, lifecycle risk, CRM workflows, and AI readiness. Each one shows you where the work is breaking, what it’s costing you, and what to fix first.
          </p>

          <div class="hero-actions" aria-label="Services page actions">
            <a class="button button-primary" href="/fit-check/">
              Start a FitCheck™
            </a>
            <a class="button button-text" href="#diagnostics">
              Compare the diagnostics
            </a>
          </div>
        </div>

        <aside class="hero-note" aria-labelledby="hero-note-title">
          <p id="hero-note-title" class="hero-note-label">How to start</p>
          <p>
            Start with the problem you need to understand. Don’t pick the technology until the evidence points to the next move.
          </p>
          <ul role="list">
            <li>One clear question</li>
            <li>Evidence your teams can share</li>
            <li>A practical decision about what comes next</li>
          </ul>
        </aside>
      </div>
    </section>

    <SectionNav
      items={[
        { label: "Diagnostics", href: "#diagnostics" },
        { label: "How it works", href: "#working-model" },
        { label: "Working standards", href: "#evidence" },
        { label: "FitCheck™", href: "#fit-check" },
      ]}
    />

    <section
      id="diagnostics"
      class="diagnostics section-block"
      aria-labelledby="diagnostics-title"
    >
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Four diagnostic services</p>
            <h2 id="diagnostics-title">
              Four ways to find what’s really going wrong.
            </h2>
          </div>

          <p>
            Each one looks at a different kind of customer or business risk. Every engagement ends the same way: the problem, the evidence, the business value at stake, and the next useful change.
          </p>
        </div>

        <ul class="diagnostic-list" role="list">
          {
            diagnostics.map((diagnostic) => (
              <li id={diagnostic.id}>
                <article class="diagnostic">
                  <div class="diagnostic-heading">
                    <p class="diagnostic-number">{diagnostic.number}</p>
                    <h3>{diagnostic.name}</h3>
                  </div>
                  <dl class="diagnostic-body">
                    <div>
                      <>
                        <dt>Choose this when</dt>
                        <dd>{diagnostic.situation}</dd>
                      </>
                    </div>
                    <div>
                      <>
                        <dt>What you receive</dt>
                        <dd>{diagnostic.output}</dd>
                      </>
                    </div>
                  </dl>
                  <a class="diagnostic-link" href={diagnostic.href}>
                    {diagnostic.linkLabel}
                    <span aria-hidden="true">&#8594;</span>
                  </a>
                </article>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section
      id="working-model"
      class="working-model section-block"
      aria-labelledby="working-model-title"
    >
      <div class="page-container working-layout">
        <div class="working-intro">
          <p class="eyebrow">How it works</p>
          <h2 id="working-model-title">
            A diagnostic tells you where to start.
          </h2>
          <p>
            Findings only matter if they change a decision, a workflow, who owns something, or how you measure success. So the work stays connected from diagnosis all the way through launch and review.
          </p>
        </div>

        <ol class="stage-list" role="list">
          {
            workingStages.map((stage) => (
              <li>
                <article class="stage">
                  <p class="stage-number" aria-hidden="true">
                    {stage.number}
                  </p>
                  <div class="stage-copy">
                    <h3>{stage.title}</h3>
                    <p>{stage.description}</p>
                    <p class="stage-artifact">
                      <span>Produces</span>
                      {stage.artifact}
                    </p>
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      data-band
      id="evidence"
      class="evidence"
      aria-labelledby="evidence-title"
    >
      <div class="page-container section-stack">
        <div class="evidence-intro">
          <p class="eyebrow eyebrow-inverse">Working standards</p>
          <h2 id="evidence-title">
            You should be able to trace every recommendation.
          </h2>
          <p>
            Workshops and launches aren’t results. Every recommendation should show its evidence, who owns it, and how you’ll know it worked. If you can’t prove it, you can’t defend the budget next year.
          </p>
        </div>

        <ul class="evidence-grid" role="list">
          {
            evidenceStandards.map((standard, index) => (
              <li>
                <article>
                  <p class="evidence-number" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </p>
                  <h3>{standard.title}</h3>
                  <p>{standard.description}</p>
                </article>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section
      id="fit-check"
      class="fit-check section-block"
      aria-labelledby="fit-check-title"
    >
      <div class="page-container fit-check-layout">
        <div>
          <p class="eyebrow">FitCheck™</p>
          <h2 id="fit-check-title">
            Bring me the messy version of the problem.
          </h2>
        </div>

        <div class="fit-check-copy">
          <p>
            Tell me what customers are going through, which teams and systems are involved, and what needs to change. I’ll point you to the right diagnostic, or tell you straight if something else makes more sense.
          </p>

          <dl class="fit-check-expectations">
            <div>
              <dt>Useful context</dt>
              <dd>
                Customer impact, teams and systems involved, and a sponsor
              </dd>
            </div>
            <div>
              <dt>What you’ll get</dt>
              <dd>A direct recommendation about fit and the next step</dd>
            </div>
          </dl>

          <a class="button button-accent" href="/fit-check/">
            Start the FitCheck™
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .services-page {
    display: flex;
    width: 100%;
    flex-direction: column;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .page-container {
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
  }

  .section-block {
    padding-block: var(--section-space);
    border-top: var(--border-width) solid var(--color-border);
  }

  .section-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2.75rem, 6vw, 5rem);
  }

  .section-stack-compact {
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
  }

  .eyebrow-inverse {
    color: var(--color-text-muted);
  }

  h1,
  h2,
  h3,
  p,
  dl,
  dd {
    margin-block: 0;
  }

  h1,
  h2,
  h3 {
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-feature-settings: var(--fea-graphik);
    text-wrap: balance;
  }

  h1 {
    max-width: 17ch;
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  h2 {
    max-width: 19ch;
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  h3 {
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
  }

  .services-hero {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.65fr);
    gap: clamp(3rem, 10vw, 8rem);
    align-items: end;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-lead {
    max-width: var(--measure-ui);
    margin-top: 1.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    margin-top: 2rem;
  }

  .hero-note {
    padding: clamp(1.5rem, 3vw, 2rem);
    border-top: 2px solid var(--color-text);
    background: var(--color-surface-subtle);
  }

  .hero-note-label {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    letter-spacing: 0;
  }

  .hero-note > p:last-of-type {
    margin-top: 0.75rem;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-body-ui);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .hero-note ul,
  .diagnostic-list,
  .selection-list,
  .stage-list,
  .evidence-grid {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-note ul {
    display: grid;
    gap: 0.625rem;
    margin-top: 1.25rem;
  }

  .hero-note li {
    position: relative;
    padding-left: 1rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.55;
  }

  .hero-note li::before {
    position: absolute;
    top: 0.67em;
    left: 0;
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 50%;
    background: var(--color-blue);
    content: "";
  }

  .diagnostics {
    scroll-margin-top: var(--header-offset);
    background: var(--color-surface-subtle);
  }

  .section-intro-split {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(18rem, 0.75fr);
    gap: clamp(2rem, 8vw, 7rem);
    align-items: end;
  }

  .section-intro-split > p,
  .working-intro > p:last-child,
  .fit-check-copy > p {
    max-width: var(--measure-ui);
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .diagnostic-list {
    border-top: var(--border-width) solid var(--color-border-strong);
  }

  .diagnostic-list > li {
    scroll-margin-top: calc(var(--header-offset) + 1rem);
    border-bottom: var(--border-width) solid var(--color-border-strong);
  }

  .diagnostic {
    display: grid;
    grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1.45fr);
    gap: clamp(2rem, 7vw, 6rem);
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .diagnostic-heading {
    align-self: start;
  }

  .diagnostic-number,
  .stage-number,
  .evidence-number {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    font-feature-settings: var(--fea-tabular);
  }

  .diagnostic-heading h3 {
    max-width: 17ch;
    margin-top: 0.75rem;
  }

  .diagnostic-body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem clamp(1.5rem, 4vw, 3rem);
  }

  .diagnostic-body div {
    min-width: 0;
  }

  .diagnostic-body dt {
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
  }

  .diagnostic-body dd {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .diagnostic-link {
    display: inline-flex;
    width: fit-content;
    min-height: var(--control-min-size);
    align-items: center;
    gap: 0.4rem;
    grid-column: 2;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-color: var(--color-blue);
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.25em;
    transition: color var(--transition-fast);
  }

  .diagnostic-link:hover {
    color: var(--color-blue);
  }

  .selection {
    background: var(--color-surface-subtle);
  }

  .selection-list {
    --selection-signal: #ffce31;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.875rem, 2vw, 1.25rem);
  }

  /* One accent for every card; see Stats.astro. */
  .selection-list > li {
    --selection-accent: var(--color-blue);

    min-width: 0;
    overflow: clip;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card-ambient);
    background: var(--color-surface-pure);
    transition: border-color var(--transition-standard);
  }

  .selection-list article {
    position: relative;
    display: flex;
    height: 100%;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .selection-meta {
    display: grid;
    width: 100%;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
  }

  .selection-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--selection-signal);
  }

  .selection-number,
  .selection-cue {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
  }

  .selection-number {
    color: var(--color-text-muted);
    font-feature-settings: var(--fea-tabular);
  }

  .selection-cue {
    color: var(--color-ink);
  }

  .selection-list h3 {
    max-width: 24ch;
    margin-top: 1.5rem;
  }

  .selection-decision {
    max-width: 52ch;
    margin-top: 0.875rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .selection-list a {
    display: inline-flex;
    min-height: var(--control-min-size);
    align-items: center;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-color: var(--selection-accent);
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.22em;
    transition:
      color var(--transition-fast),
      gap var(--transition-fast);
  }

  .selection-list .selection-arrow {
    color: var(--selection-accent);
    text-decoration: none;
  }

  .selection-scroll-hint {
    display: none;
    margin: -1.75rem 0 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    letter-spacing: 0;
  }

  @media (hover: hover) {
    .selection-list > li:has(a:hover) {
      border-color: var(--selection-accent);
    }

    .selection-list a:hover {
      gap: 0.75rem;
      color: var(--selection-accent);
    }
  }

  .working-model {
    background: var(--color-surface-subtle);
  }

  .working-layout {
    display: grid;
    grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(3rem, 10vw, 9rem);
    align-items: start;
  }

  .working-intro {
    position: sticky;
    top: calc(var(--header-offset) + 2rem);
  }

  .working-intro > p:last-child {
    margin-top: 1.25rem;
  }

  .stage-list {
    border-top: var(--border-width) solid var(--color-border-strong);
  }

  .stage-list > li {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .stage {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .stage-copy h3 {
    max-width: 29ch;
  }

  .stage-copy > p:not(.stage-artifact) {
    max-width: var(--measure-ui);
    margin-top: 0.75rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .stage-artifact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin-top: 1rem;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    line-height: var(--lh-small);
  }

  .stage-artifact span {
    color: var(--color-blue);
    font-weight: var(--fw-medium);
  }

  .evidence {
    padding-block: var(--section-space);
    background: var(--color-ink);
    color: var(--color-text-inverse);
  }

  .evidence-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.75fr);
    gap: 1rem clamp(2rem, 8vw, 7rem);
    align-items: end;
  }

  .evidence-intro .eyebrow {
    grid-column: 1 / -1;
  }

  .evidence h2,
  .evidence h3 {
    color: var(--color-text-inverse);
  }

  .evidence-intro > p:last-child {
    max-width: var(--measure-ui);
    color: var(--color-text-inverse-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--border-width) solid var(--color-border-inverse);
    border-bottom: var(--border-width) solid var(--color-border-inverse);
  }

  .evidence-grid li {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
