---
import Footer from "../../components/Footer.astro";
import NavHeader from "../../components/NavHeader.astro";
import SectionNav from "../../components/SectionNav.astro";
import TabbedPanels from "../../components/TabbedPanels.astro";
import Layout from "../../layouts/Layout.astro";

const diagnostics = [
  {
    id: "cx-systems-diagnostic",
    number: "01",
    name: "CX Systems Diagnostic",
    situation:
      "Customers get inconsistent service, repeat themselves, or wait too long, but no team can see where the problem starts.",
    examines:
      "Customer and team touchpoints, handoffs, ownership, CRM signals, service rules, and the systems that shape the experience.",
    output:
      "A map of where friction occurs, who owns each part, which issues matter most, and what to fix first.",
    continuation:
      "Service redesign, workflow cleanup, better customer signals, or AI-supported routing and summaries.",
    linkLabel: "See the CX Systems Diagnostic",
    href: "/services/cx-systems-diagnostic/",
  },
  {
    id: "lifecycle-risk-review",
    number: "02",
    name: "Lifecycle Risk Review",
    situation:
      "Onboarding drifts, accounts become quiet, adoption falls, or renewal risk appears when there is little time left to act.",
    examines:
      "Lifecycle stages, risk and health signals, handoffs, escalation paths, response rules, and missing customer context.",
    output:
      "A lifecycle risk model, a list of useful signals, a response map, and clear recommendations for earlier action.",
    continuation:
      "Better onboarding, stronger account health, earlier renewal planning, or a more useful customer success rhythm.",
    linkLabel: "See the Lifecycle Risk Review",
    href: "/services/lifecycle-risk-review/",
  },
  {
    id: "crm-workflow-audit",
    number: "03",
    name: "CRM Workflow Audit",
    situation:
      "The CRM contains fields, notes, activity, and dashboards, but teams still rely on spreadsheets, messages, and memory to get the work done.",
    examines:
      "How people use the CRM, field and data quality, automation, handoffs, reporting, ownership, and frontline workarounds.",
    output:
      "A map of the current workflow, clear data and adoption findings, a cleanup plan, and requirements for a CRM people can trust.",
    continuation:
      "CRM workflow redesign, segmentation, outreach and escalation rules, better reporting, or adoption support.",
    linkLabel: "See the CRM Workflow Audit",
    href: "/services/crm-workflow-audit/",
  },
  {
    id: "ai-service-readiness-review",
    number: "04",
    name: "AI Service Readiness Review",
    situation:
      "Your team is considering AI for service, customer success, or operations, but the workflow, data, and human decision rules are not ready.",
    examines:
      "Use-case fit, workflow readiness, data needs, human review, governance, adoption risk, trust, and success measures.",
    output:
      "A clear readiness decision, a map of where people stay involved, required guardrails, and a practical order for implementation.",
    continuation:
      "AI-assisted summaries, routing support, knowledge workflows, service visibility, or a focused decision-support pilot.",
    linkLabel: "See the AI Service Readiness Review",
    href: "/services/ai-service-readiness-review/",
  },
];

const selectionGuide = [
  {
    number: "01",
    cue: "Customers get stuck between teams and systems",
    choice: "CX Systems Diagnostic",
    decision: "Where does the problem start, and what should change first?",
    linkLabel: "Find the source of customer friction",
    href: "#cx-systems-diagnostic",
  },
  {
    number: "02",
    cue: "Risk becomes visible too late",
    choice: "Lifecycle Risk Review",
    decision: "Which early signals matter, and who should act on them?",
    linkLabel: "Find earlier risk signals",
    href: "#lifecycle-risk-review",
  },
  {
    number: "03",
    cue: "Teams record work in the CRM but do not trust it",
    choice: "CRM Workflow Audit",
    decision: "What keeps the CRM from supporting the work?",
    linkLabel: "Find the CRM workflow gaps",
    href: "#crm-workflow-audit",
  },
  {
    number: "04",
    cue: "The AI idea is ahead of the workflow",
    choice: "AI Service Readiness Review",
    decision: "Is this use case ready, and what must be fixed first?",
    linkLabel: "Check AI service readiness",
    href: "#ai-service-readiness-review",
  },
];

const workingStages = [
  {
    number: "01",
    title: "Find the real cause",
    description:
      "Follow the customer problem through teams, systems, data, decisions, and frontline work until the source becomes clear.",
    artifact: "A clear problem definition backed by current evidence",
  },
  {
    number: "02",
    title: "Agree on what must change",
    description:
      "Set the outcome, owner, boundaries, and order of work before implementation starts.",
    artifact: "A clear decision about the future workflow and priorities",
  },
  {
    number: "03",
    title: "Build the next workable version",
    description:
      "Turn the recommendation into workflows, CRM requirements, handoff rules, team practices, governance, and the right level of AI support.",
    artifact: "Workflow requirements, clear ownership, and adoption needs",
  },
  {
    number: "04",
    title: "Measure and improve",
    description:
      "Use customer, workflow, adoption, and performance measures to see what improved and what needs more work.",
    artifact: "A measurement plan with scheduled review points",
  },
];

const evidenceStandards = [
  {
    title: "Trace the problem",
    description:
      "Base each recommendation on observed workflows, system behavior, customer signals, and what the people doing the work can show.",
  },
  {
    title: "Name the decision and owner",
    description:
      "State what your team must decide, who can make that decision, and who owns the work that follows.",
  },
  {
    title: "Set the measure of success",
    description:
      "Define which customer and workflow measures should improve, what the evidence cannot prove, and when to review the result.",
  },
];
---

<Layout
  title="Customer Experience Diagnostic Services | Cadence Lab"
  description="Compare four Cadence Lab diagnostics for customer experience systems, lifecycle risk, CRM workflows, and AI service readiness. Find what to fix first."
  canonicalURL="/services/"
  pageType="website">
  <NavHeader />

  <main id="main-content" class="services-page" tabindex="-1">
    <section class="services-hero" aria-labelledby="services-title">
      <div class="page-container hero-layout">
        <div class="hero-copy">
          <p class="eyebrow">Services</p>

          <h1 id="services-title">
            Find the real problem before you fund the solution.
          </h1>

          <p class="hero-lead">
            Cadence Lab offers four focused diagnostics for customer experience,
            lifecycle risk, CRM workflows, and AI readiness. Each one shows you
            where the work is breaking and what to fix first.
          </p>

          <div class="hero-actions" aria-label="Services page actions">
            <a class="button button-primary" href="/fit-check/">
              Start a fit check
            </a>
            <a class="button button-text" href="#diagnostics">
              Compare the diagnostics
            </a>
          </div>
        </div>

        <aside class="hero-note" aria-labelledby="hero-note-title">
          <p id="hero-note-title" class="hero-note-label">How to start</p>
          <p>
            Start with the problem you need to understand. Do not choose the
            technology until the evidence points to the right next move.
          </p>
          <ul role="list">
            <li>One clear question</li>
            <li>Evidence your teams can share</li>
            <li>A practical decision about what comes next</li>
          </ul>
        </aside>
      </div>
    </section>

    <SectionNav
      items={[
        { label: "Diagnostics", href: "#diagnostics" },
        { label: "Find your match", href: "#selection" },
        { label: "How it works", href: "#working-model" },
        { label: "Working standards", href: "#evidence" },
        { label: "Fit check", href: "#fit-check" },
      ]}
    />

    <section
      id="diagnostics"
      class="diagnostics section-block"
      aria-labelledby="diagnostics-title">
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Four diagnostic services</p>
            <h2 id="diagnostics-title">
              Four ways to find what’s really going wrong.
            </h2>
          </div>

          <p>
            Each diagnostic focuses on a different kind of customer or business
            risk. Every engagement ends with a clear account of the problem, the
            evidence behind it, and the next useful change.
          </p>
        </div>

        <TabbedPanels
          idPrefix="services-diagnostics"
          label="Compare diagnostic services"
          panels={diagnostics.map((diagnostic) => ({
            id: diagnostic.id,
            label: diagnostic.name,
            number: diagnostic.number,
            title: diagnostic.name,
            details: [
              {
                label: "Choose this when",
                value: diagnostic.situation,
              },
              {
                label: "What we examine",
                value: diagnostic.examines,
              },
              {
                label: "What you receive",
                value: diagnostic.output,
              },
              {
                label: "What can follow",
                value: diagnostic.continuation,
              },
            ],
            link: {
              label: diagnostic.linkLabel,
              href: diagnostic.href,
            },
          }))}
        />
      </div>
    </section>

    <section
      id="selection"
      class="selection section-block"
      aria-labelledby="selection-title">
      <div class="page-container section-stack section-stack-compact">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Find your match</p>
            <h2 id="selection-title">
              Choose the problem you need to understand first.
            </h2>
          </div>

          <p>
            You may recognize more than one problem. Start with the one blocking
            the most important decision. The first diagnostic can show whether
            another review is needed later.
          </p>
        </div>

        <ul class="selection-list" role="list">
          {
            selectionGuide.map((item) => (
              <li>
                <article>
                  <div class="selection-meta">
                    <span class="selection-dot" aria-hidden="true" />
                    <p class="selection-number" aria-hidden="true">
                      {item.number}
                    </p>
                    <p class="selection-cue">{item.cue}</p>
                  </div>
                  <h3>{item.choice}</h3>
                  <p class="selection-decision">{item.decision}</p>
                  <a href={item.href}>
                    <span>{item.linkLabel}</span>
                    <span class="selection-arrow" aria-hidden="true">
                      &#8594;
                    </span>
                  </a>
                </article>
              </li>
            ))
          }
        </ul>
        <p class="selection-scroll-hint">
          Scroll to compare <span aria-hidden="true">&#8594;</span>
        </p>
      </div>
    </section>

    <section
      id="working-model"
      class="working-model section-block"
      aria-labelledby="working-model-title">
      <div class="page-container working-layout">
        <div class="working-intro">
          <p class="eyebrow">How it works</p>
          <h2 id="working-model-title">
            A diagnostic tells you where to start.
          </h2>
          <p>
            Findings matter only when they improve a decision, workflow,
            ownership problem, or measure of success. The work stays connected
            from diagnosis through implementation and review.
          </p>
        </div>

        <ol class="stage-list" role="list">
          {
            workingStages.map((stage) => (
              <li>
                <article class="stage">
                  <p class="stage-number" aria-hidden="true">
                    {stage.number}
                  </p>
                  <div class="stage-copy">
                    <h3>{stage.title}</h3>
                    <p>{stage.description}</p>
                    <p class="stage-artifact">
                      <span>Produces</span>
                      {stage.artifact}
                    </p>
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="evidence" class="evidence" aria-labelledby="evidence-title">
      <div class="page-container section-stack">
        <div class="evidence-intro">
          <p class="eyebrow eyebrow-inverse">Working standards</p>
          <h2 id="evidence-title">
            You should be able to trace every recommendation.
          </h2>
          <p>
            Workshops, activity, and technology launches are not results. Every
            recommendation should show the evidence behind it, the person who
            owns it, and how the team will judge whether it worked.
          </p>
        </div>

        <ul class="evidence-grid" role="list">
          {
            evidenceStandards.map((standard, index) => (
              <li>
                <article>
                  <p class="evidence-number" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </p>
                  <h3>{standard.title}</h3>
                  <p>{standard.description}</p>
                </article>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section
      id="fit-check"
      class="fit-check section-block"
      aria-labelledby="fit-check-title">
      <div class="page-container fit-check-layout">
        <div>
          <p class="eyebrow">Fit check</p>
          <h2 id="fit-check-title">
            Bring me the messy version of the problem.
          </h2>
        </div>

        <div class="fit-check-copy">
          <p>
            Tell me what customers are experiencing, which teams and systems are
            involved, and what needs to change. I’ll recommend the best
            diagnostic match and say plainly if another path makes more sense.
          </p>

          <dl class="fit-check-expectations">
            <div>
              <dt>Useful context</dt>
              <dd>
                Customer impact, teams and systems involved, and a sponsor
              </dd>
            </div>
            <div>
              <dt>What you’ll get</dt>
              <dd>A direct recommendation about fit and the next step</dd>
            </div>
          </dl>

          <a class="button button-accent" href="/fit-check/">
            Start the Fit Check™
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .services-page {
    display: flex;
    width: 100%;
    flex-direction: column;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .page-container {
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
  }

  .section-block {
    padding-block: var(--section-space);
    border-top: var(--border-width) solid var(--color-border);
  }

  .section-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2.75rem, 6vw, 5rem);
  }

  .section-stack-compact {
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-blue);
  }

  .eyebrow-inverse {
    color: var(--color-green);
  }

  h1,
  h2,
  h3,
  p,
  dl,
  dd {
    margin-block: 0;
  }

  h1,
  h2,
  h3 {
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-feature-settings: var(--fea-graphik);
    text-wrap: balance;
  }

  h1 {
    max-width: 17ch;
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  h2 {
    max-width: 19ch;
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  h3 {
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
  }

  .services-hero {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.65fr);
    gap: clamp(3rem, 10vw, 8rem);
    align-items: end;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-lead {
    max-width: var(--measure-ui);
    margin-top: 1.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    margin-top: 2rem;
  }

  .hero-note {
    padding: clamp(1.5rem, 3vw, 2rem);
    border-top: 0.25rem solid var(--color-blue);
    background: var(--color-surface-subtle);
  }

  .hero-note-label {
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
  }

  .hero-note > p:last-of-type {
    margin-top: 0.75rem;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-body-ui);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .hero-note ul,
  .diagnostic-list,
  .selection-list,
  .stage-list,
  .evidence-grid {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-note ul {
    display: grid;
    gap: 0.625rem;
    margin-top: 1.25rem;
  }

  .hero-note li {
    position: relative;
    padding-left: 1rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.55;
  }

  .hero-note li::before {
    position: absolute;
    top: 0.67em;
    left: 0;
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 50%;
    background: var(--color-blue);
    content: "";
  }

  .diagnostics {
    scroll-margin-top: var(--header-offset);
    background: var(--color-surface-subtle);
  }

  .section-intro-split {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(18rem, 0.75fr);
    gap: clamp(2rem, 8vw, 7rem);
    align-items: end;
  }

  .section-intro-split > p,
  .working-intro > p:last-child,
  .fit-check-copy > p {
    max-width: var(--measure-ui);
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .diagnostic-list {
    border-top: var(--border-width) solid var(--color-border-strong);
  }

  .diagnostic-list > li {
    scroll-margin-top: calc(var(--header-offset) + 1rem);
    border-bottom: var(--border-width) solid var(--color-border-strong);
  }

  .diagnostic {
    display: grid;
    grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1.45fr);
    gap: clamp(2rem, 7vw, 6rem);
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .diagnostic-heading {
    align-self: start;
  }

  .diagnostic-number,
  .stage-number,
  .evidence-number {
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    font-feature-settings: var(--fea-tabular);
  }

  .diagnostic-heading h3 {
    max-width: 17ch;
    margin-top: 0.75rem;
  }

  .diagnostic-body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem clamp(1.5rem, 4vw, 3rem);
  }

  .diagnostic-body div {
    min-width: 0;
  }

  .diagnostic-body dt {
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
  }

  .diagnostic-body dd {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .diagnostic-link {
    display: inline-flex;
    width: fit-content;
    min-height: var(--control-min-size);
    align-items: center;
    gap: 0.4rem;
    grid-column: 2;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-color: var(--color-blue);
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.25em;
    transition: color var(--transition-fast);
  }

  .diagnostic-link:hover {
    color: var(--color-blue);
  }

  .selection {
    background: linear-gradient(
      180deg,
      var(--color-surface) 0%,
      color-mix(in oklab, var(--color-blue) 3%, var(--color-surface-subtle))
        100%
    );
  }

  .selection-list {
    --selection-signal: #ffce31;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.875rem, 2vw, 1.25rem);
  }

  .selection-list > li:nth-child(1) {
    --selection-accent: var(--color-blue);
  }

  .selection-list > li:nth-child(2) {
    --selection-accent: #11683f;
  }

  .selection-list > li:nth-child(3) {
    --selection-accent: #5940a8;
  }

  .selection-list > li:nth-child(4) {
    --selection-accent: #9a4b00;
  }

  .selection-list > li {
    min-width: 0;
    overflow: clip;
    border: var(--border-width) solid var(--color-border-strong);
    border-block-start: 0.25rem solid var(--selection-accent);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(
        135deg,
        transparent 55%,
        color-mix(in oklab, var(--selection-accent) 7%, transparent) 100%
      ),
      color-mix(in oklab, var(--selection-accent) 4%, var(--color-surface-pure));
    transition:
      border-color var(--transition-standard),
      background-color var(--transition-standard),
      translate var(--transition-standard);
  }

  .selection-list article {
    position: relative;
    display: flex;
    height: 100%;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .selection-meta {
    display: grid;
    width: 100%;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
  }

  .selection-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--selection-signal);
  }

  .selection-number,
  .selection-cue {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
  }

  .selection-number {
    color: var(--color-text-muted);
    font-feature-settings: var(--fea-tabular);
  }

  .selection-cue {
    color: var(--color-ink);
  }

  .selection-list h3 {
    max-width: 24ch;
    margin-top: 1.5rem;
  }

  .selection-decision {
    max-width: 52ch;
    margin-top: 0.875rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .selection-list a {
    display: inline-flex;
    min-height: var(--control-min-size);
    align-items: center;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-color: var(--selection-accent);
