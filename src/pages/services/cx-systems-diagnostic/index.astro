---
import BreadcrumbSchema from "../../../components/BreadcrumbSchema.astro";
import RelatedPaths from "../../../components/RelatedPaths.astro";
import Footer from "../../../components/Footer.astro";
import NavHeader from "../../../components/NavHeader.astro";
import SectionNav from "../../../components/SectionNav.astro";
import Layout from "../../../layouts/Layout.astro";

const diagnosticQuestions = [
  {
    number: "01",
    question: "Where does customer friction start?",
    explanation:
      "Follow the problem across teams, systems, rules, and handoffs until you hit the source. Not the symptom. The source.",
  },
  {
    number: "02",
    question: "Which breakdowns matter most?",
    explanation:
      "Separate the one-off from the repeat offender. Then name what it’s costing you: revenue, retention, cost to serve, or risk.",
  },
  {
    number: "03",
    question: "Who owns the decision and the work?",
    explanation:
      "Find the gaps in ownership, the fuzzy decision rights, and the handoffs where context or urgency gets dropped.",
  },
  {
    number: "04",
    question: "What should you change first, and how will you prove it worked?",
    explanation:
      "Pick the business value you’re moving before you design anything. Then put the workflow, data, ownership, and system changes in order.",
  },
];

const evidenceAreas = [
  {
    title: "Customer and service signals",
    description:
      "Complaints, escalations, contact reasons, feedback, service exceptions, renewal concerns, and other signs of repeated friction.",
  },
  {
    title: "Workflows and handoffs",
    description:
      "How work moves across teams, including queues, approvals, transfers, workarounds, delays, and places where context gets lost.",
  },
  {
    title: "Ownership and decisions",
    description:
      "Who owns the outcome, who can make decisions, how issues escalate, and where ownership breaks down in practice.",
  },
  {
    title: "CRM and system behavior",
    description:
      "Fields, records, automation, routing, reports, knowledge sources, and the system signals teams use during customer work.",
  },
  {
    title: "Frontline operating reality",
    description:
      "How people really use the tools, read the rules, handle exceptions, and work around processes that don’t fit the job.",
  },
  {
    title: "Measurement and review",
    description:
      "What you measure today, what’s missing, how often anyone looks, and whether the numbers show outcomes or just activity.",
  },
];

const deliverables = [
  {
    number: "01",
    title: "Cross-functional friction map",
    description:
      "A shared view of the customer problem across touchpoints, teams, systems, decisions, and dependencies.",
    decision:
      "Where to focus, instead of treating every symptom like its own problem.",
  },
  {
    number: "02",
    title: "Ownership and handoff analysis",
    description:
      "A clear view of where ownership is missing, duplicated, delayed, or separated from the power to act.",
    decision: "Which roles, decision rights, and handoffs need to change.",
  },
  {
    number: "03",
    title: "Prioritized operating issues",
    description:
      "Findings ranked by customer impact, the business value at stake, how strong the evidence is, and what depends on what.",
    decision:
      "Which issues need action now, which need more evidence, and which can wait.",
  },
  {
    number: "04",
    title: "Practical improvement sequence",
    description:
      "The order to change workflows, ownership, data, measurement, and technology, with the business result each step should move.",
    decision:
      "What to do next, who needs to be in the room, and what has to be true before you scale it.",
  },
];

const strongFit = [
  "Customer friction crosses teams, systems, or stages of the experience.",
  "You keep seeing the same problems and nobody can say what’s causing them.",
  "A sponsor can bring the right business, service, operations, and technical people together.",
  "Your leaders are willing to change ownership or workflows when the evidence says so.",
];

const limitedFit = [
  "The answer’s already been chosen and the review is just there to justify a purchase.",
  "The problem is limited to one clear task that a focused process fix can solve.",
  "The right teams, evidence, or decision-makers can’t take part.",
  "Success means launching technology, not improving things for customers or your team.",
];

const relatedPaths = [
  {
    title: "Cross-functional Links",
    href: "/workflows/cross-functional/",
    description:
      "Repair the handoffs where customer context, ownership, or urgency gets lost between teams.",
  },
  {
    title: "Customer Experience Foundations",
    href: "/product/experience-foundations/",
    description:
      "Agree on what customers need, who owns each step, and what to fix first.",
  },
  {
    title: "On-Site Customer Experience Design",
    href: "/product/cx-on-location/",
    description:
      "Connect arrival, physical space, frontline service, digital touchpoints, and follow-up.",
  },
  {
    title: "Executive Misalignment",
    href: "/solutions/misalignment/",
    description:
      "Turn competing executive priorities into one decision, clear ownership, and a working sequence.",
  },
  {
    title: "AI and CX System Governance",
    href: "/governance/",
    description:
      "Set decisions, owners, evidence, and review for AI, CRM, automation, and customer workflows.",
  },
  {
    title: "Solutions by Use Case",
    href: "/solutions/use-case/",
    description:
      "Find the right CX, CRM, lifecycle, digital, location, or AI path for the problem in front of you.",
  },
];
---

<Layout
  title="CX Systems Diagnostic | Cadence Lab"
  description="Find the source of customer friction across teams, systems, ownership, and handoffs. See what to fix first with a CX Systems Diagnostic."
  canonicalURL="/services/cx-systems-diagnostic/"
  pageType="website"
>
  <NavHeader />
  <BreadcrumbSchema
    items={[
      { name: "Services", href: "/services/" },
      { name: "CX Systems Diagnostic" },
    ]}
  />

  <main id="main-content" class="diagnostic-page" tabindex="-1">
    <section class="diagnostic-hero" aria-labelledby="diagnostic-title">
      <div class="page-container hero-layout">
        <div class="hero-copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
              <li><a href="/services/">Services</a></li>
              <li aria-current="page">CX Systems Diagnostic</li>
            </ol>
          </nav>

          <p class="eyebrow">Diagnostic 01</p>
          <h1 id="diagnostic-title">Find what’s causing customer friction.</h1>
          <p class="hero-lead">
            Your customers don’t care which team dropped the ball. They just
            feel it. This diagnostic follows a repeated problem across
            workflows, ownership, CRM signals, service rules, and handoffs, so
            you can see where it starts, why it keeps happening, and what to fix
            first.
          </p>

          <div class="hero-actions" aria-label="CX Systems Diagnostic actions">
            <a class="button button-primary" href="/fit-check/">
              Start a fit check
            </a>
            <a class="button button-text" href="#outputs">
              See what you receive
            </a>
          </div>
        </div>

        <aside class="trigger" aria-labelledby="trigger-title">
          <p id="trigger-title" class="trigger-label">You may be seeing this</p>
          <p>
            Customers get different answers, repeat themselves, or wait too
            long. Every team sees its own slice of the problem. Nobody sees the
            whole thing.
          </p>
          <p>
            You’ve got data, projects, and local fixes. What you don’t have is
            one shared view of where the friction starts, or which problem is
            worth the most to fix.
          </p>
        </aside>
      </div>
    </section>

    <SectionNav
      items={[
        { label: "Outputs", href: "#outputs" },
        { label: "Explore", href: "#questions" },
        { label: "Fit", href: "#fit" },
        { label: "Next step", href: "#next-step" },
      ]}
    />

    <section
      id="questions"
      class="questions section-block"
      aria-labelledby="questions-title"
    >
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Questions answered</p>
            <h2 id="questions-title">
              Turn a messy customer problem into a clear decision.
            </h2>
          </div>
          <p>
            I start with what customers go through. Then I follow the evidence
            until the next move is obvious.
          </p>
        </div>

        <details class="diagnostic-disclosure" name="diagnostic-details">
          <summary>
            <span>Questions this diagnostic answers</span>
            <span class="summary-action">View questions</span>
          </summary>
          <ol class="question-list" role="list">
            {
              diagnosticQuestions.map((item) => (
                <li>
                  <article class="question">
                    <p class="item-number" aria-hidden="true">
                      {item.number}
                    </p>
                    <div>
                      <h3>{item.question}</h3>
                      <p>{item.explanation}</p>
                    </div>
                  </article>
                </li>
              ))
            }
          </ol>
        </details>
      </div>
    </section>

    <section
      id="scope"
      class="scope section-block"
      aria-labelledby="scope-title"
    >
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Scope and evidence</p>
            <h2 id="scope-title">Look at how the work really gets done.</h2>
          </div>
          <p>
            What I look at depends on the problem and what you can share. I test
            the patterns, compare the process on paper with the one people
            actually run, and tell you where the evidence is thin.
          </p>
        </div>

        <details class="diagnostic-disclosure" name="diagnostic-details">
          <summary>
            <span>Evidence we review</span>
            <span class="summary-action">View evidence</span>
          </summary>
          <ul class="evidence-grid" role="list">
            {
              evidenceAreas.map((area, index) => (
                <li>
                  <article>
                    <p class="item-number" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </p>
                    <h3>{area.title}</h3>
                    <p>{area.description}</p>
                  </article>
                </li>
              ))
            }
          </ul>

          <aside class="scope-note" aria-labelledby="scope-note-title">
            <h3 id="scope-note-title">Evidence before assumptions</h3>
            <p>
              You’ll know what’s proven, what’s just believed, and what still
              needs testing. Every recommendation shows its evidence, and where
              missing data means you should hold your confidence a little
              looser.
            </p>
          </aside>
        </details>
      </div>
    </section>

    <section
      data-band
      id="outputs"
      class="outputs"
      aria-labelledby="outputs-title"
    >
      <div class="page-container section-stack">
        <div class="outputs-intro">
          <p class="eyebrow eyebrow-inverse">Deliverables and decisions</p>
          <h2 id="outputs-title">
            See what’s broken, why it matters, and what to do next.
          </h2>
          <p>
            A list of findings isn’t much use on its own. Each deliverable
            answers a specific decision, so your team can move in the right
            order.
          </p>
        </div>

        <ol class="output-list" role="list">
          {
            deliverables.map((deliverable) => (
              <li>
                <article class="output">
                  <div class="output-heading">
                    <p class="output-number" aria-hidden="true">
                      {deliverable.number}
                    </p>
                    <h3>{deliverable.title}</h3>
                  </div>
                  <p class="output-description">{deliverable.description}</p>
                  <p class="output-decision">
                    <span>Supports the decision</span>
                    {deliverable.decision}
                  </p>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="fit" class="fit section-block" aria-labelledby="fit-title">
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Engagement fit</p>
            <h2 id="fit-title">
              Use this diagnostic when the problem crosses teams and systems.
            </h2>
          </div>
          <p>
            I’ll need access to the people, systems, and evidence around the
            work. And your team needs to be open to an answer that isn’t the one
            everyone assumed going in.
          </p>
        </div>

        <div class="fit-grid">
          <article class="fit-panel fit-panel-strong">
            <p class="fit-label">Strong fit</p>
            <h3>This is likely a good fit when</h3>
            <ul role="list">
              {strongFit.map((criterion) => <li>{criterion}</li>)}
            </ul>
          </article>

          <article class="fit-panel">
            <p class="fit-label fit-label-muted">Limited fit</p>
            <h3>Another path may work better when</h3>
            <ul role="list">
              {limitedFit.map((criterion) => <li>{criterion}</li>)}
            </ul>
          </article>
        </div>
      </div>
    </section>

    <RelatedPaths
      title="Go deeper on the systems this diagnostic maps."
      items={relatedPaths}
    />

    <section
      id="next-step"
      class="next-step section-block"
      aria-labelledby="next-step-title"
    >
      <div class="page-container next-step-layout">
        <div>
          <p class="eyebrow">Next step</p>
          <h2 id="next-step-title">Tell me where customers get stuck.</h2>
        </div>

        <div class="next-step-copy">
          <p>
            Tell me about the problem that keeps coming back, who’s involved,
            what evidence you have, and the decision you need to make. I’ll tell
            you straight whether this is the right place to start, or whether
            something simpler would do.
          </p>

          <dl class="next-step-details">
            <div>
              <dt>Useful context</dt>
              <dd>
                Customer impact, teams and systems involved, and accountable
                sponsor
              </dd>
            </div>
            <div>
              <dt>Expected outcome</dt>
              <dd>A direct answer about fit and the best next step</dd>
            </div>
          </dl>

          <div class="next-step-actions">
            <a class="button button-accent" href="/fit-check/">
              Start a fit check
            </a>
            <a class="services-link" href="/services/">
              Compare all diagnostics
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .diagnostic-page {
    display: flex;
    width: 100%;
    flex-direction: column;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .page-container {
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
  }

  .section-block {
    padding-block: var(--section-space);
    border-top: var(--border-width) solid var(--color-border);
  }

  .section-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2.75rem, 6vw, 5rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-blue);
  }

  .eyebrow-inverse {
    color: var(--color-green);
  }

  h1,
  h2,
  h3,
  p,
  dl,
  dd {
    margin-block: 0;
  }

  h1,
  h2,
  h3 {
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-feature-settings: var(--fea-graphik);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  h1 {
    max-width: 17ch;
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  h2 {
    max-width: 19ch;
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  h3 {
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
  }

  .diagnostic-hero {
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(4.5rem, 10vw, 8rem);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.65fr);
    gap: clamp(3rem, 10vw, 8rem);
    align-items: end;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .breadcrumb {
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
    margin: 0;
    padding: 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    line-height: var(--lh-small);
    list-style: none;
  }

  .breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .breadcrumb li + li::before {
    color: var(--color-border-strong);
    content: "/" / "";
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
  }

  .breadcrumb a:hover {
    color: var(--color-blue);
    text-decoration-color: currentColor;
  }

  .hero-lead {
    max-width: var(--measure-ui);
    margin-top: 1.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    margin-top: 2rem;
  }

  .trigger {
    padding: clamp(1.5rem, 3vw, 2rem);
    border-top: 0.25rem solid var(--color-blue);
    background: var(--color-surface-subtle);
  }

  .trigger-label {
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
  }

  .trigger > p:not(.trigger-label) {
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .trigger > p:nth-child(2) {
    margin-top: 1rem;
    font-size: var(--fs-body-ui);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
  }

  .trigger > p + p {
    margin-top: 1rem;
  }

  .questions,
  .fit {
    background: var(--color-surface-subtle);
  }

  .questions {
    scroll-margin-top: var(--header-offset);
  }

  .section-intro-split {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(18rem, 0.75fr);
    gap: clamp(2rem, 8vw, 7rem);
    align-items: end;
  }

  .section-intro-split > p,
  .next-step-copy > p {
    max-width: var(--measure-ui);
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .question-list,
  .evidence-grid,
  .output-list,
  .fit-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .diagnostic-disclosure {
    border-block: var(--border-width) solid var(--color-border-strong);
  }

  .diagnostic-disclosure + .diagnostic-disclosure {
    margin-top: calc(-1 * var(--border-width));
  }

  .diagnostic-disclosure summary {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    padding-block: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    line-height: var(--lh-h3);
    cursor: pointer;
    list-style: none;
  }

  .diagnostic-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .summary-action {
    flex: none;
    color: var(--color-blue);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }

  .summary-action::after {
    display: inline-block;
    margin-left: 0.65rem;
    content: "+";
  }

  .diagnostic-disclosure[open] .summary-action::after {
    content: "−";
  }

  .diagnostic-disclosure summary:focus-visible {
    outline: 0.1875rem solid var(--color-blue);
    outline-offset: 0.35rem;
  }

  .diagnostic-disclosure .question-list,
  .diagnostic-disclosure .evidence-grid {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .question-list {
    border-top: var(--border-width) solid var(--color-border-strong);
  }

  .question-list > li {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .question {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .item-number,
  .output-number {
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    font-feature-settings: var(--fea-tabular);
  }

  .question h3 {
    max-width: 31ch;
  }

  .question div > p {
    max-width: var(--measure-ui);
    margin-top: 0.75rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--border-width) solid var(--color-border-strong);
    border-left: var(--border-width) solid var(--color-border-strong);
  }

  .evidence-grid > li {
    min-width: 0;
    border-right: var(--border-width) solid var(--color-border-strong);
    border-bottom: var(--border-width) solid var(--color-border-strong);
  }

  .evidence-grid article {
    height: 100%;
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .evidence-grid h3 {
    margin-top: 0.75rem;
  }

  .evidence-grid article > p:last-child {
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .scope-note {
    display: grid;
    grid-template-columns: minmax(12rem, 0.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-left: 0.25rem solid var(--color-blue);
    background: var(--color-surface-subtle);
  }

  .scope-note p {
    max-width: var(--measure-ui);
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .outputs {
    padding-block: var(--section-space);
    background: var(--color-ink);
    color: var(--color-text-inverse);
  }

  .outputs-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.75fr);
    gap: 1rem clamp(2rem, 8vw, 7rem);
    align-items: end;
  }

  .outputs-intro .eyebrow {
    grid-column: 1 / -1;
  }

  .outputs h2,
  .outputs h3 {
    color: var(--color-text-inverse);
  }

  .outputs-intro > p:last-child {
    max-width: var(--measure-ui);
    color: var(--color-text-inverse-muted);
