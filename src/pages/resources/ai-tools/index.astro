---
import BreadcrumbSchema from "../../../components/BreadcrumbSchema.astro";
import Footer from "../../../components/Footer.astro";
import NavHeader from "../../../components/NavHeader.astro";
import SectionNav from "../../../components/SectionNav.astro";
import Layout from "../../../layouts/Layout.astro";

const futureTools = [
  {
    number: "02",
    area: "Customer journeys",
    title: "CX Handoff Mapper",
    description:
      "Map the steps, owners, systems, and evidence behind a customer journey. The tool would flag missing owners, duplicate work, weak handoffs, and places where customers are likely to get stuck.",
    output: "A shareable handoff map with risks and questions to resolve.",
  },
  {
    number: "03",
    area: "AI quality",
    title: "AI Evaluation Builder",
    description:
      "Describe an AI task, the result you need, and the errors that matter. The tool would turn that context into a practical evaluation rubric, test cases, and review rules.",
    output:
      "An editable evaluation plan with criteria, edge cases, and stop conditions.",
  },
  {
    number: "04",
    area: "Voice of customer",
    title: "Feedback Signal Sorter",
    description:
      "Paste a small set of anonymized customer comments. The tool would group recurring themes, show supporting evidence, surface contradictions, and separate patterns from one-off noise.",
    output:
      "A theme summary with evidence, open questions, and suggested next research.",
  },
  {
    number: "05",
    area: "CRM data",
    title: "CRM Data Health Sampler",
    description:
      "Review a sample CSV in the browser for missing values, likely duplicates, inconsistent formats, and fields that may not support the workflow people expect.",
    output:
      "A local data-quality snapshot with issues to inspect before migration or automation.",
  },
  {
    number: "06",
    area: "Service recovery",
    title: "Service Recovery Planner",
    description:
      "Describe a customer failure, the people affected, and the limits on what your team can offer. The tool would help shape a response, owner, timeline, and recovery checklist.",
    output:
      "A recovery plan with ownership, communication prompts, and follow-up steps.",
  },
];

const buildStandards = [
  {
    title: "Solve one clear problem",
    description:
      "Each tool should help someone complete a useful task, not generate a score designed to create anxiety.",
  },
  {
    title: "Give the result without a gate",
    description:
      "No account, email address, credit card, or sales call should be required to use the core tool or receive its output.",
  },
  {
    title: "Make the output portable",
    description:
      "People should be able to copy, download, or print the result and use it with their own team.",
  },
  {
    title: "Explain the limits",
    description:
      "Every result should show what it considered, what it could not know, and what still needs human judgment.",
  },
  {
    title: "Collect as little data as possible",
    description:
      "Use local browser processing when practical. If a tool sends data elsewhere, say where it goes and why before the user begins.",
  },
  {
    title: "Work for more people",
    description:
      "Build for keyboard use, screen readers, zoom, clear language, and useful results on mobile and desktop.",
  },
];
---

<Layout
  title="Free CX and AI Tools | Cadence Lab"
  description="Free, practical CX and AI tools for evaluating use cases, mapping handoffs, testing AI outputs, reviewing CRM data, and planning better customer work."
  canonicalURL="/resources/ai-tools/"
  pageType="website"
>
  <NavHeader />
  <BreadcrumbSchema currentName="Free CX and AI tools" />

  <main id="main-content" class="tools-page" tabindex="-1">
    <section class="tools-hero" aria-labelledby="tools-title">
      <div class="page-container hero-layout">
        <div class="hero-copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              <li aria-current="page">Free CX and AI tools</li>
            </ol>
          </nav>

          <p class="eyebrow">Free CX and AI tools</p>
          <h1 id="tools-title">
            Useful tools. No signup. No sales-form detour.
          </h1>
          <p class="hero-lead">
            Cadence Lab is building small tools that help people solve a real
            customer experience or AI problem. Each one will be free to use
            without an account or email address. You should get something useful
            even if we never work together.
          </p>

          <div class="hero-actions" aria-label="Free tools actions">
            <a class="button button-primary" href="#first-build">
              See the first build
            </a>
            <a class="button button-text" href="#tool-roadmap">
              View the roadmap
              <span aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </div>

        <aside class="promise-card" aria-labelledby="promise-title">
          <p id="promise-title" class="note-label">The deal</p>
          <p>
            These tools are meant to earn trust by being useful. They are not
            calculators that hide the answer behind a lead form.
          </p>
          <dl>
            <div>
              <dt>Cost</dt>
              <dd>Free</dd>
            </div>
            <div>
              <dt>Account</dt>
              <dd>Not required</dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd>Not required</dd>
            </div>
            <div>
              <dt>Launch dates</dt>
              <dd>Shared when the tools are ready</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <SectionNav
      items={[
        { label: "First build", href: "#first-build" },
        { label: "Tool roadmap", href: "#tool-roadmap" },
        { label: "Build standard", href: "#build-standard" },
        { label: "Privacy", href: "#privacy" },
        { label: "Beyond the tool", href: "#beyond-tool" },
      ]}
    />

    <section
      id="first-build"
      class="first-build section-block"
      aria-labelledby="first-build-title"
    >
      <div class="page-container first-layout">
        <div class="first-intro">
          <p class="eyebrow">Recommended first build</p>
          <p class="build-number">01</p>
          <h2 id="first-build-title">AI Use Case Stress Test</h2>
          <p>
            Describe an AI idea before the platform, pilot, or vendor decision
            is locked in. The tool would test whether the work, data, ownership,
            human judgment, controls, and expected outcome are clear enough to
            support a responsible next step.
          </p>
        </div>

        <div class="first-detail">
          <div>
            <p class="detail-label">You provide</p>
            <p>
              The user, task, desired outcome, available data, decision being
              supported, and consequence of a bad result.
            </p>
          </div>
          <div>
            <p class="detail-label">You get</p>
            <p>
              A one-page decision brief with readiness gaps, key dependencies,
              human-ownership questions, failure points, and the smallest useful
              test.
            </p>
          </div>
          <div>
            <p class="detail-label">Why this comes first</p>
            <p>
              It helps before teams spend money, asks for little sensitive data,
              and turns a broad AI idea into a decision people can discuss.
            </p>
          </div>
          <p class="status-line">
            <span>Status</span>
            First build candidate. No launch date yet.
          </p>
        </div>
      </div>
    </section>

    <section
      id="tool-roadmap"
      class="tool-roadmap"
      aria-labelledby="tool-roadmap-title"
    >
      <div class="page-container section-stack">
        <div class="section-intro section-intro-inverse">
          <p class="eyebrow eyebrow-inverse">Tool roadmap</p>
          <h2 id="tool-roadmap-title">Five more problems worth solving.</h2>
          <p>
            These are working directions, not product promises. The order may
            change as real users show which problem is most useful to solve
            next.
          </p>
        </div>

        <ol class="tool-grid">
          {
            futureTools.map((tool) => (
              <li>
                <article>
                  <div class="tool-heading">
                    <p class="item-number">{tool.number}</p>
                    <p class="tool-area">{tool.area}</p>
                  </div>
                  <h3>{tool.title}</h3>
                  <p>{tool.description}</p>
                  <div class="tool-output">
                    <p class="detail-label">Useful output</p>
                    <p>{tool.output}</p>
                  </div>
                  <p class="tool-status">Future candidate</p>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      id="build-standard"
      class="build-standard section-block"
      aria-labelledby="build-standard-title"
    >
      <div class="page-container standard-layout">
        <div class="standard-intro">
          <p class="eyebrow">Build standard</p>
          <h2 id="build-standard-title">
            Every tool must earn its place here.
          </h2>
          <p>
            A free tool is still a product. It should respect the user's time,
            data, and ability to make an informed decision.
          </p>
        </div>

        <ol class="standard-list">
          {
            buildStandards.map((standard, index) => (
              <li>
                <p class="item-number">{String(index + 1).padStart(2, "0")}</p>
                <div>
                  <h3>{standard.title}</h3>
                  <p>{standard.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="privacy" class="privacy" aria-labelledby="privacy-title">
      <div class="page-container privacy-layout">
        <div>
          <p class="eyebrow eyebrow-inverse">Privacy</p>
          <h2 id="privacy-title">The tool should ask for less.</h2>
          <p>
            No tool should need your identity just to return a useful result.
            When a tool goes live, its page will explain what it processes,
            whether information leaves your browser, which service handles it,
            and whether anything is retained.
          </p>
        </div>

        <aside aria-labelledby="privacy-boundary-title">
          <p id="privacy-boundary-title" class="note-label">
            Before using a tool
          </p>
          <p>
            Do not enter confidential, regulated, customer, employee, or
            proprietary information unless the tool clearly states that it is
            designed and approved for that data.
          </p>
        </aside>
      </div>
    </section>

    <section
      id="beyond-tool"
      class="beyond-tool section-block"
      aria-labelledby="beyond-tool-title"
    >
      <div class="page-container beyond-layout">
        <div>
          <p class="eyebrow">Beyond the tool</p>
          <h2 id="beyond-tool-title">
            A small tool can clarify one problem. It can't align the whole
            system.
          </h2>
        </div>

        <div class="beyond-copy">
          <p>
            Use the free result on your own. If the problem crosses teams,
            systems, data, ownership, or customer journeys, Cadence Lab can help
            turn that starting point into an operating decision.
          </p>
          <div class="beyond-actions">
            <a class="button button-primary" href="/services/">
              Review diagnostic offers
            </a>
            <a class="button button-text" href="/fit-check/">
              Start a fit check
              <span aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .tools-page {
    width: 100%;
    overflow: clip;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .page-container {
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
  }

  .section-block,
  .tool-roadmap,
  .privacy {
    padding-block: var(--section-space);
  }

  .tools-hero {
    padding-block: var(--section-space);
    border-bottom: var(--border-width) solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .hero-layout,
  .first-layout,
  .standard-layout,
  .privacy-layout,
  .beyond-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(19rem, 0.75fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .hero-layout {
    align-items: end;
  }

  .hero-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumb li {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .breadcrumb li + li::before {
    margin-inline-end: 0.5rem;
    color: var(--color-border-strong);
    content: "/";
  }

  .breadcrumb a {
    color: var(--color-blue);
    text-underline-offset: 0.25em;
  }

  .eyebrow,
  .note-label,
  .build-number,
  .detail-label,
  .item-number,
  .tool-area,
  .tool-status,
  .status-line span {
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    letter-spacing: 0.08em;
    font-feature-settings: var(--fea-graphik);
    text-transform: uppercase;
  }

  .eyebrow-inverse {
    color: var(--color-green);
  }

  h1,
  h2,
  h3,
  p,
  li,
  a,
  dt,
  dd {
    font-family: var(--font-sans);
    font-feature-settings: var(--fea-graphik);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  h1 {
    max-width: 16ch;
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: -0.04em;
  }

  h2 {
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: -0.025em;
  }

  h3 {
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h4);
    letter-spacing: -0.01em;
  }

  .hero-lead,
  .first-intro > p:last-child,
  .standard-intro > p:last-child,
  .privacy-layout > div > p:last-child,
  .beyond-copy > p {
    max-width: var(--measure-prose);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .hero-actions,
  .beyond-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .button {
    display: inline-flex;
    min-height: var(--control-min-size);
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.75rem 1rem;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    text-decoration: none;
  }

  .button-primary {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-light);
  }

  .button-text {
    color: var(--color-blue);
  }

  .promise-card,
  .privacy-layout aside {
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: var(--border-width) solid var(--color-border);
    border-top: 0.1875rem solid var(--color-blue);
    background: var(--color-surface-pure);
  }

  .promise-card > p:not(.note-label),
  .privacy-layout aside > p:not(.note-label) {
    margin: 1rem 0 0;
    color: var(--color-ink);
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
  }

  .promise-card dl {
    display: grid;
    margin: 1.5rem 0 0;
  }

  .promise-card dl > div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.85rem;
    border-top: var(--border-width) solid var(--color-border);
  }

  .promise-card dt,
  .promise-card dd {
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .promise-card dt {
    color: var(--color-text-muted);
  }

  .promise-card dd {
    margin: 0;
    color: var(--color-ink);
    font-weight: var(--fw-medium);
  }

  .first-layout,
  .standard-layout,
  .privacy-layout,
  .beyond-layout {
    align-items: start;
  }

  .first-intro,
  .standard-intro {
    display: grid;
    gap: 1rem;
  }

  .build-number {
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: var(--fs-h3);
  }

  .first-detail {
    border-top: var(--border-width) solid var(--color-border-strong);
  }

  .first-detail > div {
    padding-block: 1.5rem;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .first-detail > div > p:last-child,
  .tool-output > p:last-child {
    margin: 0.6rem 0 0;
    color: var(--color-text);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .status-line {
    margin: 1.5rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .status-line span {
    margin-inline-end: 0.75rem;
  }

  .tool-roadmap {
    background: var(--color-ink);
  }

  .section-stack {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
  }

  .section-intro {
    display: grid;
    max-width: 58rem;
    gap: 1rem;
  }

  .section-intro h2 {
    max-width: 18ch;
    color: var(--color-light);
  }

  .section-intro > p:last-child {
    max-width: var(--measure-prose);
    margin: 0;
    color: var(--color-text-inverse-muted);
    font-size: var(--fs-body);
    line-height: var(--lh-ui);
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: var(--border-width) solid var(--color-border-inverse);
    list-style: none;
  }

  .tool-grid > li {
    border-right: var(--border-width) solid var(--color-border-inverse);
    border-bottom: var(--border-width) solid var(--color-border-inverse);
  }

  .tool-grid > li:nth-child(2n) {
    border-right: 0;
  }

  .tool-grid article {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }

  .tool-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .tool-area {
    color: var(--color-text-inverse-muted);
    text-align: end;
  }

  .tool-grid h3 {
    color: var(--color-light);
  }

  .tool-grid article > p:not(.tool-status),
  .tool-output > p:last-child {
    margin: 0;
    color: var(--color-text-inverse-muted);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .tool-output {
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: var(--border-width) solid var(--color-border-inverse);
  }

  .tool-output .detail-label,
  .tool-status {
    color: var(--color-green);
  }

  .tool-output > p:last-child {
    margin-top: 0.5rem;
  }

  .tool-status {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .standard-list {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: var(--border-width) solid var(--color-border-strong);
    list-style: none;
  }

  .standard-list li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 1.5rem;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .standard-list h3 {
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
  }

  .standard-list li div > p {
    margin: 0.6rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .privacy {
    background: var(--color-ink);
  }

  .privacy-layout h2 {
    max-width: 14ch;
    margin-top: 0.75rem;
    color: var(--color-light);
  }

  .privacy-layout > div > p:last-child {
    margin-top: 1rem;
    color: var(--color-text-inverse-muted);
  }

  .privacy-layout aside {
    border-color: var(--color-border-inverse);
    border-top-color: var(--color-green);
    background: color-mix(in srgb, var(--color-ink) 92%, var(--color-light));
  }

  .privacy-layout aside .note-label {
    color: var(--color-green);
  }

  .privacy-layout aside > p:not(.note-label) {
    color: var(--color-light);
  }

  .beyond-layout h2 {
    max-width: 19ch;
    margin-top: 0.75rem;
  }

  .button:focus-visible,
  .breadcrumb a:focus-visible {
    outline: 0.1875rem solid var(--color-blue);
    outline-offset: 0.1875rem;
  }

  .button-primary:hover {
    background: var(--color-blue);
    border-color: var(--color-blue);
  }

  .button-text:hover,
  .breadcrumb a:hover {
    text-decoration-thickness: 0.125rem;
  }

  @media (max-width: 64rem) {
    .hero-layout,
    .first-layout,
    .standard-layout,
    .privacy-layout,
    .beyond-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 48rem) {
    .tool-grid {
      grid-template-columns: 1fr;
    }

    .tool-grid > li {
      border-right: 0;
    }
  }

  @media (max-width: 35rem) {
    .hero-actions,
    .beyond-actions {
      width: 100%;
      flex-direction: column;
    }

    .button {
      width: 100%;
    }

    .promise-card dl > div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .tool-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .tool-area {
      text-align: start;
    }
  }
</style>
