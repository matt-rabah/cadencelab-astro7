---
import StructuredCapabilityPage from "../../../components/StructuredCapabilityPage.astro";

const page = {
  meta: {
    title: "PII Scrubbing for AI Workflows | Cadence Lab",
    description:
      "Reduce unnecessary personal data in AI workflows with clear data boundaries, tested transformations, and accountable review.",
    canonicalURL: "/ai-tooling/compliance/",
  },
  hero: {
    breadcrumb: "PII scrubbing",
    eyebrow: "AI tooling · PII scrubbing",
    title: "Don't send personal data the task doesn't need.",
    lead: "A personally identifiable information (PII) scrubbing control removes, masks, or replaces personal data before it crosses an AI boundary. The goal isn't to erase every detail. It's to keep the information the task needs and reduce the exposure it doesn't.",
    primaryCta: {
      label: "Review AI Service Readiness",
      href: "/services/ai-service-readiness-review/",
    },
    secondaryCta: {
      label: "Start a fit check",
      href: "/fit-check/",
    },
    trigger: {
      introduction:
        "An AI workflow receives customer, employee, patient, financial, or account data that includes more identity than the task requires.",
      items: [
        {
          label: "Risk",
          value: "Personal data crosses an unnecessary boundary",
        },
        {
          label: "Control",
          value: "Detect, reduce, transform, test, and trace",
        },
        {
          label: "Decision",
          value: "Which data each step truly needs",
        },
      ],
    },
  },
  signals: {
    eyebrow: "Visible signals",
    title: "Personal data often travels farther than the work requires.",
    introduction:
      "Risk grows when a narrow AI task receives a full record, conversation, or document instead of the few facts it needs.",
    items: [
      {
        title: "A narrow task receives the whole record",
        description:
          "Names, contact details, notes, history, and attachments move together when the model needs only one fact.",
      },
      {
        title: "Free text bypasses field rules",
        description:
          "People place sensitive details in notes, messages, documents, and prompts that structured controls never inspect.",
      },
      {
        title: "Redaction happens after processing",
        description:
          "The visible answer is clean, but personal data remains in prompts, retrieved context, logs, traces, or tool calls.",
      },
      {
        title: "One masking rule covers every use case",
        description:
          "A global rule removes useful context, misses identity in context, and creates false confidence.",
      },
      {
        title: "No one knows where originals remain",
        description:
          "Teams can't explain which systems, vendors, logs, or people can still access the source value.",
      },
      {
        title: "A tool setting becomes proof of compliance",
        description:
          "The organization enables detection without proving purpose, accuracy, access, retention, or review.",
      },
    ],
  },
  framework: {
    eyebrow: "Control design",
    title: "Build each control around a clear purpose.",
    introduction:
      "A scrubbing control works only when you understand the data, the task, the change, and the systems on both sides.",
    items: [
      {
        label: "Purpose",
        question: "What decision needs this data?",
        title: "Purpose",
        description:
          "Define the use case, people affected, intended outcome, and minimum information needed.",
      },
      {
        label: "Classification",
        question: "What sensitive information may appear?",
        title: "Classification",
        description:
          "Identify direct identifiers, linked details, free text, credentials, and financial or health data.",
      },
      {
        label: "Transformation",
        question: "What should happen to each data type?",
        title: "Transformation",
        description:
          "Choose removal, masking, tokenization, generalization, blocking, or approved retention.",
      },
      {
        label: "Placement",
        question: "Where should the control run?",
        title: "Placement",
        description:
          "Place it before model input, retrieval, logging, tool calls, transfer, display, analytics, or storage.",
      },
      {
        label: "Testing",
        question: "How will you know it works?",
        title: "Testing",
        description:
          "Test missed data, false matches, task usefulness, downstream behavior, and re-identification risk.",
      },
      {
        label: "Ownership",
        question: "Who handles exceptions and change?",
        title: "Ownership",
        description:
          "Assign policy, review, incident response, retention, vendor oversight, and control updates.",
      },
    ],
  },
  path: {
    eyebrow: "Data path",
    title: "Trace personal data from collection to deletion.",
    introduction:
      "Follow real data through the workflow. At each boundary, ask whether it is still needed, who can access it, and whether the change preserves the task.",
    items: [
      {
        phase: "Collect",
        question: "Why did the workflow receive this information?",
        evidence:
          "Source, purpose, notice, permission, sensitivity, expected use, and owner.",
      },
      {
        phase: "Prepare",
        question: "What should change before AI processing?",
        evidence:
          "Data inventory, necessity, transformation rule, model context, and remaining meaning.",
      },
      {
        phase: "Process",
        question: "Who can see or rebuild the original?",
        evidence:
          "Provider, application, tools, logs, caches, keys, mappings, permissions, and vendors.",
      },
      {
        phase: "Return",
        question: "Could the output reveal sensitive information?",
        evidence:
          "Response, inference, downstream action, display, export, sharing, and human review.",
      },
      {
        phase: "Retain",
        question: "What remains, and for how long?",
        evidence:
          "Originals, tokens, mappings, prompts, outputs, logs, backups, deletion, and access history.",
      },
    ],
  },
  evidence: {
    eyebrow: "Evidence",
    title: "Test the full data path, not only the detector.",
    introduction:
      "Accuracy matters, but it isn't enough. You also need to show why data is used, what remains useful, where copies persist, and how exceptions are handled.",
    items: [
      {
        title: "Data inventory",
        description:
          "Fields, free text, files, images, metadata, sources, owners, sensitivity, and people represented.",
      },
      {
        title: "Purpose and need",
        description:
          "The decision, minimum data required, policy context, alternatives, and effect of processing.",
      },
      {
        title: "Transformation behavior",
        description:
          "Detection rules, confidence, masking, tokens, mappings, context preservation, and failure handling.",
      },
      {
        title: "System and vendor boundaries",
        description:
          "Applications, models, tools, stores, logs, vendors, regions, contracts, and data-use settings.",
      },
      {
        title: "Access and retention",
        description:
          "Roles, permissions, audit history, deletion schedules, backups, exceptions, and removal evidence.",
      },
      {
        title: "Testing and impact",
        description:
          "Missed data, false matches, language differences, re-identification, task quality, incidents, and corrections.",
      },
    ],
    note: {
      label: "A control, not a compliance claim",
      description:
        "PII scrubbing can reduce exposure. It doesn't prove legal compliance or remove every privacy risk. The full data lifecycle still matters.",
    },
  },
  failures: {
    eyebrow: "Common failure patterns",
    title: "Redaction fails when the rest of the data path stays hidden.",
    introduction:
      "Clean-looking text can hide originals, mappings, logs, and inferences that remain exposed elsewhere.",
    items: [
      {
        title: "Pattern matching becomes the privacy program",
        description:
          "Rules catch familiar formats but miss identity that depends on context or several linked fields.",
      },
      {
        title: "The token is safe, but the mapping isn't",
        description:
          "A shared lookup table, key, or stable identifier makes re-identification easy.",
      },
      {
        title: "Useful context disappears",
        description:
          "Aggressive scrubbing changes meaning needed for service, safety, fairness, fraud, or accessibility.",
      },
      {
        title: "Logs keep what the prompt removed",
        description:
          "Raw content reaches analytics, error tracking, or support tools before the model input is cleaned.",
      },
      {
        title: "An exception becomes a permanent bypass",
        description:
          "A valid override has no scope, end date, owner, review, or removal record.",
      },
      {
        title: "A vendor setting becomes end-to-end proof",
        description:
          "Provider controls are reviewed while collection, integrations, human access, and outputs remain untested.",
      },
    ],
  },
  outputs: {
    eyebrow: "Practical outputs",
    title: "Turn data minimization into a working control.",
    introduction:
      "The result shows where personal data appears, why it is needed, how it changes, how the control is tested, and who owns the remaining risk.",
    items: [
      {
        title: "Sensitive data flow map",
        description:
          "Collection, records, retrieval, prompts, models, tools, outputs, logs, vendors, access, and deletion.",
      },
      {
        title: "Control specification",
        description:
          "Placement, data classes, purpose, method, transformation, exceptions, permissions, and failure response.",
      },
      {
        title: "Test and exception plan",
        description:
          "Representative tests, missed data, false matches, approvals, owners, escalation, and time-limited overrides.",
      },
      {
        title: "Lifecycle ownership model",
        description:
          "Roles, vendor requirements, access review, retention, deletion evidence, incidents, and reassessment.",
      },
    ],
  },
  fit: {
    eyebrow: "Engagement fit",
    title: "Use PII scrubbing when personal data crosses an AI boundary.",
    introduction:
      "This work fits a defined workflow with known data sources, processing steps, and accountable owners. It supports, but doesn't replace, legal advice, security testing, vendor review, or a privacy program.",
    items: [
      "The use case processes personal, financial, health, account, or credential data.",
      "The task can work with less identity or detail than it receives today.",
      "The organization can inspect models, tools, logs, vendors, access, and retention.",
      "Privacy, security, legal, data, product, and operations can define the control.",
      "Leaders will stop or narrow processing when exposure can't be controlled.",
    ],
  },
  diagnostics: {
    eyebrow: "Related diagnostic paths",
    title: "Start with the workflow creating the exposure.",
    items: [
      {
        title: "AI Service Readiness Review",
        href: "/services/ai-service-readiness-review/",
        useWhen:
          "You need to define the use case, data needs, human oversight, safeguards, and implementation decision.",
      },
      {
        title: "CRM Workflow Audit",
        href: "/services/crm-workflow-audit/",
        useWhen:
          "Personal data starts in CRM records, notes, cases, integrations, reporting, or customer workflows.",
      },
      {
        title: "CX Systems Diagnostic",
        href: "/services/cx-systems-diagnostic/",
        useWhen:
          "The exposure crosses teams, systems, service rules, handoffs, ownership, or customer touchpoints.",
      },
    ],
  },
};
