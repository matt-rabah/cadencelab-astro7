---
import StructuredCapabilityPage from "../../../components/StructuredCapabilityPage.astro";

const page = {
  meta: {
    title: "AI Copilot Design | Cadence Lab",
    description:
      "Design AI copilots that bring trusted context into real workflows, support better decisions, and keep people accountable for the outcome.",
    canonicalURL: "/ai-tooling/co-pilot/",
  },
  hero: {
    breadcrumb: "AI copilot design",
    eyebrow: "AI tooling · AI copilot design",
    title: "Give people useful help without hiding the decision.",
    lead: "A good copilot does more than generate an answer. It brings the right context into the work, shows what it knows, and helps a person decide what happens next. The goal isn't maximum automation. It's better judgment with clear accountability.",
    primaryCta: {
      label: "Review AI Service Readiness",
      href: "/services/ai-service-readiness-review/",
    },
    secondaryCta: {
      label: "Start a fit check",
      href: "/fit-check/",
    },
    trigger: {
      introduction:
        "People spend too much time gathering context and preparing routine work, but the final decision still needs human judgment.",
      items: [
        {
          label: "Friction",
          value: "Useful judgment is buried under busywork",
        },
        {
          label: "Copilot role",
          value: "Gather, explain, recommend, and assist",
        },
        {
          label: "Decision",
          value: "What AI can prepare and what a person must own",
        },
      ],
    },
  },
  signals: {
    eyebrow: "Visible signals",
    title: "Start with work people already struggle to complete.",
    introduction:
      "A copilot should solve a clear operating problem. A general chat tool won't fix missing context, unclear ownership, or a workflow that never defined the decision.",
    items: [
      {
        title: "People rebuild the same story every time",
        description:
          "Customer history, policy, product behavior, and past decisions live across records, messages, and documents.",
      },
      {
        title: "Preparation delays expert judgment",
        description:
          "Skilled people search, summarize, format, and enter data before they can evaluate the real issue.",
      },
      {
        title: "Answers depend on who remembers what",
        description:
          "Similar cases get different treatment because guidance and past resolutions are hard to find during the work.",
      },
      {
        title: "Employees use unapproved AI tools",
        description:
          "People move work into general tools because approved systems don't provide useful help when they need it.",
      },
      {
        title: "Rules fail on the exceptions",
        description:
          "Automation handles the normal path, but unclear, sensitive, or cross-team cases still need interpretation.",
      },
      {
        title: "Usage is measured, but value isn't",
        description:
          "Leaders track adoption without knowing whether the copilot improved decisions, service, or rework.",
      },
    ],
  },
  framework: {
    eyebrow: "Copilot design",
    title: "Define the working relationship before the interface.",
    introduction:
      "A responsible copilot needs a clear role, trusted context, limited actions, visible uncertainty, and a human owner.",
    items: [
      {
        label: "Role",
        question: "Which part of the work should AI support?",
        title: "Role",
        description:
          "Name the person, task, outcome, help provided, and point where control returns to a person.",
      },
      {
        label: "Context",
        question: "Which evidence can shape the recommendation?",
        title: "Context",
        description:
          "Define approved sources, freshness, permissions, provenance, and information that must stay out.",
      },
      {
        label: "Judgment",
        question: "What must a person still decide?",
        title: "Judgment",
        description:
          "Identify the exceptions, tradeoffs, policy questions, and consequences that require human review.",
      },
      {
        label: "Action",
        question: "What can the copilot do after review?",
        title: "Action",
        description:
          "Limit drafts, updates, tool calls, and notifications by permission, confirmation, and reversibility.",
      },
      {
        label: "Escalation",
        question: "When should the copilot stop?",
        title: "Escalation",
        description:
          "Set clear triggers for missing evidence, uncertainty, sensitive content, conflict, or system failure.",
      },
      {
        label: "Learning",
        question: "How will real use improve the system?",
        title: "Learning",
        description:
          "Capture edits, overrides, rejected advice, exceptions, and outcomes without turning surveillance into the goal.",
      },
    ],
  },
  path: {
    eyebrow: "Assistance path",
    title: "Follow the work from request to accountable outcome.",
    introduction:
      "Trace real cases through the full human and system interaction. At every step, show what AI knows, what it recommends, and what the person owns.",
    items: [
      {
        phase: "Receive",
        question: "What is the person trying to complete?",
        evidence:
          "User, customer context, workflow state, request, urgency, permissions, and expected decision.",
      },
      {
        phase: "Assemble",
        question: "Which context is relevant and trustworthy?",
        evidence:
          "Sources, provenance, freshness, conflicts, missing facts, access rules, and sensitive data.",
      },
      {
        phase: "Recommend",
        question: "What help should the copilot provide?",
        evidence:
          "Summary, options, rationale, citations, uncertainty, and the next permitted action.",
      },
      {
        phase: "Decide",
        question: "What does the accountable person review?",
        evidence:
          "Confirmation, correction, override, escalation, added evidence, and decision ownership.",
      },
      {
        phase: "Act and learn",
        question: "What changed, and did it help?",
        evidence:
          "Actions, records, reversibility, customer effect, workflow result, feedback, and review.",
      },
    ],
  },
  evidence: {
    eyebrow: "Evidence",
    title: "Test the copilot inside the real workflow.",
    introduction:
      "A polished demo isn't proof. Evidence should show whether the copilot uses trusted context, improves the work, and behaves safely when the case gets difficult.",
    items: [
      {
        title: "Real tasks and cases",
        description:
          "Routine work, important exceptions, current effort, delays, handoffs, workarounds, and expected outcomes.",
      },
      {
        title: "Knowledge and sources",
        description:
          "Approved sources, ownership, freshness, retrieval, permissions, citations, conflicts, and missing evidence.",
      },
      {
        title: "Recommendation quality",
        description:
          "Accuracy, relevance, consistency, uncertainty, unacceptable errors, and results by meaningful case type.",
      },
      {
        title: "Human review",
        description:
          "Acceptance, edits, overrides, review time, disagreement, automation bias, and escalation behavior.",
      },
      {
        title: "Actions and controls",
        description:
          "Permissions, confirmations, tool results, failures, reversibility, audit history, and sensitive data handling.",
      },
      {
        title: "Operating outcomes",
        description:
          "Decision time, rework, customer effect, service quality, capacity, employee experience, and recovery cost.",
      },
    ],
    note: {
      label: "Support before autonomy",
      description:
        "More capability doesn't create accountability. Expand what a copilot can do only when evidence supports the task, controls, review, and consequences.",
    },
  },
  failures: {
    eyebrow: "Common failure patterns",
    title: "A copilot fails when weak work becomes easier to accept.",
    introduction:
      "Fluent output can hide missing evidence, unclear ownership, review burden, or a decision the business never defined.",
    items: [
      {
        title: "The chat box comes before the use case",
        description:
          "The team launches an interface without defining the task, evidence, decision owner, or measure of success.",
      },
      {
        title: "A summary hides conflicting sources",
        description:
          "The copilot turns disagreement into one clean answer instead of showing the issue that needs judgment.",
      },
      {
        title: "Human review becomes a formality",
        description:
          "People remain accountable but lack the time, context, or authority to challenge the recommendation.",
      },
      {
        title: "Permission expands without new evidence",
        description:
          "Drafting becomes sending and advice becomes action without a new review of risk or control.",
      },
      {
        title: "Corrections become invisible work",
        description:
          "Employees repair output and recover failed actions while reporting counts only generation time saved.",
      },
      {
        title: "Adoption becomes proof of value",
        description:
          "High usage looks successful even when decision quality, rework, trust, and customer outcomes remain unknown.",
      },
    ],
  },
  outputs: {
    eyebrow: "Practical outputs",
    title: "Turn a promising assistant into a working model.",
    introduction:
      "The result defines what the copilot supports, what it knows, what people decide, what it can do, and how the organization learns.",
    items: [
      {
        title: "Copilot role and boundary",
        description:
          "The user, task, outcome, assistance, exclusions, owner, escalation path, and conditions for expansion.",
      },
      {
        title: "Context and interaction model",
        description:
          "Approved sources, retrieval, permissions, uncertainty, review, corrections, and handoff behavior.",
      },
      {
        title: "Action and oversight rules",
        description:
          "Permitted tools, confirmations, reversibility, audit evidence, failure response, and control owners.",
      },
      {
        title: "Evaluation and learning plan",
        description:
          "Representative cases, quality criteria, outcome measures, feedback, monitoring, and review cadence.",
      },
    ],
  },
  fit: {
    eyebrow: "Engagement fit",
    title: "Use a copilot where better support can improve a real decision.",
    introduction:
      "This work fits a repeatable workflow that combines routine preparation with meaningful judgment. It isn't a strong fit for a general AI interface or a process with no clear owner.",
    items: [
      "A specific role performs a repeatable task with a defined outcome.",
      "The work depends on evidence from known systems, records, or guidance.",
      "Human judgment remains necessary for exceptions or consequences.",
      "The organization can inspect data, permissions, actions, review, and outcomes.",
      "Leaders will narrow the use case when the evidence doesn't support it.",
    ],
  },
  diagnostics: {
    eyebrow: "Related diagnostic paths",
    title: "Start with the operating system the copilot will enter.",
    items: [
      {
        title: "AI Service Readiness Review",
        href: "/services/ai-service-readiness-review/",
        useWhen:
          "You need to define the use case, human oversight, safeguards, measures, and implementation decision.",
      },
      {
        title: "CRM Workflow Audit",
        href: "/services/crm-workflow-audit/",
        useWhen:
          "The copilot depends on CRM records, automation, ownership, reporting, or customer work people don't trust.",
      },
      {
        title: "CX Systems Diagnostic",
        href: "/services/cx-systems-diagnostic/",
        useWhen:
          "The assistance crosses teams, systems, decisions, service rules, handoffs, or customer experience boundaries.",
      },
    ],
  },
};
