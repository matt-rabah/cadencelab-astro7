---
import Footer from "../../components/Footer.astro";
import NavHeader from "../../components/NavHeader.astro";
import Layout from "../../layouts/Layout.astro";

const supportPaths = [
  {
    number: "01",
    label: "Active project",
    title: "We are already working together",
    description:
      "Reply in the project channel or email thread you already use. That keeps your question tied to the right decisions, files, and people.",
    action: "See what to include",
    href: "#active-project",
  },
  {
    number: "02",
    label: "New problem",
    title: "You want help with a CX or AI problem",
    description:
      "Use the fit check to describe what is stuck, who it affects, and what needs to change. You do not need to know which service fits.",
    action: "Start a fit check",
    href: "/fit-check/",
  },
  {
    number: "03",
    label: "Service question",
    title: "You want to compare the diagnostics",
    description:
      "Review each diagnostic by the problem it addresses, the evidence it uses, and the decision it helps your team make.",
    action: "Compare diagnostics",
    href: "/services/",
  },
  {
    number: "04",
    label: "Site or content",
    title: "You found something that needs attention",
    description:
      "Use the contact page to report a broken link, content error, accessibility issue, or another general concern.",
    action: "Contact Cadence Lab",
    href: "/contact/",
  },
];

const usefulContext = [
  {
    number: "01",
    title: "What are you working on?",
    description:
      "Name the engagement, deliverable, workflow, or decision involved.",
  },
  {
    number: "02",
    title: "What changed?",
    description:
      "Share the new information, constraint, dependency, or point of confusion.",
  },
  {
    number: "03",
    title: "What does it affect?",
    description:
      "Explain the impact on a customer, decision, deadline, system, or team.",
  },
  {
    number: "04",
    title: "What would help next?",
    description:
      "Say whether you need an answer, review, recommendation, or change to the work.",
  },
];
---

<Layout
  title="Support | Cadence Lab"
  description="Find the right support path for an active Cadence Lab project, a new CX or AI problem, a service question, or a website issue."
  canonicalURL="/support/"
  pageType="website"
>
  <NavHeader />

  <main id="main-content" class="support-page" tabindex="-1">
    <section class="support-hero" aria-labelledby="support-title">
      <div class="page-container hero-layout">
        <div class="hero-copy">
          <p class="eyebrow">Support</p>
          <h1 id="support-title">Get the right help without starting over.</h1>
          <p class="hero-lead">
            If we are already working together, stay in the project thread. It
            has the context needed to answer your question. If not, choose the
            path that best matches what you need.
          </p>
        </div>

        <aside class="route-note" aria-labelledby="route-note-title">
          <p id="route-note-title" class="note-label">Start here</p>
          <p>Are we already working together?</p>
          <dl>
            <div>
              <dt>Yes</dt>
              <dd>Use your current project channel or email thread.</dd>
            </div>
            <div>
              <dt>No</dt>
              <dd>Choose a support path below.</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="support-routes" aria-labelledby="support-routes-title">
      <div class="page-container section-stack">
        <header class="section-intro">
          <p class="eyebrow">Choose a path</p>
          <h2 id="support-routes-title">
            Put your question in the right place.
          </h2>
          <p>
            You do not need to diagnose the problem first. Pick the closest
            match and share what you know.
          </p>
        </header>

        <div class="route-grid">
          {
            supportPaths.map((path) => (
              <article class="route-card">
                <div class="route-meta">
                  <span aria-hidden="true">{path.number}</span>
                  <span>{path.label}</span>
                </div>
                <div class="route-copy">
                  <h3>{path.title}</h3>
                  <p>{path.description}</p>
                </div>
                <a href={path.href}>
                  {path.action}
                  <span aria-hidden="true">&#8594;</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="active-project"
      class="active-project"
      aria-labelledby="active-project-title"
    >
      <div class="page-container active-layout">
        <header class="active-intro">
          <p class="eyebrow eyebrow-inverse">Active project support</p>
          <h2 id="active-project-title">
            A little context saves a lot of backtracking.
          </h2>
          <p>
            Keep your question in the project channel your team already uses.
            Include these four details so the next step is easier to see.
          </p>
        </header>

        <ol class="context-list">
          {
            usefulContext.map((item) => (
              <li>
                <p class="context-number" aria-hidden="true">
                  {item.number}
                </p>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="support-boundaries" aria-labelledby="boundaries-title">
      <div class="page-container boundaries-layout">
        <div class="boundaries-copy">
          <p class="eyebrow">Not sure where to start?</p>
          <h2 id="boundaries-title">
            Start with the problem, not the service name.
          </h2>
        </div>

        <div class="boundary-columns">
          <article>
            <h3>Use Support when</h3>
            <ul>
              <li>You need help with work already in progress</li>
              <li>
                You need to report a site, content, or accessibility issue
              </li>
              <li>You need help finding the right contact path</li>
            </ul>
          </article>

          <article>
            <h3>Use the Fit Check when</h3>
            <ul>
              <li>You have a new CX, AI, data, or workflow problem</li>
              <li>
                You are unsure whether a diagnostic is the right next step
              </li>
              <li>
                You want a clear answer about whether Cadence Lab can help
              </li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="support-close" aria-labelledby="support-close-title">
      <div class="page-container close-panel">
        <div>
          <p class="eyebrow">New problem</p>
          <h2 id="support-close-title">Tell me what is stuck.</h2>
        </div>
        <div class="close-action">
          <p>
            Share the problem, who it affects, and the outcome that needs to
            change. I will tell you whether a diagnostic makes sense.
          </p>
          <a class="button-primary" href="/fit-check/">Start a fit check</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .support-page {
    width: 100%;
    overflow: clip;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .page-container {
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
  }

  .support-hero,
  .support-routes,
  .active-project,
  .support-boundaries,
  .support-close {
    padding-block: var(--section-space);
  }

  .support-hero,
  .support-boundaries {
    background: var(--color-surface-subtle);
  }

  .hero-layout,
  .active-layout,
  .boundaries-layout,
  .close-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(20rem, 0.7fr);
    align-items: start;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .hero-layout,
  .close-panel {
    align-items: end;
  }

  .hero-copy,
  .section-stack,
  .section-intro,
  .active-intro,
  .boundaries-copy,
  .close-action {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-copy {
    gap: 1.25rem;
  }

  .section-stack {
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .section-intro,
  .active-intro,
  .boundaries-copy {
    gap: 1rem;
  }

  .eyebrow,
  .note-label,
  .context-number {
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    letter-spacing: var(--ls-eyebrow);
    font-feature-settings: var(--fea-eyebrow);
    text-transform: uppercase;
  }

  .eyebrow-inverse {
    color: var(--color-green);
  }

  h1,
  h2,
  h3,
  p,
  li,
  dt,
  dd,
  a {
    font-family: var(--font-sans);
    font-feature-settings: var(--fea-graphik);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  h1 {
    max-width: 15ch;
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  h2 {
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  h3 {
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: 1.35;
  }

  .hero-lead,
  .section-intro > p:last-child,
  .active-intro > p:last-child,
  .close-action p {
    max-width: 62ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .route-note {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: var(--border-width) solid var(--color-border);
    border-top: 0.1875rem solid var(--color-blue);
    border-radius: var(--radius-lg);
    background: var(--color-surface-pure);
  }

  .route-note > p:not(.note-label) {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--fs-body-ui);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
  }

  .route-note dl {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding-top: 1.25rem;
    border-top: var(--border-width) solid var(--color-border);
  }

  .route-note dl > div {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
  }

  .route-note dt {
    color: var(--color-blue);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }

  .route-note dd {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .support-routes,
  .support-close {
    border-top: var(--border-width) solid var(--color-border);
  }

  .section-intro {
    max-width: 52rem;
  }

  .section-intro h2 {
    max-width: 20ch;
  }

  .route-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: var(--border-width) solid var(--color-border);
  }

  .route-card {
    display: flex;
    min-width: 0;
    min-height: 21rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
  }

  .route-card:nth-child(odd) {
    border-inline-end: var(--border-width) solid var(--color-border);
  }

  .route-card:nth-child(n + 3) {
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .route-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
  }

  .route-meta span:first-child {
    color: var(--color-blue);
  }

  .route-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .route-copy h3 {
    max-width: 25ch;
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
  }

  .route-copy p {
    max-width: 58ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .route-card > a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    color: var(--color-blue);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    text-underline-offset: 0.25em;
  }

  .active-project {
    background: var(--color-ink);
    color: var(--color-text-inverse);
  }

  .active-intro {
    position: sticky;
    inset-block-start: calc(var(--header-offset) + 2rem);
  }

  .active-intro h2,
  .context-list h3 {
    color: var(--color-light);
  }

  .active-intro > p:last-child,
  .context-list li > div > p {
    color: var(--color-text-inverse-muted);
  }

  .context-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .context-list li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 1.5rem;
    border-top: var(--border-width) solid rgb(252 254 255 / 20%);
  }

  .context-list li:last-child {
    border-bottom: var(--border-width) solid rgb(252 254 255 / 20%);
  }

  .context-list li > div {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .context-list li > div > p {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .boundaries-copy h2 {
    max-width: 18ch;
  }

  .boundary-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface-pure);
  }

  .boundary-columns article {
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }

  .boundary-columns article + article {
    border-inline-start: var(--border-width) solid var(--color-border);
  }

  .boundary-columns h3 {
    padding-bottom: 1rem;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .boundary-columns ul {
    display: grid;
    gap: 0.85rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .boundary-columns li {
    position: relative;
    padding-inline-start: 1rem;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    line-height: 1.55;
  }

  .boundary-columns li::before {
    position: absolute;
    inset-block-start: 0.68em;
    inset-inline-start: 0;
    width: 0.35rem;
    height: 0.35rem;
    background: var(--color-blue);
    content: "";
  }

  .close-panel > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .close-action {
    gap: 1.5rem;
  }

  .button-primary {
    display: inline-flex;
    min-height: var(--control-min-size-coarse);
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.25rem;
    border: var(--border-width) solid var(--color-blue);
    border-radius: var(--radius-md);
    background: var(--color-blue);
    color: var(--color-light);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.2;
    text-decoration: none;
  }

  .button-primary:hover {
    border-color: var(--color-ink);
    background: var(--color-ink);
  }

  .support-page a:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  @media (hover: hover) {
    .route-card > a:hover {
      color: var(--color-ink);
    }
  }

  @media (max-width: 62rem) {
    .hero-layout,
    .active-layout,
    .boundaries-layout,
    .close-panel {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .route-note {
      max-width: 38rem;
    }

    .active-intro {
      position: static;
    }

    .boundaries-copy h2 {
      max-width: 24ch;
    }

    .close-panel {
      align-items: start;
    }

    .close-action {
      max-width: 44rem;
    }
  }

  @media (max-width: 44rem) {
    .route-grid,
    .boundary-columns {
      grid-template-columns: 1fr;
    }

    .route-card {
      min-height: auto;
    }

    .route-card:nth-child(odd) {
      border-inline-end: 0;
    }

    .route-card + .route-card {
      border-block-start: var(--border-width) solid var(--color-border);
    }

    .boundary-columns article + article {
      border-block-start: var(--border-width) solid var(--color-border);
      border-inline-start: 0;
    }
  }

  @media (forced-colors: active) {
    .route-note,
    .route-grid,
    .route-card,
    .context-list li,
    .boundary-columns,
    .boundary-columns article,
    .boundary-columns h3,
    .support-close {
      border-color: CanvasText;
    }
  }
</style>
