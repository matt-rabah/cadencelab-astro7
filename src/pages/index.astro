---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import NavHeader from "../components/NavHeader.astro";
import Hero from "../components/Hero.astro";
import Logos from "../components/Logos.astro";
import Stats from "../components/Stats.astro";
import OperatingModel from "../components/OperatingModel.astro";
import FAQ from "../components/FAQ.astro";
import FitCheckForm from "../components/FitCheckForm.astro";
import Footer from "../components/Footer.astro";

const operatingStages = [
  {
    step: "01",
    title: "Diagnose the operating environment",
    description:
      "Trace the customer problem through teams, systems, data, decisions, and frontline work before prescribing a solution.",
  },
  {
    step: "02",
    title: "Align the decisions",
    description:
      "Define the outcome, accountable owners, decision rights, constraints, and sequence of changes before implementation begins.",
  },
  {
    step: "03",
    title: "Rebuild the workflow",
    description:
      "Translate the decision into usable handoffs, CRM requirements, governance, team practices, and appropriate AI support.",
  },
  {
    step: "04",
    title: "Measure and adapt",
    description:
      "Connect customer, workflow, adoption, and performance signals to the change, then refine the system as evidence develops.",
  },
];

const fitBenefits = [
  "Customer friction materially affects retention, revenue, service quality, or team capacity.",
  "The problem spans functions, systems, or decision layers and cannot be solved by one team in isolation.",
  "Leadership can sponsor cross-functional decisions and assign accountable owners.",
  "The organization is willing to change workflows instead of placing new technology on top of a broken process.",
];
---

<Layout
  title="Cadence Lab | Customer experience operating systems for the AI era"
  description="Cadence Lab diagnoses onboarding drift, lifecycle risk, unreliable CRM workflows, and AI service readiness, then turns evidence into practical operating change."
  canonicalURL="/"
  pageType="website">
  <NavHeader />

  <main
    id="main-content"
    class="min-h-screen bg-background text-foreground"
    tabindex="-1">
    <Hero
      eyebrow="Customer Experience Operating Systems"
      heading="Customer experience operating systems for the AI era."
      description="Cadence Lab helps organizations resolve onboarding drift, quiet accounts, unreliable CRM signals, and service handoffs, then build the operating conditions required for responsible AI adoption."
      primaryCta={{ text: "Start a Fit Check™", url: "/fit-check/" }}
      secondaryCta={{ text: "Review diagnostic offers", url: "#diagnostics" }}
    />

    <Logos />

    <Stats
      eyebrow="Diagnostic Impact"
      heading="Choose the operating problem before choosing the technology"
      subheading="Each diagnostic starts with one consequential operating question, builds a shared evidence base, and ends with a practical decision."
    />

    <OperatingModel
      eyebrow="Operating Model"
      heading="Let the evidence determine the recommendation"
      subheading="Cadence Lab connects strategy to the way work is owned, performed, governed, and measured."
      steps={operatingStages}
    />

    <FAQ
      eyebrow="Frequently Asked Questions"
      heading="Clear answers about diagnostic engagements."
      description="Everything you need to know about scope, deliverables, and how Cadence Lab partners with your executive team."
    />

    <FitCheckForm
      badge="Fit Check™"
      heading="Decide whether the problem is ready for a diagnostic"
      description="Share the operating problem, the teams and systems involved, and the outcome that needs to change. Cadence Lab will assess fit directly."
      benefits={fitBenefits}
    />
  </main>

  <Footer />
</Layout>
