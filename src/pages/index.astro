---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import NavHeader from "../components/NavHeader.astro";
import Hero from "../components/Hero.astro";
import Logos from "../components/Logos.astro";
import Stats from "../components/Stats.astro";
import Evidence from "../components/Evidence.astro";
import OperatingModel from "../components/OperatingModel.astro";
import FAQ from "../components/FAQ.astro";
import FitCheckForm from "../components/FitCheckForm.astro";
import Footer from "../components/Footer.astro";

const operatingStages = [
  {
    step: "01",
    label: "Observation",
    title: "Find what's really happening",
    description:
      "Follow one customer problem through your teams, systems, data, and handoffs. Watch where it breaks.",
  },
  {
    step: "02",
    label: "Decision",
    title: "Agree on what has to change",
    description:
      "Name the outcome, the owner, and the order of work before anyone builds anything.",
  },
  {
    step: "03",
    label: "Owner",
    title: "Fix how the work gets done",
    description:
      "Put the decision into practice: cleaner hand-offs between teams, better CRM processes, new team habits, clear rules, and AI where it helps.",
  },
  {
    step: "04",
    label: "Measure",
    title: "Track what changes",
    description:
      "Measure what changed for customers, whether people use the new way of working, and how smoothly the work runs. Then adjust to what the data tells you.",
  },
];

const fitBenefits = [
  "A real person reviews the problem, the evidence, who owns it, and whether you can act on it.",
  "A short decision brief with the most likely cause and one useful next step.",
  "Advice you can keep, even when the answer is that you don't need a consultant yet.",
];
---

<Layout
  title="Customer Experience Systems for the AI Era | Cadence Lab"
  description="Customers repeat themselves. Onboarding stalls. Nobody trusts the CRM. Cadence Lab helps you find the cause, fix it in the right order, and get ready for AI."
  canonicalURL="/"
  pageType="website"
>
  <NavHeader />

  <main
    id="main-content"
    class="min-h-screen bg-background text-foreground"
    tabindex="-1"
  >
    <Hero
      eyebrow="CX without the BS."
      heading="Fix the systems behind customer friction."
      description="Your customers repeat themselves. New customers get stuck getting started. Your team works around tools nobody trusts. Sound familiar? I’m Matt, a customer experience consultant. I find what’s really causing problems like these and help you decide what to fix first, with clear owners and a plan you can use."
      primaryCta={{ text: "Start the FitCheck™", url: "/fit-check/" }}
      secondaryCta={{ text: "See how I can help", url: "#diagnostics" }}
    />

    <Logos />

    <Evidence
      heading="Teams think it's getting better. Customers don't."
      intro="That gap is where the work is. Most of it isn't a technology problem. It's what happens between teams, systems, and the moment a customer needs help."
      findings={[
        {
          figure: "66% vs 17%",
          text: "66% of customer experience professionals think experiences are getting better. Only 17% of consumers agree.",
        },
        {
          figure: "44%",
          text: "of customers had to give the same information more than once during their last interaction.",
        },
        {
          figure: "30–40%",
          text: "of departments don't act on customer experience recommendations. An insight nobody acts on is just a report.",
        },
        {
          figure: "7%",
          text: "of consumers forgive AI more than they forgive a person. Get the hand-over from AI to a person wrong and they'll notice.",
        },
      ]}
      source="Source: Medallia, The 2026 State of Customer Experience Report (552 CX practitioners, 1,522 consumers, and 600+ enterprise CX programs)."
    />

    <Stats
      heading="Start with the problem, not the platform."
      subheading="New software won’t fix work that falls between teams. Pick the problem that sounds like yours. Each one shows what it puts at risk and which of my four diagnostics (a fixed-scope review that finds the cause) fits it."
    />

    <OperatingModel
      eyebrow=""
      heading="Find the cause. Make the next move obvious."
      subheading="Strategy only matters when it changes how people work. So I start with the people, systems, and decisions behind your customer experience."
      steps={operatingStages}
    />

    <FAQ
      eyebrow=""
      heading="What to expect from a diagnostic."
      description="How long it takes, what I need from you, what you get, and what happens after. No surprises."
    />

    <FitCheckForm
      badge="FitCheck™ · Free decision brief"
      heading="Before you fund the solution, check the fit."
      description="Not sure where to start? Tell me what’s going on. I’ll read your answers myself and recommend the smallest useful next step. That might be a free resource, something your team can handle on its own, a diagnostic, or a conversation about implementation."
      benefits={fitBenefits}
    />
  </main>

  <Footer />
</Layout>
