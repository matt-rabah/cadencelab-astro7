---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import NavHeader from "../components/NavHeader.astro";
import Hero from "../components/Hero.astro";
import Logos from "../components/Logos.astro";
import Stats from "../components/Stats.astro";
import OperatingModel from "../components/OperatingModel.astro";
import FAQ from "../components/FAQ.astro";
import FitCheckForm from "../components/FitCheckForm.astro";
import Footer from "../components/Footer.astro";

const operatingStages = [
  {
    step: "01",
    title: "Find what's really happening",
    description:
      "Follow the customer problem through teams, systems, data, handoffs, and frontline work.",
  },
  {
    step: "02",
    title: "Agree on what needs to change",
    description:
      "Set the outcome, owner, boundaries, and order of work before implementation starts.",
  },
  {
    step: "03",
    title: "Fix the way work gets done",
    description:
      "Turn the decision into better handoffs, CRM workflows, team practices, governance, and AI support.",
  },
  {
    step: "04",
    title: "Track what changes",
    description:
      "Measure customer results, team adoption, and workflow performance. Then adjust based on what the data shows.",
  },
];

const fitBenefits = [
  "Customer friction is hurting retention, revenue, service quality, or team capacity.",
  "The problem crosses teams or systems, and one group cannot solve it alone.",
  "A leader can sponsor the work and assign clear owners.",
  "Your organization is willing to fix the workflow, not just add another tool.",
];
---

<Layout
  title="Customer Experience Systems for the AI Era | Cadence Lab"
  description="Cadence Lab helps organizations find and fix onboarding drift, quiet accounts, unreliable CRM workflows, service handoffs, and AI readiness problems."
  canonicalURL="/"
  pageType="website">
  <NavHeader />

  <main
    id="main-content"
    class="min-h-screen bg-background text-foreground"
    tabindex="-1">
    <Hero
      eyebrow="CX without the BS."
      heading="Fix the systems behind customer friction."
      description="Cadence Lab helps you find the real cause of onboarding drift, quiet accounts, broken CRM signals, and AI service workflows that aren’t ready for real use. You’ll know what to fix first and why."
      primaryCta={{ text: "Start the Fit Check™", url: "/fit-check/" }}
      secondaryCta={{ text: "See the diagnostic offers", url: "#diagnostics" }}
    />

    <Logos />

    <Stats
      eyebrow="Diagnostic Services"
      heading="Start with the problem, not the platform."
      subheading="Each diagnostic answers one important question: What is causing the problem, and what should your team fix first?"
    />

    <OperatingModel
      eyebrow="How the Work Happens"
      heading="Find the cause. Make the next move clear."
      subheading="We connect strategy to the people, systems, and decisions that shape the customer experience."
      steps={operatingStages}
    />

    <FAQ
      eyebrow="Common Questions"
      heading="What to expect from a diagnostic"
      description="Clear answers about timing, access, deliverables, and what happens after the review."
    />

    <FitCheckForm
      badge="Fit Check™"
      heading="Is this the right problem to solve together?"
      description="Tell me what’s getting in the customer’s way, which teams and systems are involved, and what needs to change. I’ll review it and tell you plainly whether Cadence Lab can help."
      benefits={fitBenefits}
    />
  </main>

  <Footer />
</Layout>
