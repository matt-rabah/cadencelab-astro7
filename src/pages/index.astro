---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import NavHeader from "../components/NavHeader.astro";
import Hero from "../components/Hero.astro";
import Logos from "../components/Logos.astro";
import Stats from "../components/Stats.astro";
import OperatingModel from "../components/OperatingModel.astro";
import FAQ from "../components/FAQ.astro";
import FitCheckForm from "../components/FitCheckForm.astro";
import Footer from "../components/Footer.astro";

const operatingStages = [
  {
    step: "01",
    title: "Find what's really happening",
    description:
      "Follow one customer problem through your teams, systems, data, and handoffs. Watch where it breaks.",
  },
  {
    step: "02",
    title: "Agree on what has to change",
    description:
      "Name the outcome, the owner, and the order of work before anyone builds anything.",
  },
  {
    step: "03",
    title: "Fix how the work gets done",
    description:
      "Turn that decision into better handoffs, CRM workflows, team habits, governance, and AI support.",
  },
  {
    step: "04",
    title: "Track what changes",
    description:
      "Measure customer results, adoption, and workflow performance. Then adjust to what the data tells you.",
  },
];

const fitBenefits = [
  "A real person reviews the problem, the evidence, who owns it, and whether you can act on it.",
  "A short decision brief with the likely constraint and one useful next step.",
  "Advice you can keep, even when the answer is that you don't need a consultant yet.",
];
---

<Layout
  title="Customer Experience Systems for the AI Era | Cadence Lab"
  description="Customers repeat themselves. Onboarding stalls. Nobody trusts the CRM. Cadence Lab helps you find the cause, fix it in the right order, and get ready for AI."
  canonicalURL="/"
  pageType="website"
>
  <NavHeader />

  <main
    id="main-content"
    class="min-h-screen bg-background text-foreground"
    tabindex="-1"
  >
    <Hero
      eyebrow="CX without the BS."
      heading="Fix the systems behind customer friction."
      description="Your customers repeat themselves. Onboarding stalls. Your team works around tools nobody trusts. Sound familiar? I’ll help you find what’s really causing it and decide what to fix first, with real owners and a plan you can use."
      primaryCta={{ text: "Start the Fit Check™", url: "/fit-check/" }}
      secondaryCta={{ text: "See the diagnostic offers", url: "#diagnostics" }}
    />

    <Logos />

    <Stats
      eyebrow="Diagnostic Services"
      heading="Start with the problem, not the platform."
      subheading="New software won’t fix a broken handoff. Each diagnostic answers two questions: what’s really causing the problem, and what should you fix first?"
    />

    <OperatingModel
      eyebrow="How the work happens"
      heading="Find the cause. Make the next move obvious."
      subheading="Strategy only matters when it changes how people work. So I start with the people, systems, and decisions behind your customer experience."
      steps={operatingStages}
    />

    <FAQ
      eyebrow="Common questions"
      heading="What to expect from a diagnostic."
      description="Timing, access, deliverables, and what happens after. No surprises."
    />

    <FitCheckForm
      badge="FitCheck™ · Free decision brief"
      heading="Before you fund the solution, check the fit."
      description="Not sure where to start? Tell me what’s going on. I’ll read your answers myself and recommend the smallest useful next step. That might be a free resource, something your team can handle on its own, a diagnostic, or a conversation about implementation."
      benefits={fitBenefits}
    />
  </main>

  <Footer />
</Layout>
