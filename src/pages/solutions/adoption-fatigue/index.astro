---
import BreadcrumbSchema from "../../../components/BreadcrumbSchema.astro";
import Footer from "../../../components/Footer.astro";
import NavHeader from "../../../components/NavHeader.astro";
import SectionNav from "../../../components/SectionNav.astro";
import Layout from "../../../layouts/Layout.astro";

const visibleSignals = [
  {
    number: "01",
    title: "Checking takes longer than the task",
    description:
      "People reopen records, verify policy, and rewrite the output before they trust it.",
  },
  {
    number: "02",
    title: "The workaround becomes the real workflow",
    description:
      "Spreadsheets, messages, and the old system still carry the work that matters.",
  },
  {
    number: "03",
    title: "Usage looks healthy, but trust is low",
    description:
      "People complete the required steps, then confirm the answer somewhere else.",
  },
  {
    number: "04",
    title: "Every exception finds the same expert",
    description:
      "Experienced people absorb the hard cases because the workflow can't explain, route, or recover from them.",
  },
];

const operatingCauses = [
  {
    label: "Workflow",
    question: "Did the new path remove work or add a layer?",
    description:
      "A tool can automate one step while leaving duplicate entry, extra checks, and exceptions for the user.",
  },
  {
    label: "Inputs",
    question: "Can people trust what the answer is based on?",
    description:
      "Missing records, stale knowledge, and conflicting rules make verification part of the job.",
  },
  {
    label: "Control",
    question: "Can the user correct, reject, or stop the work?",
    description:
      "Trust falls when people own the outcome but can't change the system's response.",
  },
  {
    label: "Risk",
    question: "What happens when the system is wrong?",
    description:
      "People will slow down when they carry the cost of customer harm, rework, or compliance failure.",
  },
];

const evidenceSources = [
  {
    title: "Watch the real task",
    description:
      "See which systems, checks, and workarounds people use on a normal day and under pressure.",
  },
  {
    title: "Count review and rework",
    description:
      "Track time spent checking output, reopening sources, correcting answers, and repeating work.",
  },
  {
    title: "Study bypasses and exceptions",
    description:
      "Find where people leave the intended path, who handles the hard cases, and why the alternative feels safer.",
  },
  {
    title: "Connect behavior to outcomes",
    description:
      "Compare usage with quality, completion time, repeat contact, errors, escalation, and customer impact.",
  },
];

const responseSequence = [
  {
    phase: "Observe",
    question: "See the work around the workflow.",
    evidence:
      "Follow real tasks, including checks, workarounds, exceptions, and outcomes.",
  },
  {
    phase: "Diagnose",
    question: "Name the source of the friction.",
    evidence:
      "Separate a skill gap from a problem with workflow, data, control, risk, or use-case fit.",
  },
  {
    phase: "Repair",
    question: "Fix the smallest useful constraint.",
    evidence:
      "Change the task boundary, input, handoff, control, review step, or recovery path.",
  },
  {
    phase: "Test",
    question: "Prove the work got better.",
    evidence:
      "Test with real cases and compare review, bypass, quality, speed, trust, and customer impact.",
  },
];

const diagnosticPaths = [
  {
    title: "AI Service Readiness Review",
    href: "/services/ai-service-readiness-review/",
    useWhen:
      "Use this when an AI workflow still lacks clear oversight, guardrails, trust, or success measures.",
  },
  {
    title: "CRM Workflow Audit",
    href: "/services/crm-workflow-audit/",
    useWhen:
      "Use this when teams route around CRM data, automation, reporting, or configured workflows.",
  },
  {
    title: "CX Systems Diagnostic",
    href: "/services/cx-systems-diagnostic/",
    useWhen:
      "Use this when friction crosses customer journeys, handoffs, ownership, systems, and teams.",
  },
];

const strongFit = [
  "Usage is acceptable, but checking, correction, rework, or bypass is rising.",
  "Employees are called resistant, but no one has studied the work behind that behavior.",
  "Adoption activity has increased without a clear gain in customer or business outcomes.",
  "A sponsor can change the workflow, not just require more use.",
];
---

<Layout
  title="User Adoption Fatigue | Cadence Lab"
  description="Find out why people verify, correct, or bypass a workflow. Fix the work before asking for more adoption."
  canonicalURL="/solutions/adoption-fatigue/"
  pageType="website">
  <NavHeader />
  <BreadcrumbSchema currentName="User adoption fatigue" />

  <main id="main-content" class="adoption-page" tabindex="-1">
    <section class="adoption-hero" aria-labelledby="adoption-title">
      <div class="page-container hero-layout">
        <div class="hero-copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              <li aria-current="page">User adoption fatigue</li>
            </ol>
          </nav>

          <p class="eyebrow">Solution · User adoption fatigue</p>
          <h1 id="adoption-title">
            The new tool saves two minutes. Then it adds ten minutes of
            checking.
          </h1>
          <p class="hero-lead">
            That's not simple resistance. It's a sign that the workflow moved
            effort or risk onto the people using it. Find that friction, fix it,
            and give adoption a reason to grow.
          </p>

          <div class="hero-actions" aria-label="User adoption fatigue actions">
            <a class="button button-primary" href="/fit-check/">
              Start a fit check
            </a>
            <a class="button button-text" href="#signals">
              Review the signals
              <span aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </div>

        <aside class="problem-card" aria-labelledby="problem-title">
          <p id="problem-title" class="note-label">Recognizable pattern</p>
          <p>
            The launch is complete. Training is done. Usage looks fine. Yet
            people still check every answer, keep a backup spreadsheet, or
            return to the old process when the stakes rise.
          </p>
          <dl>
            <div>
              <dt>Visible label</dt>
              <dd>Resistance or change fatigue</dd>
            </div>
            <div>
              <dt>Operating question</dt>
              <dd>What work or risk did the change leave behind?</dd>
            </div>
            <div>
              <dt>Decision</dt>
              <dd>Repair, narrow, support, or stop the workflow</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <SectionNav
      items={[
        { label: "Problem", href: "#problem" },
        { label: "Signals", href: "#signals" },
        { label: "Operating causes", href: "#operating-causes" },
        { label: "Evidence", href: "#evidence" },
        { label: "Response", href: "#response" },
        { label: "Diagnostic paths", href: "#diagnostic-paths" },
        { label: "Fit", href: "#fit" },
      ]}
    />

    <section
      id="problem"
      class="problem section-block"
      aria-labelledby="problem-heading">
      <div class="page-container problem-layout">
        <div>
          <p class="eyebrow">The problem</p>
          <h2 id="problem-heading">
            People work around systems that make good work harder.
          </h2>
        </div>

        <div class="problem-copy">
          <p>
            A system can work as designed and still make the job slower or less
            clear. People add checks and workarounds to protect the customer and
            the outcome they still own.
          </p>
          <p>
            More training won't fix weak data, unclear rules, brittle
            automation, or a poorly chosen use case. First, learn which problem
            you have.
          </p>
        </div>
      </div>
    </section>

    <section id="signals" class="signals" aria-labelledby="signals-title">
      <div class="page-container section-stack">
        <div class="section-intro section-intro-inverse">
          <p class="eyebrow eyebrow-inverse">Visible signals</p>
          <h2 id="signals-title">Usage can hide the real cost.</h2>
          <p>A login proves access. It doesn't prove the workflow helps.</p>
        </div>

        <ol class="signal-grid">
          {
            visibleSignals.map((signal) => (
              <li>
                <p class="item-number">{signal.number}</p>
                <h3>{signal.title}</h3>
                <p>{signal.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      id="operating-causes"
      class="operating-causes section-block"
      aria-labelledby="causes-title">
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Operating causes</p>
            <h2 id="causes-title">
              Find the friction before you prescribe training.
            </h2>
          </div>
          <p>
            Training helps when people lack skill or practice. It can't repair a
            workflow that asks them to compensate for bad inputs, weak controls,
            or unmanaged risk.
          </p>
        </div>

        <div class="cause-list">
          {
            operatingCauses.map((cause, index) => (
              <article>
                <div class="cause-heading">
                  <p class="item-number">
                    {String(index + 1).padStart(2, "0")}
                  </p>
                  <p class="cause-label">{cause.label}</p>
                </div>
                <h3>{cause.question}</h3>
                <p>{cause.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="evidence"
      class="evidence section-block"
      aria-labelledby="evidence-title">
      <div class="page-container evidence-layout">
        <div class="evidence-intro">
          <p class="eyebrow">Evidence</p>
          <h2 id="evidence-title">Measure what happens after the click.</h2>
          <p>
            Review the full task, not just activity inside the tool. The goal is
            to understand friction and risk, not punish people for finding a
            safer path.
          </p>
          <div class="evidence-principle">
            <p class="note-label">Evidence principle</p>
            <p>
              Compare the intended workflow with the real one. Keep observed
              facts separate from opinions and assumptions.
            </p>
          </div>
        </div>

        <div class="evidence-grid">
          {
            evidenceSources.map((source, index) => (
              <article>
                <p class="item-number">{String(index + 1).padStart(2, "0")}</p>
                <h3>{source.title}</h3>
                <p>{source.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="response" class="response" aria-labelledby="response-title">
      <div class="page-container section-stack">
        <div class="section-intro section-intro-inverse">
          <p class="eyebrow eyebrow-inverse">Practical response</p>
          <h2 id="response-title">
            Fix the work. Then ask people to adopt it.
          </h2>
          <p>
            Start small, use real cases, and expand only when the evidence says
            the workflow is better.
          </p>
        </div>

        <ol class="response-list">
          {
            responseSequence.map((stage, index) => (
              <li>
                <div class="response-heading">
                  <p class="response-number">
                    {String(index + 1).padStart(2, "0")}
                  </p>
                  <p class="response-phase">{stage.phase}</p>
                </div>
                <h3>{stage.question}</h3>
                <p>{stage.evidence}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      id="diagnostic-paths"
      class="diagnostic-paths section-block"
      aria-labelledby="paths-title">
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Diagnostic paths</p>
            <h2 id="paths-title">
              Start with the problem underneath the behavior.
            </h2>
          </div>
          <p>
            Adoption fatigue is a symptom. The right diagnostic depends on
            whether the constraint sits in AI, CRM, or the broader customer
            operating system.
          </p>
        </div>

        <div class="path-grid">
          {
            diagnosticPaths.map((path, index) => (
              <article>
                <p class="item-number">{String(index + 1).padStart(2, "0")}</p>
                <h3>{path.title}</h3>
                <p>{path.useWhen}</p>
                <a href={path.href}>
                  Review the diagnostic
                  <span aria-hidden="true">&#8594;</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="fit" class="fit" aria-labelledby="fit-title">
      <div class="page-container fit-layout">
        <div class="fit-copy">
          <p class="eyebrow">Fit</p>
          <h2 id="fit-title">
            Use this path when the workflow, not willingness, may be the
            problem.
          </h2>
          <p>
            This work helps when leaders can change the conditions around the
            job. It isn't a compliance campaign or a way to defend a tool that
            has already been chosen.
          </p>

          <a class="button button-primary" href="/fit-check/">
            Start a fit check
          </a>
        </div>

        <aside class="fit-list" aria-labelledby="fit-list-title">
          <p id="fit-list-title" class="note-label">Strong fit</p>
          <ul>
            {strongFit.map((condition) => <li>{condition}</li>)}
          </ul>
        </aside>
      </div>
    </section>

    <section class="related-insight" aria-labelledby="insight-title">
      <div class="page-container insight-layout">
        <div>
          <p class="eyebrow">Related insight</p>
          <h2 id="insight-title">
            When AI creates more work for the people using it
          </h2>
        </div>
        <div>
          <p>
            See how review burden, workarounds, and low trust can turn AI into
            more work.
          </p>
          <a href="/blog/2026/06/adoption-fatigue/">
            Read the article
            <span aria-hidden="true">&#8594;</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .adoption-page {
    width: 100%;
    overflow: clip;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .page-container {
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
  }

  .section-block {
    padding-block: var(--section-space);
  }

  .adoption-hero {
    padding-block: var(--section-space);
    border-bottom: var(--border-width) solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(19rem, 0.65fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .hero-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumb li {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .breadcrumb li + li::before {
    margin-inline-end: 0.5rem;
    color: var(--color-border-strong);
    content: "/";
  }

  .breadcrumb a {
    color: var(--color-blue);
    text-underline-offset: 0.25em;
  }

  .eyebrow,
  .note-label,
  .item-number,
  .cause-label,
  .response-number,
  .response-phase {
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    letter-spacing: var(--ls-eyebrow);
    font-feature-settings: var(--fea-eyebrow);
    text-transform: uppercase;
  }

  .eyebrow-inverse {
    color: var(--color-green);
  }

  h1,
  h2,
  h3,
  p,
  li,
  a,
  dt,
  dd {
    font-family: var(--font-sans);
    font-feature-settings: var(--fea-graphik);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  h1 {
    max-width: 18ch;
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  .hero-lead {
    max-width: 64ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .button {
    display: inline-flex;
    min-height: var(--control-min-size);
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.75rem 1rem;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    text-decoration: none;
  }

  .button-primary {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-light);
  }

  .button-text {
    color: var(--color-blue);
  }

  .problem-card {
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: var(--border-width) solid var(--color-border);
    border-top: 0.1875rem solid var(--color-blue);
    border-radius: var(--radius-lg);
    background: var(--color-surface-pure);
  }

  .problem-card > p:not(.note-label) {
    margin: 1rem 0 0;
    color: var(--color-ink);
    font-size: var(--fs-body-ui);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .problem-card dl {
    display: grid;
    margin: 1.5rem 0 0;
  }

  .problem-card dl > div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.9rem;
    border-top: var(--border-width) solid var(--color-border);
  }

  .problem-card dt,
  .problem-card dd {
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .problem-card dt {
    color: var(--color-text-muted);
  }

  .problem-card dd {
    margin: 0;
    color: var(--color-ink);
    font-weight: var(--fw-medium);
  }

  .problem-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .problem-layout h2,
  .section-intro h2,
  .evidence-intro h2,
  .fit-copy h2,
  .related-insight h2 {
    max-width: 20ch;
    margin-top: 0.75rem;
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  .problem-copy {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .problem-copy p,
  .section-intro > p:not(.eyebrow),
  .evidence-intro > p:not(.eyebrow),
  .fit-copy > p:not(.eyebrow) {
    max-width: var(--measure-ui);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .section-stack {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  .section-intro {
    display: flex;
    max-width: 52rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .section-intro h2 {
    margin-top: -0.5rem;
  }

  .section-intro-inverse h2 {
    color: var(--color-light);
  }

  .section-intro-inverse > p:not(.eyebrow) {
    color: var(--color-text-inverse-muted);
  }

  .section-intro-split {
    display: grid;
    max-width: none;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .section-intro-split > p {
    align-self: end;
  }

  .signals,
  .response {
    padding-block: var(--section-space);
    background: var(--color-ink);
    color: var(--color-light);
  }

  .signal-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: var(--border-width) solid rgb(252 254 255 / 22%);
    border-inline-start: var(--border-width) solid rgb(252 254 255 / 22%);
    list-style: none;
  }

  .signal-grid li {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2rem);
    border-inline-end: var(--border-width) solid rgb(252 254 255 / 22%);
    border-bottom: var(--border-width) solid rgb(252 254 255 / 22%);
  }

  .signal-grid .item-number {
    color: var(--color-green);
  }

  .signal-grid h3 {
    margin-top: 1.5rem;
    color: var(--color-light);
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: 1.35;
  }

  .signal-grid li > p:last-child {
    margin: 0.75rem 0 0;
    color: var(--color-text-inverse-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .cause-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: var(--border-width) solid var(--color-border);
    border-inline-start: var(--border-width) solid var(--color-border);
  }

  .cause-list article {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2rem);
    border-inline-end: var(--border-width) solid var(--color-border);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .cause-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .cause-list h3 {
    max-width: 31ch;
    margin-top: 1.75rem;
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: 1.35;
  }

  .cause-list article > p:last-child {
    max-width: var(--measure-ui);
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .evidence {
    border-top: var(--border-width) solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .evidence-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .evidence-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .evidence-intro h2 {
    margin-top: -0.5rem;
  }

  .evidence-principle {
    margin-top: 1rem;
    padding: 1.25rem;
    border-inline-start: 0.1875rem solid var(--color-blue);
    background: var(--color-surface-pure);
  }

  .evidence-principle > p:last-child {
    margin: 0.65rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: var(--border-width) solid var(--color-border);
