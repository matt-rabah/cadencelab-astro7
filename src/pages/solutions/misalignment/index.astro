---
import BreadcrumbSchema from "../../../components/BreadcrumbSchema.astro";
import Footer from "../../../components/Footer.astro";
import NavHeader from "../../../components/NavHeader.astro";
import SectionNav from "../../../components/SectionNav.astro";
import Layout from "../../../layouts/Layout.astro";

const visibleSignals = [
  {
    number: "01",
    title: "The words match, but the decisions don't",
    description:
      "Leaders repeat the same strategy while choosing different outcomes, priorities, and owners.",
  },
  {
    number: "02",
    title: "The roadmap grows because nothing gets ruled out",
    description:
      "Projects and platforms pile up because every priority survives the meeting.",
  },
  {
    number: "03",
    title: "More people join, but no one can decide",
    description:
      "Committees get larger while authority to resolve tradeoffs stays unclear.",
  },
  {
    number: "04",
    title: "Technology becomes the decision",
    description:
      "A platform or AI initiative moves ahead before leaders agree on the work it should improve.",
  },
];

const alignmentConditions = [
  {
    label: "Outcome",
    question: "What needs to be different when this works?",
    description:
      "Define a result that connects customer impact, operating performance, and business value.",
  },
  {
    label: "Scope",
    question: "What are we solving, and what are we not solving?",
    description:
      "A real boundary keeps every local concern from becoming part of one endless program.",
  },
  {
    label: "Authority",
    question: "Who can make the call and own the result?",
    description:
      "Participation isn't ownership. One sponsor must be able to close the decision and accept its tradeoffs.",
  },
  {
    label: "Evidence",
    question: "Which facts will guide the choice?",
    description:
      "Separate customer and operating facts from assumptions, interpretation, and advocacy.",
  },
  {
    label: "Boundaries",
    question: "What stays consistent, and what may adapt?",
    description:
      "Define the shared outcome and safeguards, then allow local choices where customers, markets, or risks differ.",
  },
];

const decisionPath = [
  {
    phase: "Frame",
    question: "Name the decision, not the initiative.",
    evidence:
      "State the customer impact, operating effect, urgency, and accountable sponsor.",
  },
  {
    phase: "Choose",
    question: "Pick the outcome and accept the tradeoffs.",
    evidence:
      "Record the criteria, chosen direction, rejected options, constraints, and resources.",
  },
  {
    phase: "Commit",
    question: "Turn the choice into owned work.",
    evidence:
      "Assign decision rights, handoffs, dependencies, support, escalation, and the first change.",
  },
  {
    phase: "Review",
    question: "Decide what could change the direction.",
    evidence:
      "Set customer, workflow, performance, and risk measures with a clear review point.",
  },
];

const evidenceSources = [
  {
    title: "Customer and business consequence",
    description:
      "What customers experience, what the business loses, and which result leaders expect to improve.",
  },
  {
    title: "The real workflow",
    description:
      "How work moves through teams, systems, handoffs, exceptions, and recovery outside the slide deck.",
  },
  {
    title: "Authority and constraints",
    description:
      "Who can decide, which limits shape the choice, and where formal titles differ from practical control.",
  },
  {
    title: "Measures and decision history",
    description:
      "How teams define success, which choices were delayed or reversed, and why earlier efforts stalled.",
  },
];

const alignmentOutputs = [
  {
    number: "01",
    title: "Shared decision brief",
    description:
      "The problem, outcome, scope, evidence, constraints, uncertainty, and decision owner in plain language.",
  },
  {
    number: "02",
    title: "Decision record",
    description:
      "What was chosen, what was rejected, which tradeoffs were accepted, and what could reopen the choice.",
  },
  {
    number: "03",
    title: "Decision-rights map",
    description:
      "Who decides, who contributes, who acts, where work crosses boundaries, and how issues escalate.",
  },
  {
    number: "04",
    title: "First operating sequence",
    description:
      "The smallest useful order of workflow, ownership, data, and technology changes with a review point.",
  },
];

const diagnosticPaths = [
  {
    title: "CX Systems Diagnostic",
    href: "/services/cx-systems-diagnostic/",
    useWhen:
      "Use this when leaders disagree about the cause, ownership, or first fix for customer friction.",
  },
  {
    title: "AI Service Readiness Review",
    href: "/services/ai-service-readiness-review/",
    useWhen:
      "Use this when leaders support AI but haven't aligned on workflow, oversight, risk, or success.",
  },
  {
    title: "CRM Workflow Audit",
    href: "/services/crm-workflow-audit/",
    useWhen:
      "Use this when teams disagree about what the CRM should enable or which signals they can trust.",
  },
];

const strongFit = [
  "A cross-functional initiative has momentum but no stable operating decision.",
  "Leaders agree on the ambition but not the outcome, scope, evidence, or owner.",
  "A sponsor can resolve tradeoffs and change work across teams.",
  "Leaders will narrow, pause, or redirect the initiative when evidence supports it.",
];
---

<Layout
  title="Executive Misalignment | Cadence Lab"
  description="Turn competing executive priorities into a clear decision, accountable ownership, and a practical operating sequence."
  canonicalURL="/solutions/misalignment/"
  pageType="website">
  <NavHeader />
  <BreadcrumbSchema currentName="Executive misalignment" />

  <main id="main-content" class="alignment-page" tabindex="-1">
    <section class="alignment-hero" aria-labelledby="alignment-title">
      <div class="page-container hero-layout">
        <div class="hero-copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              <li aria-current="page">Executive misalignment</li>
            </ol>
          </nav>

          <p class="eyebrow">Solution · Executive misalignment</p>
          <h1 id="alignment-title">
            If everyone agrees, why is every team doing something different?
          </h1>
          <p class="hero-lead">
            Shared language isn't the same as a shared decision. Name the
            outcome, boundaries, evidence, owner, and tradeoffs before another
            roadmap turns disagreement into more work.
          </p>

          <div class="hero-actions" aria-label="Executive alignment actions">
            <a
              class="button button-primary"
              href="/services/cx-systems-diagnostic/">
              Review the CX Systems Diagnostic
            </a>
            <a class="button button-text" href="/fit-check/">
              Start a fit check
              <span aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </div>

        <aside class="problem-card" aria-labelledby="problem-title">
          <p id="problem-title" class="note-label">Recognizable pattern</p>
          <p>
            Every leader supports the transformation. Each function is still
            solving a different problem and protecting a different definition of
            success.
          </p>
          <dl>
            <div>
              <dt>Visible label</dt>
              <dd>Alignment or sponsorship problem</dd>
            </div>
            <div>
              <dt>Operating question</dt>
              <dd>Which decision is leadership avoiding?</dd>
            </div>
            <div>
              <dt>Decision</dt>
              <dd>What leads, who owns it, and what happens first</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <SectionNav
      items={[
        { label: "Problem", href: "#problem" },
        { label: "Signals", href: "#signals" },
        { label: "Conditions", href: "#conditions" },
        { label: "Decision path", href: "#decision-path" },
        { label: "Evidence", href: "#evidence" },
        { label: "Outputs", href: "#outputs" },
        { label: "Diagnostic paths", href: "#diagnostic-paths" },
        { label: "Fit", href: "#fit" },
      ]}
    />

    <section
      id="problem"
      class="problem section-block"
      aria-labelledby="problem-heading">
      <div class="page-container problem-layout">
        <div>
          <p class="eyebrow">The problem</p>
          <h2 id="problem-heading">
            Agreement is easy. A decision has tradeoffs.
          </h2>
        </div>

        <div class="problem-copy">
          <p>
            Leaders don't need the same perspective. They need a clear way to
            choose an outcome, accept constraints, assign authority, and decide
            what happens first.
          </p>
          <p>
            Without that choice, every priority survives. Teams optimize their
            part, technology carries the unanswered questions, and activity
            looks like progress.
          </p>
        </div>
      </div>
    </section>

    <section id="signals" class="signals" aria-labelledby="signals-title">
      <div class="page-container section-stack">
        <div class="section-intro section-intro-inverse">
          <p class="eyebrow eyebrow-inverse">Visible signals</p>
          <h2 id="signals-title">Look for agreement that changes nothing.</h2>
          <p>Support only matters when it guides choices across teams.</p>
        </div>

        <ol class="signal-grid">
          {
            visibleSignals.map((signal) => (
              <li>
                <p class="item-number">{signal.number}</p>
                <h3>{signal.title}</h3>
                <p>{signal.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      id="conditions"
      class="conditions section-block"
      aria-labelledby="conditions-title">
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Alignment conditions</p>
            <h2 id="conditions-title">
              Decide what the enterprise shares and what teams can adapt.
            </h2>
          </div>
          <p>
            Stop debating the initiative in the abstract. Decide the conditions
            that will govern real work across the enterprise.
          </p>
        </div>

        <div class="condition-list">
          {
            alignmentConditions.map((condition, index) => (
              <article>
                <div class="condition-heading">
                  <p class="item-number">
                    {String(index + 1).padStart(2, "0")}
                  </p>
                  <p class="condition-label">{condition.label}</p>
                </div>
                <h3>{condition.question}</h3>
                <p>{condition.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="decision-path"
      class="decision-path"
      aria-labelledby="decision-path-title">
      <div class="page-container section-stack">
        <div class="section-intro section-intro-inverse">
          <p class="eyebrow eyebrow-inverse">Decision path</p>
          <h2 id="decision-path-title">
            Turn different views into one accountable choice.
          </h2>
          <p>
            Keep disagreement visible, then make the tradeoffs clear enough for
            people to act.
          </p>
        </div>

        <ol class="path-list">
          {
            decisionPath.map((stage, index) => (
              <li>
                <div class="path-heading">
                  <p class="path-number">
                    {String(index + 1).padStart(2, "0")}
                  </p>
                  <p class="path-phase">{stage.phase}</p>
                </div>
                <h3>{stage.question}</h3>
                <p>{stage.evidence}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      id="evidence"
      class="evidence section-block"
      aria-labelledby="evidence-title">
      <div class="page-container evidence-layout">
        <div class="evidence-intro">
          <p class="eyebrow">Evidence</p>
          <h2 id="evidence-title">
            Build one account of the problem before choosing the fix.
          </h2>
          <p>
            Bring customer, operating, commercial, and technical facts together
            without letting one function define the whole problem.
          </p>
          <div class="evidence-principle">
            <p class="note-label">Evidence principle</p>
            <p>
              Keep facts, interpretations, assumptions, and advocacy separate.
              Say where the evidence is weak.
            </p>
          </div>
        </div>

        <div class="evidence-grid">
          {
            evidenceSources.map((source, index) => (
              <article>
                <p class="item-number">{String(index + 1).padStart(2, "0")}</p>
                <h3>{source.title}</h3>
                <p>{source.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="outputs"
      class="outputs section-block"
      aria-labelledby="outputs-title">
      <div class="page-container output-layout">
        <div class="output-intro">
          <p class="eyebrow">Practical outputs</p>
          <h2 id="outputs-title">Leave with decisions people can use.</h2>
          <p>
            Make the direction, tradeoffs, ownership, and review conditions
            clear after the meeting ends.
          </p>
        </div>

        <ol class="output-list">
          {
            alignmentOutputs.map((output) => (
              <li>
                <p class="item-number">{output.number}</p>
                <div>
                  <h3>{output.title}</h3>
                  <p>{output.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      id="diagnostic-paths"
      class="diagnostic-paths section-block"
      aria-labelledby="paths-title">
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Diagnostic paths</p>
            <h2 id="paths-title">
              Start with the decision leaders can't close.
            </h2>
          </div>
          <p>
            The right diagnostic depends on whether the disagreement is about
            the customer system, an AI use case, or CRM workflow.
          </p>
        </div>

        <div class="diagnostic-grid">
          {
            diagnosticPaths.map((path, index) => (
              <article>
                <p class="item-number">{String(index + 1).padStart(2, "0")}</p>
                <h3>{path.title}</h3>
                <p>{path.useWhen}</p>
                <a href={path.href}>
                  Review the diagnostic
                  <span aria-hidden="true">&#8594;</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="fit" class="fit" aria-labelledby="fit-title">
      <div class="page-container fit-layout">
        <div class="fit-copy">
          <p class="eyebrow">Fit</p>
          <h2 id="fit-title">
            Use this path when leadership can make the decision, not just
            discuss it.
          </h2>
          <p>
            This work helps when a sponsor can resolve tradeoffs and change work
            across teams. It isn't facilitation for a decision that has already
            been made or a substitute for real authority.
          </p>

          <a class="button button-primary" href="/fit-check/">
            Start a fit check
          </a>
        </div>

        <aside class="fit-list" aria-labelledby="fit-list-title">
          <p id="fit-list-title" class="note-label">Strong fit</p>
          <ul>
            {strongFit.map((condition) => <li>{condition}</li>)}
          </ul>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .alignment-page {
    width: 100%;
    overflow: clip;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .page-container {
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
  }

  .section-block {
    padding-block: var(--section-space);
  }

  .alignment-hero {
    padding-block: var(--section-space);
    border-bottom: var(--border-width) solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(19rem, 0.65fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .hero-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumb li {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .breadcrumb li + li::before {
    margin-inline-end: 0.5rem;
    color: var(--color-border-strong);
    content: "/";
  }

  .breadcrumb a {
    color: var(--color-blue);
    text-underline-offset: 0.25em;
  }

  .eyebrow,
  .note-label,
  .item-number,
  .condition-label,
  .path-number,
  .path-phase {
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    letter-spacing: var(--ls-eyebrow);
    font-feature-settings: var(--fea-eyebrow);
    text-transform: uppercase;
  }

  .eyebrow-inverse {
    color: var(--color-green);
  }

  h1,
  h2,
  h3,
  p,
  li,
  a,
  dt,
  dd {
    font-family: var(--font-sans);
    font-feature-settings: var(--fea-graphik);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  h1 {
    max-width: 17ch;
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  .hero-lead {
    max-width: 64ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .button {
    display: inline-flex;
    min-height: var(--control-min-size);
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.75rem 1rem;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    text-decoration: none;
  }

  .button-primary {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-light);
  }

  .button-text {
    color: var(--color-blue);
  }

  .problem-card {
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: var(--border-width) solid var(--color-border);
    border-top: 0.1875rem solid var(--color-blue);
    border-radius: var(--radius-lg);
    background: var(--color-surface-pure);
  }

  .problem-card > p:not(.note-label) {
    margin: 1rem 0 0;
    color: var(--color-ink);
    font-size: var(--fs-body-ui);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .problem-card dl {
    display: grid;
    margin: 1.5rem 0 0;
  }

  .problem-card dl > div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.9rem;
    border-top: var(--border-width) solid var(--color-border);
  }

  .problem-card dt,
  .problem-card dd {
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .problem-card dt {
    color: var(--color-text-muted);
  }

  .problem-card dd {
    margin: 0;
    color: var(--color-ink);
    font-weight: var(--fw-medium);
  }

  .problem-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .problem-layout h2,
  .section-intro h2,
  .evidence-intro h2,
  .output-intro h2,
  .fit-copy h2 {
    max-width: 20ch;
    margin-top: 0.75rem;
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  .problem-copy {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .problem-copy p,
  .section-intro > p:not(.eyebrow),
  .evidence-intro > p:not(.eyebrow),
  .output-intro > p:not(.eyebrow),
  .fit-copy > p:not(.eyebrow) {
    max-width: var(--measure-ui);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .section-stack {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  .section-intro {
    display: flex;
    max-width: 52rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .section-intro h2 {
    margin-top: -0.5rem;
  }

  .section-intro-inverse h2 {
    color: var(--color-light);
  }

  .section-intro-inverse > p:not(.eyebrow) {
    color: var(--color-text-inverse-muted);
  }

  .section-intro-split {
    display: grid;
    max-width: none;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .section-intro-split > p {
    align-self: end;
  }

  .signals,
  .decision-path {
    padding-block: var(--section-space);
    background: var(--color-ink);
    color: var(--color-light);
  }

  .signal-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: var(--border-width) solid rgb(252 254 255 / 22%);
    border-inline-start: var(--border-width) solid rgb(252 254 255 / 22%);
    list-style: none;
  }

  .signal-grid li {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2rem);
    border-inline-end: var(--border-width) solid rgb(252 254 255 / 22%);
    border-bottom: var(--border-width) solid rgb(252 254 255 / 22%);
  }

  .signal-grid .item-number {
    color: var(--color-green);
  }

  .signal-grid h3 {
    margin-top: 1.5rem;
    color: var(--color-light);
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: 1.35;
  }

  .signal-grid li > p:last-child {
    margin: 0.75rem 0 0;
    color: var(--color-text-inverse-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .condition-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: var(--border-width) solid var(--color-border);
    border-inline-start: var(--border-width) solid var(--color-border);
  }

  .condition-list article {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2rem);
    border-inline-end: var(--border-width) solid var(--color-border);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .condition-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .condition-list h3 {
    max-width: 31ch;
    margin-top: 1.75rem;
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: 1.35;
  }

  .condition-list article > p:last-child {
    max-width: var(--measure-ui);
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .path-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 0.1875rem solid var(--color-green);
    list-style: none;
  }

  .path-list li {
