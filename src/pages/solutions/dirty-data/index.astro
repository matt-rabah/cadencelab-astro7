---
import BreadcrumbSchema from "../../../components/BreadcrumbSchema.astro";
import Footer from "../../../components/Footer.astro";
import NavHeader from "../../../components/NavHeader.astro";
import SectionNav from "../../../components/SectionNav.astro";
import Layout from "../../../layouts/Layout.astro";

const visibleSignals = [
  {
    number: "01",
    title: "One customer has several identities",
    description:
      "Accounts, contacts, cases, and product records don't connect into one reliable view.",
  },
  {
    number: "02",
    title: "Pipeline stages change meaning by team",
    description:
      "The same status can mean different evidence, risk, or next steps depending on who entered it.",
  },
  {
    number: "03",
    title: "The fields are complete, but the story is missing",
    description:
      "The record passes validation while the customer's history, urgency, or next decision stays unclear.",
  },
  {
    number: "04",
    title: "Every report needs an explanation",
    description:
      "Leaders reconcile exports, spreadsheets, and local definitions before they trust the number.",
  },
];

const operatingCauses = [
  {
    label: "Purpose",
    question: "What decision is this data meant to support?",
    description:
      "Fields pile up when no one can explain who uses them, when, or why.",
  },
  {
    label: "Definitions",
    question: "Does the value mean the same thing to every team?",
    description:
      "Words like customer, stage, source, risk, and complete often hide different rules.",
  },
  {
    label: "Workflow",
    question: "Does useful data get created while the work happens?",
    description:
      "Quality falls when entry happens later, repeats known information, or adds work without value.",
  },
  {
    label: "Ownership",
    question: "Who fixes the record when systems or teams disagree?",
    description:
      "Records decay when no one owns creation, acceptance, correction, and exceptions across boundaries.",
  },
];

const evidenceSources = [
  {
    title: "Real decisions",
    description:
      "Start with the decisions teams can't make confidently and identify the signals each one needs.",
  },
  {
    title: "Records and definitions",
    description:
      "Inspect representative records, relationships, field rules, and the meaning teams give each value.",
  },
  {
    title: "Workflow and ownership",
    description:
      "Follow how data is created, handed off, approved, corrected, and maintained as the work moves.",
  },
  {
    title: "Systems and workarounds",
    description:
      "Trace integrations, match rules, reports, spreadsheets, private notes, corrections, and customer impact.",
  },
];

const repairSequence = [
  {
    phase: "Bound",
    question: "Choose one decision that matters.",
    evidence:
      "Name the workflow, roles, required signals, current failure, and expected outcome.",
  },
  {
    phase: "Trace",
    question: "Follow the signal end to end.",
    evidence:
      "Check its source, definition, record, movement, owner, use, correction, and outcome.",
  },
  {
    phase: "Repair",
    question: "Fix what keeps creating bad data.",
    evidence:
      "Change definitions, workflow, fields, matching, ownership, integration, or reporting.",
  },
  {
    phase: "Sustain",
    question: "Keep the signal useful.",
    evidence:
      "Review disputes, corrections, outcomes, ownership, and changing business rules.",
  },
];

const diagnosticPaths = [
  {
    title: "CRM Workflow Audit",
    href: "/services/crm-workflow-audit/",
    useWhen:
      "Use this when the problem sits in CRM records, fields, automation, reporting, or workflow.",
  },
  {
    title: "CX Systems Diagnostic",
    href: "/services/cx-systems-diagnostic/",
    useWhen:
      "Use this when unreliable data is part of a broader customer, ownership, or handoff problem.",
  },
  {
    title: "Lifecycle Risk Review",
    href: "/services/lifecycle-risk-review/",
    useWhen:
      "Use this when weak signals hide onboarding drift, low adoption, or renewal risk.",
  },
];

const strongFit = [
  "Teams can't trust CRM, pipeline, service, or customer signals without manual checks.",
  "Data issues cross systems, definitions, owners, or workflows.",
  "Past cleanup projects haven't produced lasting improvement.",
  "A sponsor can align business, operations, data, and technical owners.",
];
---

<Layout
  title="Dirty CRM Data and Siloed Pipelines | Cadence Lab"
  description="Find why CRM data, pipeline stages, integrations, and reports stay unreliable. Fix the workflow that keeps recreating the problem."
  canonicalURL="/solutions/dirty-data/"
  pageType="website">
  <NavHeader />
  <BreadcrumbSchema currentName="Siloed and dirty CRM pipelines" />

  <main id="main-content" class="data-page" tabindex="-1">
    <section class="data-hero" aria-labelledby="data-title">
      <div class="page-container hero-layout">
        <div class="hero-copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              <li aria-current="page">Siloed and dirty CRM pipelines</li>
            </ol>
          </nav>

          <p class="eyebrow">Solution · Siloed and dirty CRM pipelines</p>
          <h1 id="data-title">
            Your CRM is only as clean as the work behind it.
          </h1>
          <p class="hero-lead">
            A cleanup can remove duplicates. It can't fix unclear definitions,
            weak handoffs, or fields no one uses. Fix how the data gets created,
            moved, and owned, and the records have a chance to stay clean.
          </p>

          <div
            class="hero-actions"
            aria-label="Siloed and dirty CRM pipeline actions">
            <a
              class="button button-primary"
              href="/services/crm-workflow-audit/">
              Review the CRM Workflow Audit
            </a>
            <a class="button button-text" href="/fit-check/">
              Start a fit check
              <span aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </div>

        <aside class="problem-card" aria-labelledby="problem-title">
          <p id="problem-title" class="note-label">Recognizable pattern</p>
          <p>
            The CRM has required fields, integrations, automation, and
            dashboards. Teams still reconcile exports and ask an experienced
            employee which number is real.
          </p>
          <dl>
            <div>
              <dt>Visible label</dt>
              <dd>Dirty data or siloed systems</dd>
            </div>
            <div>
              <dt>Operating question</dt>
              <dd>Which decision cannot trust the available signal?</dd>
            </div>
            <div>
              <dt>Decision</dt>
              <dd>What to define, own, repair, or remove first</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <SectionNav
      items={[
        { label: "Problem", href: "#problem" },
        { label: "Signals", href: "#signals" },
        { label: "Operating causes", href: "#operating-causes" },
        { label: "Evidence", href: "#evidence" },
        { label: "Repair sequence", href: "#repair-sequence" },
        { label: "Diagnostic paths", href: "#diagnostic-paths" },
        { label: "Fit", href: "#fit" },
      ]}
    />

    <section
      id="problem"
      class="problem section-block"
      aria-labelledby="problem-heading">
      <div class="page-container problem-layout">
        <div>
          <p class="eyebrow">The problem</p>
          <h2 id="problem-heading">
            A cleanup won't fix a workflow that keeps making bad data.
          </h2>
        </div>

        <div class="problem-copy">
          <p>
            A complete record isn't always a useful one. People need to share
            its meaning, trust where it came from, know who can fix it, and
            understand which decision it supports.
          </p>
          <p>
            Without that, teams create their own version of the truth.
            Integrations spread the disagreement faster, and cleanup projects
            repair symptoms that the workflow recreates.
          </p>
        </div>
      </div>
    </section>

    <section id="signals" class="signals" aria-labelledby="signals-title">
      <div class="page-container section-stack">
        <div class="section-intro section-intro-inverse">
          <p class="eyebrow eyebrow-inverse">Visible signals</p>
          <h2 id="signals-title">
            Look for the moment someone stops trusting the record.
          </h2>
          <p>
            The warning isn't an empty field. It's the extra work people do
            before they're willing to act.
          </p>
        </div>

        <ol class="signal-grid">
          {
            visibleSignals.map((signal) => (
              <li>
                <p class="item-number">{signal.number}</p>
                <h3>{signal.title}</h3>
                <p>{signal.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      id="operating-causes"
      class="operating-causes section-block"
      aria-labelledby="causes-title">
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Operating causes</p>
            <h2 id="causes-title">Find what keeps putting bad data back in.</h2>
          </div>
          <p>
            Duplicates matter. So do the definitions, workflows, and ownership
            rules that create them again after every cleanup.
          </p>
        </div>

        <div class="cause-list">
          {
            operatingCauses.map((cause, index) => (
              <article>
                <div class="cause-heading">
                  <p class="item-number">
                    {String(index + 1).padStart(2, "0")}
                  </p>
                  <p class="cause-label">{cause.label}</p>
                </div>
                <h3>{cause.question}</h3>
                <p>{cause.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="evidence"
      class="evidence section-block"
      aria-labelledby="evidence-title">
      <div class="page-container evidence-layout">
        <div class="evidence-intro">
          <p class="eyebrow">Evidence</p>
          <h2 id="evidence-title">
            Compare the system you configured with the one people trust.
          </h2>
          <p>
            Inspect the records and the work around them. The spreadsheet,
            private note, or manual check often explains what the CRM is
            missing.
          </p>
          <div class="evidence-principle">
            <p class="note-label">Evidence principle</p>
            <p>
              Start with a real decision and the records behind it. A broad
              quality score can hide the one missing signal that blocks action.
            </p>
          </div>
        </div>

        <div class="evidence-grid">
          {
            evidenceSources.map((source, index) => (
              <article>
                <p class="item-number">{String(index + 1).padStart(2, "0")}</p>
                <h3>{source.title}</h3>
                <p>{source.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="repair-sequence"
      class="repair-sequence"
      aria-labelledby="repair-title">
      <div class="page-container section-stack">
        <div class="section-intro section-intro-inverse">
          <p class="eyebrow eyebrow-inverse">Repair sequence</p>
          <h2 id="repair-title">
            Fix one decision path before cleaning everything.
          </h2>
          <p>
            A smaller scope makes the cause visible and gives you a result you
            can test before expanding.
          </p>
        </div>

        <ol class="repair-list">
          {
            repairSequence.map((stage, index) => (
              <li>
                <div class="repair-heading">
                  <p class="repair-number">
                    {String(index + 1).padStart(2, "0")}
                  </p>
                  <p class="repair-phase">{stage.phase}</p>
                </div>
                <h3>{stage.question}</h3>
                <p>{stage.evidence}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      id="diagnostic-paths"
      class="diagnostic-paths section-block"
      aria-labelledby="paths-title">
      <div class="page-container section-stack">
        <div class="section-intro section-intro-split">
          <div>
            <p class="eyebrow">Diagnostic paths</p>
            <h2 id="paths-title">
              Start where the unreliable signal does the most harm.
            </h2>
          </div>
          <p>
            The right diagnostic depends on whether the problem is inside the
            CRM, across the customer operating system, or hiding lifecycle risk.
          </p>
        </div>

        <div class="diagnostic-grid">
          {
            diagnosticPaths.map((path, index) => (
              <article>
                <p class="item-number">{String(index + 1).padStart(2, "0")}</p>
                <h3>{path.title}</h3>
                <p>{path.useWhen}</p>
                <a href={path.href}>
                  Review the diagnostic
                  <span aria-hidden="true">&#8594;</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="fit" class="fit" aria-labelledby="fit-title">
      <div class="page-container fit-layout">
        <div class="fit-copy">
          <p class="eyebrow">Fit</p>
          <h2 id="fit-title">
            Use this path when unreliable data blocks coordinated work.
          </h2>
          <p>
            This work helps when leaders can change definitions, workflow,
            ownership, configuration, and system behavior. It isn't a bulk
            deduplication or migration service.
          </p>

          <a class="button button-primary" href="/fit-check/">
            Start a fit check
          </a>
        </div>

        <aside class="fit-list" aria-labelledby="fit-list-title">
          <p id="fit-list-title" class="note-label">Strong fit</p>
          <ul>
            {strongFit.map((condition) => <li>{condition}</li>)}
          </ul>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .data-page {
    width: 100%;
    overflow: clip;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .page-container {
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
  }

  .section-block {
    padding-block: var(--section-space);
  }

  .data-hero {
    padding-block: var(--section-space);
    border-bottom: var(--border-width) solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(19rem, 0.65fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .hero-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumb li {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .breadcrumb li + li::before {
    margin-inline-end: 0.5rem;
    color: var(--color-border-strong);
    content: "/";
  }

  .breadcrumb a {
    color: var(--color-blue);
    text-underline-offset: 0.25em;
  }

  .eyebrow,
  .note-label,
  .item-number,
  .cause-label,
  .repair-number,
  .repair-phase {
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    letter-spacing: var(--ls-eyebrow);
    font-feature-settings: var(--fea-eyebrow);
    text-transform: uppercase;
  }

  .eyebrow-inverse {
    color: var(--color-green);
  }

  h1,
  h2,
  h3,
  p,
  li,
  a,
  dt,
  dd {
    font-family: var(--font-sans);
    font-feature-settings: var(--fea-graphik);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  h1 {
    max-width: 17ch;
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  .hero-lead {
    max-width: 64ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .button {
    display: inline-flex;
    min-height: var(--control-min-size);
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.75rem 1rem;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    text-decoration: none;
  }

  .button-primary {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-light);
  }

  .button-text {
    color: var(--color-blue);
  }

  .problem-card {
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: var(--border-width) solid var(--color-border);
    border-top: 0.1875rem solid var(--color-blue);
    border-radius: var(--radius-lg);
    background: var(--color-surface-pure);
  }

  .problem-card > p:not(.note-label) {
    margin: 1rem 0 0;
    color: var(--color-ink);
    font-size: var(--fs-body-ui);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .problem-card dl {
    display: grid;
    margin: 1.5rem 0 0;
  }

  .problem-card dl > div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.9rem;
    border-top: var(--border-width) solid var(--color-border);
  }

  .problem-card dt,
  .problem-card dd {
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .problem-card dt {
    color: var(--color-text-muted);
  }

  .problem-card dd {
    margin: 0;
    color: var(--color-ink);
    font-weight: var(--fw-medium);
  }

  .problem-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .problem-layout h2,
  .section-intro h2,
  .evidence-intro h2,
  .fit-copy h2 {
    max-width: 20ch;
    margin-top: 0.75rem;
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  .problem-copy {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .problem-copy p,
  .section-intro > p:not(.eyebrow),
  .evidence-intro > p:not(.eyebrow),
  .fit-copy > p:not(.eyebrow) {
    max-width: var(--measure-ui);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .section-stack {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  .section-intro {
    display: flex;
    max-width: 52rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .section-intro h2 {
    margin-top: -0.5rem;
  }

  .section-intro-inverse h2 {
    color: var(--color-light);
  }

  .section-intro-inverse > p:not(.eyebrow) {
    color: var(--color-text-inverse-muted);
  }

  .section-intro-split {
    display: grid;
    max-width: none;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .section-intro-split > p {
    align-self: end;
  }

  .signals,
  .repair-sequence {
    padding-block: var(--section-space);
    background: var(--color-ink);
    color: var(--color-light);
  }

  .signal-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: var(--border-width) solid rgb(252 254 255 / 22%);
    border-inline-start: var(--border-width) solid rgb(252 254 255 / 22%);
    list-style: none;
  }

  .signal-grid li {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2rem);
    border-inline-end: var(--border-width) solid rgb(252 254 255 / 22%);
    border-bottom: var(--border-width) solid rgb(252 254 255 / 22%);
  }

  .signal-grid .item-number {
    color: var(--color-green);
  }

  .signal-grid h3 {
    margin-top: 1.5rem;
    color: var(--color-light);
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: 1.35;
  }

  .signal-grid li > p:last-child {
    margin: 0.75rem 0 0;
    color: var(--color-text-inverse-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .cause-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: var(--border-width) solid var(--color-border);
    border-inline-start: var(--border-width) solid var(--color-border);
  }

  .cause-list article {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2rem);
    border-inline-end: var(--border-width) solid var(--color-border);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .cause-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .cause-list h3 {
    max-width: 31ch;
    margin-top: 1.75rem;
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: 1.35;
  }

  .cause-list article > p:last-child {
    max-width: var(--measure-ui);
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .repair-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 0.1875rem solid var(--color-green);
    list-style: none;
  }

  .repair-list li {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-inline-end: var(--border-width) solid rgb(252 254 255 / 22%);
    border-bottom: var(--border-width) solid rgb(252 254 255 / 22%);
  }

  .repair-list li:first-child {
    border-inline-start: var(--border-width) solid rgb(252 254 255 / 22%);
  }

  .repair-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .repair-number {
    color: var(--color-text-inverse-muted);
  }

  .repair-phase {
    color: var(--color-green);
  }

  .repair-list h3 {
    min-height: 6.75rem;
    margin-top: 2rem;
    color: var(--color-light);
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: 1.35;
  }

  .repair-list li > p:last-child {
    margin: 1rem 0 0;
    color: var(--color-text-inverse-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .evidence {
    background: var(--color-surface-subtle);
  }

  .evidence-layout {
    display: grid;
