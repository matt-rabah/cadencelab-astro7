---
import StructuredCapabilityPage from "../../components/StructuredCapabilityPage.astro";

const page = {
  meta: {
    title: "AI and CX System Governance | Cadence Lab",
    description:
      "Build practical governance for AI, CRM, automation, and customer workflows with clear decisions, owners, evidence, oversight, and review.",
    canonicalURL: "/governance/",
  },
  hero: {
    breadcrumb: "System governance",
    eyebrow: "AI and CX system governance",
    title: "Govern the decision, not just the technology.",
    lead: "Good governance makes five things clear: what a system should do, who owns the outcome, what evidence it can use, when a person must step in, and what would cause the organization to change or stop it. If those answers aren't visible in the work, the policy isn't doing enough.",
    primaryCta: {
      label: "Start a fit check",
      href: "/fit-check/",
    },
    secondaryCta: {
      label: "Review AI Service Readiness",
      href: "/services/ai-service-readiness-review/",
    },
    trigger: {
      introduction:
        "A customer system, workflow, automation, or AI tool can influence a meaningful decision, but ownership and intervention remain unclear.",
      items: [
        {
          label: "Before use",
          value: "Purpose, limits, owner, and approval",
        },
        {
          label: "During use",
          value: "Evidence, oversight, escalation, and recovery",
        },
        {
          label: "After use",
          value: "Outcomes, incidents, change, and review",
        },
      ],
    },
  },
  signals: {
    eyebrow: "Visible signals",
    title: "Governance gaps show up in everyday work.",
    introduction:
      "The problem usually isn't a missing policy. It's a gap between the policy and the decisions people and systems make every day.",
    items: [
      {
        title: "No one owns the full outcome",
        description:
          "Technology, operations, risk, and customer teams each own a piece, but no one owns the decision end to end.",
      },
      {
        title: "Approval ends at launch",
        description:
          "The use case receives a one-time review even as the model, data, workflow, customers, and risks change.",
      },
      {
        title: "Human review has no real authority",
        description:
          "A person remains accountable but lacks the context, time, skill, or permission to change the result.",
      },
      {
        title: "Exceptions live outside the process",
        description:
          "Teams solve unusual cases through messages, workarounds, and private judgment that never improve the system.",
      },
      {
        title: "Technical metrics define success",
        description:
          "Accuracy or uptime looks strong while customer outcomes, rework, complaints, and recovery remain unseen.",
      },
      {
        title: "The organization can't explain a decision",
        description:
          "The final action is visible, but its source evidence, owner, control, approval, and rationale are not.",
      },
    ],
  },
  framework: {
    eyebrow: "Governance model",
    title: "Put accountability where the work happens.",
    introduction:
      "Practical governance connects six decisions. Each one needs an owner, usable evidence, and a clear place in the workflow.",
    items: [
      {
        label: "Purpose",
        question: "What outcome should the system improve?",
        title: "Purpose and scope",
        description:
          "Define the customer or operating outcome, intended users, permitted use, exclusions, and conditions where the system should not act.",
      },
      {
        label: "Ownership",
        question: "Who is accountable for the result?",
        title: "Ownership and authority",
        description:
          "Name the outcome owner, decision rights, operating roles, reviewers, and people responsible for exceptions and incidents.",
      },
      {
        label: "Evidence",
        question: "What information can support the decision?",
        title: "Data and knowledge",
        description:
          "Identify approved inputs, owners, quality rules, provenance, access, freshness, and what happens when evidence is missing or conflicts.",
      },
      {
        label: "Oversight",
        question: "When must a person take control?",
        title: "Human authority",
        description:
          "Set review triggers, show people the context they need, and give them enough time and authority to change the result.",
      },
      {
        label: "Control",
        question: "What keeps the system inside its limits?",
        title: "Controls and recovery",
        description:
          "Define permissions, validation, approval, escalation, stop conditions, incident response, rollback, and safe recovery.",
      },
      {
        label: "Review",
        question: "What evidence determines whether it continues?",
        title: "Measurement and change",
        description:
          "Track outcomes, corrections, incidents, workarounds, and changing conditions so leaders can continue, revise, narrow, or stop the system.",
      },
    ],
  },
  path: {
    eyebrow: "Decision lifecycle",
    title: "Follow governance from intent to review.",
    introduction:
      "Governance isn't one approval gate. The evidence should become more specific as a use case moves from an idea into live work.",
    items: [
      {
        phase: "Define",
        question: "Which decision should improve?",
        evidence:
          "Outcome, users, affected people, expected benefit, known limits, and a defined use case.",
      },
      {
        phase: "Authorize",
        question: "Who can approve the use and its limits?",
        evidence:
          "Accountable owner, decision rights, review partners, acceptance criteria, and unresolved concerns.",
      },
      {
        phase: "Operate",
        question: "How should the work run?",
        evidence:
          "Workflow, inputs, instructions, controls, handoffs, user duties, and traceable results.",
      },
      {
        phase: "Intervene",
        question: "When must a person step in?",
        evidence:
          "Uncertainty, consequence, exception, escalation, stop conditions, recovery, and response ownership.",
      },
      {
        phase: "Review",
        question: "Should the system continue as designed?",
        evidence:
          "Outcomes, corrections, complaints, incidents, adoption, changes, and the next decision.",
      },
    ],
  },
  evidence: {
    eyebrow: "Evidence",
    title: "Create an operating record people can use.",
    introduction:
      "Governance evidence should help people understand what was approved, how the system behaves, and what needs to change. It shouldn't exist only to prove that a meeting happened.",
    items: [
      {
        title: "Decision record",
        description:
          "The use case, intended outcome, accountable owner, approved limits, open questions, and reason for proceeding.",
      },
      {
        title: "Operating map",
        description:
          "The real workflow, systems, inputs, handoffs, human duties, exception paths, and downstream effects.",
      },
      {
        title: "Control evidence",
        description:
          "Guardrails, permissions, approval points, tests, monitoring, escalation rules, and proof that each control works.",
      },
      {
        title: "Human review evidence",
        description:
          "Context shown, corrections, overrides, disagreements, review time, escalations, and decisions made by accountable people.",
      },
      {
        title: "Outcome evidence",
        description:
          "Customer effect, service quality, accuracy, rework, capacity, complaints, incidents, and recovery cost.",
      },
      {
        title: "Change history",
        description:
          "Model, data, policy, workflow, vendor, use, and risk changes with the decision each change triggered.",
      },
    ],
    note: {
      label: "Evidence, not paperwork",
      description:
        "The goal isn't more documents. It's enough shared evidence to make a responsible decision, operate the system, and change course when the facts change.",
    },
  },
  failures: {
    eyebrow: "Common failure patterns",
    title: "Governance fails when accountability stays abstract.",
    introduction:
      "A policy can look complete while the real workflow still has unclear owners, weak review, hidden exceptions, and no reliable way to change course.",
    items: [
      {
        title: "The committee owns everything and nothing",
        description:
          "A group reviews the use case, but no named person owns the customer or operating outcome.",
      },
      {
        title: "The policy never reaches the workflow",
        description:
          "Standards exist, but people can't apply them during routine work, exceptions, incidents, or changes.",
      },
      {
        title: "Human oversight becomes a checkbox",
        description:
          "A reviewer is present but can't see the evidence, challenge the result, or stop the action.",
      },
      {
        title: "Every use case gets the same control",
        description:
          "Low- and high-consequence decisions follow one process regardless of risk, reversibility, or who is affected.",
      },
      {
        title: "Exceptions disappear after resolution",
        description:
          "Teams fix the immediate case but don't record the cause, decision, outcome, or system change.",
      },
      {
        title: "Launch approval lasts forever",
        description:
          "The system keeps its original approval while models, data, vendors, policies, and real use continue to change.",
      },
    ],
  },
  outputs: {
    eyebrow: "Practical outputs",
    title: "Turn governance into a working system.",
    introduction:
      "The result should make ownership, limits, intervention, evidence, and review clear enough for people to use in real work.",
    items: [
      {
        title: "Decision and ownership charter",
        description:
          "The use case, outcome, limits, owner, decision rights, affected people, approval, and conditions for change.",
      },
      {
        title: "Operating and control map",
        description:
          "The workflow, systems, evidence, permissions, handoffs, controls, exceptions, and recovery path.",
      },
      {
        title: "Human oversight model",
        description:
          "Review triggers, required context, authority, escalation, response owners, and meaningful stop conditions.",
      },
      {
        title: "Review scorecard and cadence",
        description:
          "Customer, workflow, quality, adoption, correction, incident, and risk signals with owners and decision dates.",
      },
    ],
  },
  fit: {
    eyebrow: "Engagement fit",
    title:
      "Use operating governance when a system can shape a meaningful outcome.",
    introduction:
      "This work fits a defined customer or employee workflow with real consequences and shared ownership across teams. It supports, but doesn't replace, legal advice, regulatory review, security testing, privacy assessment, or formal certification.",
    items: [
      "A customer system, CRM workflow, automation, or AI tool influences a meaningful decision.",
      "Several teams share responsibility, but ownership and decision rights are unclear.",
      "Human review, escalation, or recovery needs a defined place in the workflow.",
      "The organization can inspect evidence, controls, corrections, incidents, and outcomes.",
      "Leaders are willing to revise, narrow, pause, or stop the system when evidence changes.",
    ],
  },
  diagnostics: {
    eyebrow: "Related diagnostic paths",
    title: "Start with the system and decision that need clearer control.",
    items: [
      {
        title: "AI Service Readiness Review",
        href: "/services/ai-service-readiness-review/",
        useWhen:
          "An AI use case needs clear outcomes, data, oversight, safeguards, measures, and an implementation decision.",
      },
      {
        title: "CX Systems Diagnostic",
        href: "/services/cx-systems-diagnostic/",
        useWhen:
          "Customer outcomes depend on several teams, systems, service rules, handoffs, and ownership boundaries.",
      },
      {
        title: "CRM Workflow Audit",
        href: "/services/crm-workflow-audit/",
        useWhen:
          "Governance depends on CRM records, automation, permissions, reporting, ownership, and frontline work.",
      },
    ],
  },
};
---

<StructuredCapabilityPage {...page} />
