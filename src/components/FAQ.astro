---
// src/components/FAQ.astro
import { cn } from "@/lib/utils";

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  items?: FAQItem[];
  className?: string;
}

const {
  eyebrow = "Frequently Asked Questions",
  heading = "Clear answers about diagnostic engagements.",
  description = "Everything you need to know about scope, deliverables, and how Cadence Lab partners with your executive team.",
  items = [
    {
      question: "How long does a typical CX Systems Diagnostic take?",
      answer:
        "Most diagnostic engagements span 3 to 4 weeks from initial discovery interviews to the delivery of the sequenced decision brief.",
    },
    {
      question: "What access or data is required from our team?",
      answer:
        "We require lightweight access to CRM workflow maps, key stakeholder interviews across CS, Sales, and Product, and anonymized customer touchpoint records.",
    },
    {
      question: "How do you handle cross-functional misalignment?",
      answer:
        "Our diagnostic model traces customer friction objectively across team boundaries, providing evidence-based findings that give leadership clear permission to align decision rights.",
    },
    {
      question: "What happens after the diagnostic brief is delivered?",
      answer:
        "The output includes a sequenced remediation plan with clear owners. You can execute the roadmap internally or partner with Cadence Lab to guide workflow rebuilding.",
    },
  ],
  className = "",
} = Astro.props;
---

<section class={cn("faq", className)} id="faq" aria-labelledby="faq-title">
  <div class="faq-container">
    <div class="faq-intro">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="faq-title">{heading}</h2>
      <p>{description}</p>
    </div>

    <div class="faq-list">
      {
        items.map((item, index) => (
          <details name="homepage-faq" open={index === 0}>
            <summary>
              <span>{item.question}</span>
              <span class="faq-icon" aria-hidden="true">
                <span class="icon-closed">+</span>
                <span class="icon-open">&#8722;</span>
              </span>
            </summary>
            <div class="faq-answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--section-space);
    border-block-end: var(--border-width) solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .faq-container {
    display: grid;
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
    grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
    align-items: start;
    gap: clamp(3rem, 9vw, 8rem);
  }

  .faq-intro {
    position: sticky;
    top: calc(var(--header-offset) + 2rem);
  }

  .eyebrow {
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 20ch;
    margin: 0.75rem 0 0;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .faq-intro > p:last-child {
    max-width: 54ch;
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
  }

  details {
    overflow: clip;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface-pure);
  }

  details[open] {
    border-block-start: 0.25rem solid var(--color-blue);
    background: color-mix(
      in oklab,
      var(--color-blue) 3%,
      var(--color-surface-pure)
    );
  }

  summary {
    display: flex;
    min-height: var(--control-min-size);
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    line-height: 1.45;
    cursor: pointer;
  }

  summary::marker {
    content: "";
  }

  .faq-icon {
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    color: var(--color-blue);
    font-size: 1.25rem;
    line-height: 1;
    place-items: center;
  }

  .icon-open {
    display: none;
  }

  details[open] .icon-closed {
    display: none;
  }

  details[open] .icon-open {
    display: inline;
  }

  .faq-answer {
    padding: 0 4.5rem 1.5rem 1.5rem;
  }

  .faq-answer p {
    max-width: 62ch;
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.65;
    text-wrap: pretty;
  }

  summary:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: calc(-1 * var(--focus-ring-width));
  }

  @media (hover: hover) {
    details:not([open]) summary:hover {
      color: var(--color-blue);
    }
  }

  @media (max-width: 58rem) {
    .faq-container {
      grid-template-columns: 1fr;
    }

    .faq-intro {
      position: static;
    }
  }

  @media (max-width: 40rem) {
    summary {
      padding: 1rem;
    }

    .faq-answer {
      padding: 0 3.75rem 1.25rem 1rem;
    }
  }

  @media (pointer: coarse) {
    summary {
      min-height: 3rem;
    }
  }

  @media (forced-colors: active) {
    .faq,
    details,
    .faq-icon {
      border-color: CanvasText;
      background: Canvas;
    }
  }
</style>
