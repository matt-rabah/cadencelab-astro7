---
// src/components/FAQ.astro
import { cn } from "@/lib/utils";

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  items?: FAQItem[];
  className?: string;
}

const {
  eyebrow = "Frequently Asked Questions",
  heading = "Clear answers about diagnostic engagements.",
  description = "Everything you need to know about scope, deliverables, and how Cadence Lab partners with your executive team.",
  items = [
    {
      question: "How long does a typical CX Systems Diagnostic take?",
      answer:
        "Most diagnostic engagements span 3 to 4 weeks from initial discovery interviews to the delivery of the sequenced decision brief.",
    },
    {
      question: "What access or data is required from our team?",
      answer:
        "We require lightweight access to CRM workflow maps, key stakeholder interviews across CS/Sales/Product, and anonymized customer touchpoint records.",
    },
    {
      question: "How do you handle cross-functional misalignment?",
      answer:
        "Our diagnostic model traces customer friction objectively across team boundaries, providing evidence-based findings that give leadership clear permission to align decision rights.",
    },
    {
      question: "What happens after the diagnostic brief is delivered?",
      answer:
        "The output includes a sequenced remediation plan with clear owners. You can execute the roadmap internally or partner with Cadence Lab to guide workflow rebuilding.",
    },
  ],
  className = "",
} = Astro.props;
---

<section
  class={cn(
    "py-20 md:py-32 bg-background text-foreground border-b border-black/10",
    className,
  )}
  id="faq">
  <div class="container mx-auto px-6 max-w-6xl">
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start text-left">
      <!-- Left Column Header -->
      <div
        class="lg:col-span-5 flex flex-col items-start text-left lg:sticky lg:top-28">
        <span
          class="text-xs font-mono font-bold uppercase tracking-widest text-[#1823c9] mb-4 block">
          {eyebrow}
        </span>
        <h2
          class="text-3xl sm:text-4xl font-bold tracking-tight text-black text-left leading-tight">
          {heading}
        </h2>
        <p class="mt-6 text-base text-[#4a5056] text-left leading-relaxed">
          {description}
        </p>
      </div>

      <!-- Right Column Accordion List -->
      <div
        class="lg:col-span-7 flex flex-col divide-y divide-black/10 border-t border-b border-black/10 w-full">
        {
          items.map((item) => (
            <details class="group py-6 text-left cursor-pointer transition-colors">
              <summary class="flex justify-between items-center text-left text-lg font-bold text-black list-none select-none group-hover:text-[#1823c9] transition-colors">
                <span class="pr-6">{item.question}</span>
                <span class="text-[#1823c9] transition-transform duration-200 group-open:rotate-180 font-mono text-xl shrink-0">
                  ↓
                </span>
              </summary>
              <p class="mt-4 text-sm text-[#4a5056] leading-relaxed text-left pr-6">
                {item.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
