---
// src/components/FAQ.astro
import { cn } from "@/lib/utils";

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  items?: FAQItem[];
  className?: string;
}

const {
  eyebrow = "Frequently Asked Questions",
  heading = "Clear answers about diagnostic engagements.",
  description = "Everything you need to know about scope, deliverables, and how Cadence Lab partners with your executive team.",
  items = [
    {
      question: "How long does a CX Systems Diagnostic take?",
      answer:
        "Usually three to four weeks. That covers everything from the first interviews to the decision brief you’ll use to sequence the work.",
    },
    {
      question: "What do you need from our team?",
      answer:
        "Less than you’d think. Access to your CRM workflow maps, conversations with key people in CS, Sales, and Product, and anonymized records of customer touchpoints.",
    },
    {
      question: "What if our leaders don’t agree?",
      answer:
        "That’s more common than you’d think. I trace customer friction across team lines and bring back evidence. It’s a lot easier to agree on who decides what when everyone’s looking at the same facts.",
    },
    {
      question: "What happens after the brief?",
      answer:
        "You get a plan in the right order, with clear owners. Run it with your own team, or bring me in to help rebuild the workflows. Your call.",
    },
  ],
  className = "",
} = Astro.props;
---

<section class={cn("faq", className)} id="faq" aria-labelledby="faq-title">
  <div class="faq-container">
    <div class="faq-intro">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id="faq-title">{heading}</h2>
      <p>{description}</p>
    </div>

    <ul class="disclosure-list faq-list" role="list">
      {items.map((item, index) => (
        <li>
          <details class="disclosure" name="homepage-faq" open={index === 0}>
            <summary class="disclosure-summary">
              <span class="disclosure-title">{item.question}</span>
            </summary>
            <div class="disclosure-body">
              <p>{item.answer}</p>
            </div>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  h2:first-child {
    margin-top: 0;
  }

  .faq {
    padding-block: var(--section-space);
    border-block-end: var(--border-width) solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .faq-container {
    display: grid;
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
    grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
    align-items: start;
    gap: clamp(3rem, 9vw, 8rem);
  }

  .faq-intro {
    position: sticky;
    top: calc(var(--header-offset) + 2rem);
  }

  .eyebrow {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    letter-spacing: 0;
  }

  h2 {
    max-width: 20ch;
    margin: 0.75rem 0 0;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .faq-intro > p:last-child {
    max-width: 54ch;
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: 1.65;
    text-wrap: pretty;
  }

  @media (max-width: 58rem) {
    .faq-container {
      grid-template-columns: 1fr;
    }

    .faq-intro {
      position: static;
    }
  }

  @media (forced-colors: active) {
    .faq {
      border-color: CanvasText;
      background: Canvas;
    }
  }
</style>
