---
// src/components/Logos.astro
import { cn } from "@/lib/utils";

interface LogoItem {
  name: string;
}

interface Props {
  heading?: string;
  logos?: LogoItem[];
  className?: string;
}

const {
  heading = "Enterprise systems and platforms mapped in diagnostics",
  logos = [
    { name: "Salesforce" },
    { name: "HubSpot" },
    { name: "Zendesk" },
    { name: "ServiceNow" },
    { name: "Jira" },
    { name: "Snowflake" },
  ],
  className = "",
} = Astro.props;
---

<section
  class={cn("platform-context", className)}
  aria-labelledby="platform-title"
>
  <div class="platform-container">
    <div class="platform-heading">
      <span class="signal-dot" aria-hidden="true"></span>
      <h2 id="platform-title">{heading}</h2>
    </div>

    <ul role="list">
      {
        logos.map((item) => (
          <li>
            <span>{item.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .platform-context {
    padding-block: clamp(2.5rem, 6vw, 4rem);
    border-block-end: var(--border-width) solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .platform-container {
    display: grid;
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .platform-heading {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .signal-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    margin-top: 0.35rem;
    border-radius: 50%;
    background: #ffce31;
  }

  h2 {
    max-width: 34ch;
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block-start: var(--border-width) solid var(--color-border-strong);
    border-inline-start: var(--border-width) solid var(--color-border-strong);
    list-style: none;
  }

  li {
    min-width: 0;
    padding: 0.9rem 1rem;
    border-inline-end: var(--border-width) solid var(--color-border-strong);
    border-block-end: var(--border-width) solid var(--color-border-strong);
    background: color-mix(
      in oklab,
      var(--color-blue) 2%,
      var(--color-surface-pure)
    );
  }

  li span {
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
  }

  @media (max-width: 48rem) {
    .platform-container {
      grid-template-columns: 1fr;
    }

    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (forced-colors: active) {
    .platform-context,
    ul,
    li {
      border-color: CanvasText;
      background: Canvas;
    }

    .signal-dot {
      background: Highlight;
    }
  }
</style>
