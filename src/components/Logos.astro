---
// src/components/Logos.astro
import { existsSync } from "node:fs";
import { join } from "node:path";
import { cn } from "@/lib/utils";

interface LogoItem {
  name: string;
  src?: string;
}

interface Props {
  heading?: string;
  logos?: LogoItem[];
  className?: string;
}

const {
  heading = "Enterprise systems and platforms mapped in diagnostics",
  logos = [
    { name: "Salesforce", src: "/brand/platforms/salesforce.svg" },
    { name: "HubSpot", src: "/brand/platforms/hubspot.svg" },
    { name: "Zendesk", src: "/brand/platforms/zendesk.svg" },
    { name: "Gainsight", src: "/brand/platforms/gainsight.svg" },
    { name: "Qualtrics", src: "/brand/platforms/qualtrics.svg" },
    { name: "ServiceNow", src: "/brand/platforms/servicenow.svg" },
  ],
  className = "",
} = Astro.props;

const publicDirectory = join(process.cwd(), "public");
const availableLogos = logos.map((item) => ({
  ...item,
  hasAsset:
    typeof item.src === "string" &&
    existsSync(join(publicDirectory, item.src.replace(/^\//, ""))),
}));
---

<section
  class={cn("platform-context", className)}
  aria-labelledby="platform-title"
>
  <div class="platform-container">
    <div class="platform-heading">
      <span class="signal-dot" aria-hidden="true"></span>
      <h2 id="platform-title">{heading}</h2>
    </div>

    <div
      class="logo-rail"
      role="group"
      tabindex="0"
      aria-label="Platform logos"
    >
      <ul role="list">
        {
          availableLogos.map((item) => (
            <li>
              {item.hasAsset ? (
                <img
                  class:list={{
                    "logo-adapts-to-dark": [
                      "Gainsight",
                      "Qualtrics",
                      "Zendesk",
                    ].includes(item.name),
                  }}
                  src={item.src}
                  alt={item.name}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span>{item.name}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .platform-context {
    padding-block: clamp(2.5rem, 6vw, 4rem);
    border-block-end: var(--border-width) solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .platform-container {
    display: grid;
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .platform-heading {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .signal-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    margin-top: 0.35rem;
    border-radius: 50%;
    background: #ffce31;
  }

  h2 {
    max-width: 34ch;
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .logo-rail {
    min-width: 0;
    padding-block-end: 0.625rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: 0.125rem;
    scroll-snap-type: inline proximity;
    scrollbar-color: var(--color-border-strong) transparent;
    scrollbar-width: thin;
  }

  .logo-rail:focus-visible {
    border-radius: var(--radius-sm);
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  ul {
    display: flex;
    width: max-content;
    min-width: 100%;
    margin: 0;
    padding: 0;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    list-style: none;
  }

  li {
    display: grid;
    width: clamp(10rem, 16vw, 13rem);
    min-height: 5rem;
    flex: 0 0 auto;
    padding: 1rem 1.25rem;
    background: transparent;
    scroll-snap-align: start;
    place-items: center;
  }

  li img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 2.5rem;
  }

  :global(:root[data-theme="dark"]) .logo-adapts-to-dark {
    filter: brightness(0) invert(1);
  }

  li span {
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
  }

  @media (max-width: 48rem) {
    .platform-container {
      grid-template-columns: 1fr;
    }

    li {
      width: min(11rem, 68vw);
    }
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .logo-adapts-to-dark {
      filter: brightness(0) invert(1);
    }
  }

  @media (forced-colors: active) {
    .platform-context {
      border-color: CanvasText;
      background: Canvas;
    }

    .signal-dot {
      background: Highlight;
    }
  }
</style>
