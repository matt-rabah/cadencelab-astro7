---
// src/components/Logos.astro
import { cn } from "@/lib/utils";

interface LogoItem {
  name: string;
  logo?: string;
}

interface Props {
  heading?: string;
  logos?: LogoItem[];
  className?: string;
}

const {
  heading = "Enterprise systems and platforms mapped in diagnostics",
  logos = [
    { name: "Salesforce" },
    { name: "HubSpot" },
    { name: "Zendesk" },
    { name: "ServiceNow" },
    { name: "Jira" },
    { name: "Snowflake" },
  ],
  className = "",
} = Astro.props;
---

<section
  class={cn("py-12 md:py-16 bg-[#f8f9fa] border-b border-black/10", className)}
  id="logos">
  <div class="container mx-auto px-6 max-w-6xl text-left">
    <span
      class="text-xs font-mono font-bold uppercase tracking-widest text-[#4a5056] mb-8 block text-left">
      {heading}
    </span>

    <!-- Flat Executive Platform Grid -->
    <div
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4 items-center">
      {
        logos.map((item) => (
          <div class="flex items-center justify-center h-12 px-4 rounded-xs border border-black/10 bg-white text-xs font-mono font-bold tracking-wider text-black/80 hover:border-[#1823c9]/40 hover:text-[#1823c9] transition-colors select-none">
            {item.name}
          </div>
        ))
      }
    </div>
  </div>
</section>
