---
// src/components/Hero.astro
interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  primaryCta?: { text: string; url: string };
  secondaryCta?: { text: string; url: string };
  className?: string;
}

const {
  eyebrow = "Customer Experience Operating Systems",
  heading = "Customer experience operating systems for the AI era.",
  description = "Cadence Lab helps companies fix onboarding drift, quiet accounts, unreliable CRM signals, and service handoffs, then build the conditions needed for effective AI adoption.",
  primaryCta = { text: "Start a Fit Check™", url: "/fit-check/" },
  secondaryCta = { text: "Review diagnostic offers", url: "#diagnostics" },
  className = "",
} = Astro.props;
---

<section class:list={["hero", className]} aria-labelledby="hero-title">
  <div class="hero-container">
    <div class="hero-copy">
      <p class="hero-eyebrow">{eyebrow}</p>
      <h1 id="hero-title">{heading}</h1>
      <p class="hero-description">{description}</p>

      <div class="hero-actions" aria-label="Homepage actions">
        {
          primaryCta && (
            <a class="button button-primary" href={primaryCta.url}>
              {primaryCta.text}
            </a>
          )
        }
        {
          secondaryCta && (
            <a class="button button-secondary" href={secondaryCta.url}>
              {secondaryCta.text}
              <span aria-hidden="true">&#8595;</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(4.5rem, 10vw, 8rem);
    border-block-end: var(--border-width) solid var(--color-border);
    background:
      linear-gradient(
        135deg,
        color-mix(in oklab, var(--color-blue) 5%, transparent),
        transparent 42%
      ),
      var(--color-surface);
    color: var(--color-text);
  }

  .hero-container {
    display: grid;
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    gap: clamp(3rem, 9vw, 8rem);
  }

  .hero-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-eyebrow {
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 17ch;
    margin: 1rem 0 0;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .hero-description {
    max-width: 63ch;
    margin: 1.75rem 0 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: var(--control-min-size);
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.75rem 1rem;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .button-primary {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-light);
  }

  .button-secondary {
    border-color: var(--color-border-strong);
    background: color-mix(
      in oklab,
      var(--color-blue) 3%,
      var(--color-surface-pure)
    );
    color: var(--color-ink);
  }

  :where(.button):focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  @media (hover: hover) {
    .button-primary:hover {
      border-color: var(--color-blue);
      background: var(--color-blue);
    }

    .button-secondary:hover {
      border-color: var(--color-blue);
      color: var(--color-blue);
    }
  }

  @media (max-width: 58rem) {
    .hero-container {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 3rem;
    }
  }

  @media (max-width: 40rem) {
    .hero-actions {
      width: 100%;
      flex-direction: column;
    }

    .button {
      width: 100%;
    }
  }

  @media (pointer: coarse) {
    .button {
      min-height: 3rem;
    }
  }

  @media (forced-colors: active) {
    .hero {
      border-color: CanvasText;
    }
    .hero,
    .button-secondary {
      background: Canvas;
    }
  }
</style>
