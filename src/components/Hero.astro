---
// src/components/Hero.astro
interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  primaryCta?: { text: string; url: string };
  secondaryCta?: { text: string; url: string };
  className?: string;
}

const {
  eyebrow = "Customer Experience Operating Systems",
  heading = "Customer experience operating systems for the AI era.",
  description = "Cadence Lab helps companies fix onboarding drift, quiet accounts, unreliable CRM signals, and service handoffs, then build the conditions needed for effective AI adoption.",
  primaryCta = { text: "Start a Fit Check™", url: "/fit-check/" },
  secondaryCta = { text: "Review diagnostic offers", url: "#diagnostics" },
  className = "",
} = Astro.props;

const operatingSignals = [
  {
    number: "01",
    label: "Diagnose",
    description: "Friction, lifecycle risk, and signal gaps",
  },
  {
    number: "02",
    label: "Rebuild",
    description: "Ownership, handoffs, and CRM workflows",
  },
  {
    number: "03",
    label: "Prepare",
    description: "Human oversight, adoption, and measurement",
  },
];
---

<section class:list={["hero", className]} aria-labelledby="hero-title">
  <div class="hero-container">
    <div class="hero-copy">
      <p class="hero-eyebrow">{eyebrow}</p>
      <h1 id="hero-title">{heading}</h1>
      <p class="hero-description">{description}</p>

      <div class="hero-actions" aria-label="Homepage actions">
        {
          primaryCta && (
            <a class="button button-primary" href={primaryCta.url}>
              {primaryCta.text}
            </a>
          )
        }
        {
          secondaryCta && (
            <a class="button button-secondary" href={secondaryCta.url}>
              {secondaryCta.text}
              <span aria-hidden="true">&#8595;</span>
            </a>
          )
        }
      </div>
    </div>

    <aside class="hero-system" aria-labelledby="hero-system-title">
      <div class="hero-system-heading">
        <span class="signal-dot" aria-hidden="true"></span>
        <p id="hero-system-title">Operating sequence</p>
      </div>

      <ol>
        {
          operatingSignals.map((signal) => (
            <li>
              <p class="signal-number" aria-hidden="true">
                {signal.number}
              </p>
              <div>
                <h2>{signal.label}</h2>
                <p>{signal.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(4.5rem, 10vw, 8rem);
    border-block-end: var(--border-width) solid var(--color-border);
    background:
      linear-gradient(
        135deg,
        color-mix(in oklab, var(--color-blue) 5%, transparent),
        transparent 42%
      ),
      var(--color-surface);
    color: var(--color-text);
  }

  .hero-container {
    display: grid;
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
    align-items: end;
    gap: clamp(3rem, 9vw, 8rem);
  }

  .hero-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-eyebrow,
  .hero-system-heading p,
  .signal-number {
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 17ch;
    margin: 1rem 0 0;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-display);
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .hero-description {
    max-width: 63ch;
    margin: 1.75rem 0 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: var(--control-min-size);
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.75rem 1rem;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .button-primary {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-light);
  }

  .button-secondary {
    border-color: var(--color-border-strong);
    background: color-mix(
      in oklab,
      var(--color-blue) 3%,
      var(--color-surface-pure)
    );
    color: var(--color-ink);
  }

  .hero-system {
    overflow: clip;
    border: var(--border-width) solid var(--color-border-strong);
    border-block-start: 0.25rem solid var(--color-blue);
    border-radius: var(--radius-lg);
    background: color-mix(
      in oklab,
      var(--color-blue) 4%,
      var(--color-surface-pure)
    );
  }

  .hero-system-heading {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 1.25rem 1.5rem;
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .signal-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #ffce31;
  }

  .hero-system ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-system li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
  }

  .hero-system li:not(:last-child) {
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .signal-number {
    color: var(--color-text-muted);
  }

  .hero-system h2 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    line-height: 1.4;
  }

  .hero-system li div p {
    margin: 0.35rem 0 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.55;
    text-wrap: pretty;
  }

  :where(.button):focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  @media (hover: hover) {
    .button-primary:hover {
      border-color: var(--color-blue);
      background: var(--color-blue);
    }

    .button-secondary:hover {
      border-color: var(--color-blue);
      color: var(--color-blue);
    }
  }

  @media (max-width: 58rem) {
    .hero-container {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 3rem;
    }

    .hero-system {
      width: 100%;
    }

    .hero-system ol {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hero-system li {
      grid-template-columns: 1fr;
    }

    .hero-system li:not(:last-child) {
      border-block-end: 0;
      border-inline-end: var(--border-width) solid var(--color-border);
    }
  }

  @media (max-width: 40rem) {
    .hero-actions {
      width: 100%;
      flex-direction: column;
    }

    .button {
      width: 100%;
    }

    .hero-system ol {
      grid-template-columns: 1fr;
    }

    .hero-system li {
      grid-template-columns: 2.25rem minmax(0, 1fr);
    }

    .hero-system li:not(:last-child) {
      border-inline-end: 0;
      border-block-end: var(--border-width) solid var(--color-border);
    }
  }

  @media (pointer: coarse) {
    .button {
      min-height: 3rem;
    }
  }

  @media (forced-colors: active) {
    .hero,
    .hero-system,
    .hero-system-heading,
    .hero-system li {
      border-color: CanvasText;
    }

    .hero,
    .hero-system,
    .button-secondary {
      background: Canvas;
    }

    .signal-dot {
      background: Highlight;
    }
  }
</style>
