---
// src/components/Hero.astro
interface TabItem {
  title: string;
  description: string;
  image: {
    src: string;
    alt: string;
  };
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  primaryCta?: { text: string; url: string };
  secondaryCta?: { text: string; url: string };
  tabs?: TabItem[];
  className?: string;
}

const {
  eyebrow = "Customer Experience Operating Systems",
  heading = "Stop customer issues from becoming lost revenue.",
  description = "Most customer-facing AI projects don't fail because of the model—they fail because the workflow, ownership, and measurement never worked. Cadence Lab diagnoses onboarding drift, lifecycle risk, and unreliable CRM workflows to turn evidence into practical operating change.",
  primaryCta = { text: "Start a Fit Check", url: "/fit-check/" },
  secondaryCta = { text: "Review Diagnostic Offers", url: "#diagnostics" },
  tabs = [
    {
      title: "CX Diagnostics",
      description:
        "Map touchpoints, handoffs, and friction to output a sequenced decision brief.",
      image: {
        src: "https://deifkwefumgah.cloudfront.net/shadcnblocks/image-set/modern/saas-hero/saas-hero-1-16x9.png",
        alt: "CX Systems Diagnostic Dashboard",
      },
    },
    {
      title: "Lifecycle Risk",
      description:
        "Identify onboarding drift and quiet accounts before renewal windows close.",
      image: {
        src: "https://deifkwefumgah.cloudfront.net/shadcnblocks/image-set/modern/saas-hero/saas-hero-2-16x9.png",
        alt: "Lifecycle Risk Monitoring",
      },
    },
    {
      title: "CRM Workflows",
      description:
        "Clean up weak signals, process gaps, and misaligned decision rights.",
      image: {
        src: "https://deifkwefumgah.cloudfront.net/shadcnblocks/image-set/modern/saas-hero/saas-hero-3-16x9.png",
        alt: "CRM Workflow Audit Visualizer",
      },
    },
    {
      title: "AI Readiness",
      description:
        "Evaluate process readiness, trust, and human oversight for AI adoption.",
      image: {
        src: "https://deifkwefumgah.cloudfront.net/shadcnblocks/image-set/modern/saas-hero/saas-hero-4-16x9.png",
        alt: "AI Service Readiness Assessment",
      },
    },
  ],
  className = "",
} = Astro.props;

const hasTabs = Array.isArray(tabs) && tabs.length > 0;
const activeTab = hasTabs ? tabs[0] : null;
---

<section
  class:list={[
    "py-20 md:py-32 bg-background text-foreground border-b border-border/50",
    className,
  ]}
  aria-labelledby="hero-title">
  <div class="container mx-auto px-6 max-w-6xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start text-left">
      <!-- Left Column: Primary Copy & CTAs -->
      <div class="lg:col-span-8 flex flex-col items-start text-left">
        <span
          class="text-xs font-mono font-semibold uppercase tracking-widest text-primary mb-4">
          {eyebrow}
        </span>

        <h1
          id="hero-title"
          class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-foreground text-left leading-[1.12] text-balance">
          {heading}
        </h1>

        <p
          class="mt-8 text-base sm:text-lg text-muted-foreground text-left leading-relaxed max-w-2xl font-normal">
          {description}
        </p>

        <div
          class="mt-10 flex flex-col sm:flex-row gap-4 w-full sm:w-auto items-stretch sm:items-center">
          {
            primaryCta && (
              <a
                href={primaryCta.url}
                class="inline-flex h-12 items-center justify-center rounded-md bg-primary px-8 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring w-full sm:w-auto">
                {primaryCta.text}
              </a>
            )
          }
          {
            secondaryCta && (
              <a
                href={secondaryCta.url}
                class="inline-flex h-12 items-center justify-center rounded-md border border-input bg-background px-8 text-sm font-medium text-foreground shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring w-full sm:w-auto">
                {secondaryCta.text}
              </a>
            )
          }
        </div>
      </div>

      <!-- Right Column: Clean Telemetry Rail (Spacious & Minimal) -->
      <div
        class="lg:col-span-4 w-full border-l border-border/60 pl-8 hidden lg:flex flex-col gap-8 pt-2">
        <div class="space-y-2">
          <span class="text-xs font-mono text-primary font-bold tracking-wider"
            >01 / DIAGNOSE</span
          >
          <p class="text-xs text-muted-foreground leading-relaxed">
            Cross-functional friction, onboarding drift, and signal decay.
          </p>
        </div>
        <div class="space-y-2">
          <span class="text-xs font-mono text-primary font-bold tracking-wider"
            >02 / REBUILD</span
          >
          <p class="text-xs text-muted-foreground leading-relaxed">
            Decision rights, CRM handoffs, and operational accountability.
          </p>
        </div>
        <div class="space-y-2">
          <span class="text-xs font-mono text-primary font-bold tracking-wider"
            >03 / PREPARE</span
          >
          <p class="text-xs text-muted-foreground leading-relaxed">
            Human oversight, AI guardrails, and sustainable adoption.
          </p>
        </div>
      </div>
    </div>

    <!-- Feature Gallery Preview (Spacious Tab Cards) -->
    {
      hasTabs && activeTab && (
        <div class="mt-24 pt-16 border-t border-border/40">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
            {tabs.map((tab, i) => (
              <button
                type="button"
                class:list={[
                  "tab-trigger text-left p-6 rounded-xl border transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring",
                  i === 0
                    ? "border-primary bg-primary/5 active-tab"
                    : "border-border/60 bg-card/40 hover:border-primary/50 inactive-tab",
                ]}
                data-image-src={tab.image.src}
                data-image-alt={tab.image.alt}>
                <span class="text-xs font-mono text-muted-foreground block mb-2 pointer-events-none">
                  0{i + 1}
                </span>
                <h3 class="font-semibold text-foreground text-base mb-2 pointer-events-none">
                  {tab.title}
                </h3>
                <p class="text-xs text-muted-foreground leading-relaxed pointer-events-none">
                  {tab.description}
                </p>
              </button>
            ))}
          </div>
          <div class="relative rounded-2xl border border-border/60 overflow-hidden shadow-xl bg-muted">
            <img
              id="gallery-image"
              src={activeTab.image.src}
              alt={activeTab.image.alt}
              class="aspect-video w-full object-cover object-top transition-opacity duration-300"
            />
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  function setupTabs() {
    const triggers =
      document.querySelectorAll<HTMLButtonElement>(".tab-trigger");
    const image = document.getElementById("gallery-image") as HTMLImageElement;

    if (!triggers.length || !image) return;

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        // Reset all tabs to inactive styles
        triggers.forEach((t) => {
          t.classList.remove("border-primary", "bg-primary/5", "active-tab");
          t.classList.add("border-border/60", "bg-card/40", "inactive-tab");
        });

        // Set clicked tab to active styles
        trigger.classList.remove(
          "border-border/60",
          "bg-card/40",
          "inactive-tab",
        );
        trigger.classList.add("border-primary", "bg-primary/5", "active-tab");

        // Crossfade image
        const newSrc = trigger.dataset.imageSrc;
        const newAlt = trigger.dataset.imageAlt;

        if (newSrc && image.src !== newSrc) {
          image.style.opacity = "0.4";
          setTimeout(() => {
            image.src = newSrc;
            if (newAlt) image.alt = newAlt;
            image.style.opacity = "1";
          }, 150);
        }
      });
    });
  }

  // Setup on initial load and after Astro view transitions
  setupTabs();
  document.addEventListener("astro:after-swap", setupTabs);
</script>
