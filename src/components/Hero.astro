---
// src/components/Hero.astro

interface TabItem {
  title: string;
  description: string;
  image: {
    src: string;
    alt: string;
  };
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  primaryCta?: { text: string; url: string };
  secondaryCta?: { text: string; url: string };
  tabs?: TabItem[];
  className?: string;
}

const {
  eyebrow = "Customer Experience Operating Systems",
  heading = "Stop customer issues from becoming lost revenue.",
  description = "Most customer-facing AI projects don't fail because of the model—they fail because the workflow, ownership, and measurement never worked. Cadence Lab diagnoses onboarding drift, lifecycle risk, and unreliable CRM workflows to turn evidence into practical operating change.",
  primaryCta = { text: "Start a Fit Check", url: "/fit-check/" },
  secondaryCta = { text: "Review Diagnostic Offers", url: "#diagnostics" },
  tabs = [
    {
      title: "CX Diagnostics",
      description:
        "Map touchpoints, handoffs, and friction to output a sequenced decision brief.",
      image: {
        src: "https://deifkwefumgah.cloudfront.net/shadcnblocks/image-set/modern/saas-hero/saas-hero-1-16x9.png",
        alt: "CX Systems Diagnostic Dashboard",
      },
    },
    {
      title: "Lifecycle Risk",
      description:
        "Identify onboarding drift and quiet accounts before renewal windows close.",
      image: {
        src: "https://deifkwefumgah.cloudfront.net/shadcnblocks/image-set/modern/saas-hero/saas-hero-2-16x9.png",
        alt: "Lifecycle Risk Monitoring",
      },
    },
    {
      title: "CRM Workflows",
      description:
        "Clean up weak signals, process gaps, and misaligned decision rights.",
      image: {
        src: "https://deifkwefumgah.cloudfront.net/shadcnblocks/image-set/modern/saas-hero/saas-hero-3-16x9.png",
        alt: "CRM Workflow Audit Visualizer",
      },
    },
    {
      title: "AI Readiness",
      description:
        "Evaluate process readiness, trust, and human oversight for AI adoption.",
      image: {
        src: "https://deifkwefumgah.cloudfront.net/shadcnblocks/image-set/modern/saas-hero/saas-hero-4-16x9.png",
        alt: "AI Service Readiness Assessment",
      },
    },
  ],
  className = "",
} = Astro.props;

const hasTabs = Array.isArray(tabs) && tabs.length > 0;
const activeTab = hasTabs ? tabs[0] : null;
---

<section
  class={`overflow-hidden py-16 md:py-24 bg-background text-foreground ${className}`}
  aria-labelledby="hero-title">
  <div class="container mx-auto px-4">
    <div class="border-x border-border py-12 lg:py-16">
      <div class="relative mx-auto max-w-4xl px-6 text-center">
        <p
          class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">
          {eyebrow}
        </p>
        <h1
          id="hero-title"
          class="mx-auto max-w-4xl text-3xl font-bold tracking-tight text-balance md:text-5xl lg:text-6xl text-foreground">
          {heading}
        </h1>
        <p
          class="mx-auto mt-6 max-w-2xl text-base text-muted-foreground md:text-lg leading-relaxed">
          {description}
        </p>
        <div
          class="mx-auto mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
          {
            primaryCta && (
              <a
                href={primaryCta.url}
                class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-8 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring w-full sm:w-auto">
                {primaryCta.text}
              </a>
            )
          }
          {
            secondaryCta && (
              <a
                href={secondaryCta.url}
                class="inline-flex h-11 items-center justify-center rounded-md border border-input bg-background px-8 text-sm font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring w-full sm:w-auto">
                {secondaryCta.text}
              </a>
            )
          }
        </div>
      </div>

      {
        hasTabs && activeTab && (
          <div class="mt-12 md:mt-16 lg:mt-20 px-4 max-w-5xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
              {tabs.map((tab, i) => (
                <div class="p-4 rounded-lg border border-border bg-card/50 text-left hover:border-primary/50 transition-colors">
                  <span class="text-xs font-mono text-muted-foreground block mb-1">
                    0{i + 1}
                  </span>
                  <h3 class="font-semibold text-foreground text-sm mb-1">
                    {tab.title}
                  </h3>
                  <p class="text-xs text-muted-foreground line-clamp-2">
                    {tab.description}
                  </p>
                </div>
              ))}
            </div>
            <div class="relative rounded-xl border border-border overflow-hidden shadow-2xl">
              <img
                src={activeTab.image.src}
                alt={activeTab.image.alt}
                class="aspect-16/10 w-full object-cover object-top"
              />
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
