---
// src/components/OperatingModel.astro
import { cn } from "@/lib/utils";

interface Stage {
  step: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  steps?: Stage[];
  className?: string;
}

const {
  eyebrow = "Operating Model",
  heading = "Let the evidence determine the recommendation.",
  subheading = "Cadence Lab connects strategy to the way work is owned, performed, governed, and measured. Technology should support that operating model and make the work easier to manage.",
  steps = [
    {
      step: "01",
      title: "Diagnose the operating environment",
      description:
        "Trace the customer problem through teams, systems, data, decisions, and frontline work before prescribing a solution.",
    },
    {
      step: "02",
      title: "Align the decisions",
      description:
        "Define the outcome, accountable owners, decision rights, constraints, and sequence of changes before implementation begins.",
    },
    {
      step: "03",
      title: "Rebuild the workflow",
      description:
        "Translate the decision into usable handoffs, CRM requirements, governance, team practices, and appropriate AI support.",
    },
    {
      step: "04",
      title: "Measure and adapt",
      description:
        "Connect customer, workflow, adoption, and performance signals to the change, then refine the system as evidence develops.",
    },
  ],
  className = "",
} = Astro.props;
---

<section
  class={cn(
    "py-20 md:py-32 bg-background text-foreground border-b border-black/10",
    className,
  )}
  id="operating-model">
  <div class="container mx-auto px-6 max-w-6xl">
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start text-left">
      <!-- Left Column: Sticky Intro Header -->
      <div
        class="lg:col-span-5 flex flex-col items-start text-left lg:sticky lg:top-28">
        <span
          class="text-xs font-mono font-bold uppercase tracking-widest text-[#1823c9] mb-4 block">
          {eyebrow}
        </span>
        <h2
          class="text-3xl sm:text-4xl font-bold tracking-tight text-black text-left leading-tight">
          {heading}
        </h2>
        <p class="mt-6 text-base text-[#4a5056] text-left leading-relaxed">
          {subheading}
        </p>
      </div>

      <!-- Right Column: Architectural Divider Grid -->
      <div
        class="lg:col-span-7 flex flex-col divide-y divide-black/10 border-t border-b border-black/10">
        {
          steps.map((stage) => (
            <div class="py-8 md:py-10 flex flex-col sm:flex-row items-start gap-4 sm:gap-8 text-left">
              <span class="text-sm font-mono font-bold text-[#1823c9] shrink-0 pt-1">
                {stage.step}
              </span>
              <div class="space-y-3 text-left">
                <h3 class="text-xl font-bold text-black tracking-tight text-left">
                  {stage.title}
                </h3>
                <p class="text-sm text-[#4a5056] leading-relaxed text-left">
                  {stage.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
