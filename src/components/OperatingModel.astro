---
// src/components/OperatingModel.astro
import { cn } from "@/lib/utils";

interface Stage {
  step: string;
  /** Friction Trace annotation: what this step produces (DESIGN.md, section 5). */
  label?: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  steps?: Stage[];
  className?: string;
}

const {
  eyebrow = "Operating Model",
  heading = "Let the evidence determine the recommendation.",
  subheading = "Cadence Lab connects strategy to the way work is owned, performed, governed, and measured. Technology should support that operating model and make the work easier to manage.",
  steps = [
    {
      step: "01",
      title: "Diagnose the operating environment",
      description:
        "Trace the customer problem through teams, systems, data, decisions, and frontline work before prescribing a solution.",
    },
    {
      step: "02",
      title: "Align the decisions",
      description:
        "Define the outcome, accountable owners, decision rights, constraints, and sequence of changes before implementation begins.",
    },
    {
      step: "03",
      title: "Rebuild the workflow",
      description:
        "Translate the decision into usable handoffs, CRM requirements, governance, team practices, and appropriate AI support.",
    },
    {
      step: "04",
      title: "Measure and adapt",
      description:
        "Connect customer, workflow, adoption, and performance signals to the change, then refine the system as evidence develops.",
    },
  ],
  className = "",
} = Astro.props;
---

<section
  data-band
  class={cn("operating-model", className)}
  id="operating-model"
  aria-labelledby="operating-model-title"
>
  <div class="operating-container">
    <div class="operating-intro">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id="operating-model-title">{heading}</h2>
      <p>{subheading}</p>
    </div>

    <ol class="stage-list trace">
      {
        steps.map((stage) => (
          <li>
            <span class="trace-node" aria-hidden="true">
              {stage.step}
            </span>
            <div class="trace-body">
              {stage.label && <p class="trace-label">{stage.label}</p>}
              <h3>{stage.title}</h3>
              <p class="trace-copy">{stage.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  h2:first-child {
    margin-top: 0;
  }

  .operating-model {
    padding-block: var(--section-space);
    border-block-end: var(--border-width) solid var(--color-border);
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }

  .operating-container {
    display: grid;
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
    grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
    align-items: start;
    gap: clamp(3rem, 9vw, 8rem);
  }

  .operating-intro {
    position: sticky;
    top: calc(var(--header-offset) + 2rem);
  }

  .eyebrow {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
  }

  h2 {
    max-width: 20ch;
    margin: 0.75rem 0 0;
    color: var(--color-light);
    font-family: var(--font-sans);
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .operating-intro > p:last-child {
    max-width: 54ch;
    margin: 1.25rem 0 0;
    color: var(--color-text-inverse-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: 1.65;
    text-wrap: pretty;
  }

  /* Friction Trace: one continuous path, square numbered nodes, and an
     annotation naming what each step produces. The logo dot marks where the
     work starts, once. */
  .trace {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trace li {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: clamp(1rem, 3vw, 1.75rem);
    padding-bottom: clamp(2rem, 4vw, 2.75rem);
  }

  .trace li:last-child {
    padding-bottom: 0;
  }

  .trace li::before {
    position: absolute;
    top: 2.5rem;
    bottom: 0;
    left: calc(1.25rem - 0.5px);
    width: 1px;
    background: var(--color-border-strong);
    content: "";
  }

  .trace li:last-child::before {
    display: none;
  }

  .trace-node {
    position: relative;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface-pure);
    color: var(--color-text);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .trace li:first-child .trace-node::after {
    position: absolute;
    top: -0.3125rem;
    right: -0.3125rem;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--color-yellow);
    box-shadow: 0 0 0 2px var(--color-surface-subtle);
    content: "";
  }

  .trace-label {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0.375rem 0 0;
    color: var(--color-light);
    font-family: var(--font-sans);
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: var(--lh-h4);
    text-wrap: balance;
  }

  .trace-copy {
    max-width: 52ch;
    margin: 0.5rem 0 0;
    color: var(--color-text-inverse-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: 1.6;
    text-wrap: pretty;
  }

  @media (max-width: 58rem) {
    .operating-container {
      grid-template-columns: 1fr;
    }

    .operating-intro {
      position: static;
    }
  }

  @media (forced-colors: active) {
    .operating-model,
    .trace-node {
      border-color: CanvasText;
      background: Canvas;
      color: CanvasText;
    }

    .trace li::before {
      background: CanvasText;
    }
  }
</style>
