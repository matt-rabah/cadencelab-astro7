---
// src/components/OperatingModel.astro
import { cn } from "@/lib/utils";

interface Stage {
  step: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  steps?: Stage[];
  className?: string;
}

const {
  eyebrow = "Operating Model",
  heading = "Let the evidence determine the recommendation.",
  subheading = "Cadence Lab connects strategy to the way work is owned, performed, governed, and measured. Technology should support that operating model and make the work easier to manage.",
  steps = [
    {
      step: "01",
      title: "Diagnose the operating environment",
      description:
        "Trace the customer problem through teams, systems, data, decisions, and frontline work before prescribing a solution.",
    },
    {
      step: "02",
      title: "Align the decisions",
      description:
        "Define the outcome, accountable owners, decision rights, constraints, and sequence of changes before implementation begins.",
    },
    {
      step: "03",
      title: "Rebuild the workflow",
      description:
        "Translate the decision into usable handoffs, CRM requirements, governance, team practices, and appropriate AI support.",
    },
    {
      step: "04",
      title: "Measure and adapt",
      description:
        "Connect customer, workflow, adoption, and performance signals to the change, then refine the system as evidence develops.",
    },
  ],
  className = "",
} = Astro.props;
---

<section
  class={cn("operating-model", className)}
  id="operating-model"
  aria-labelledby="operating-model-title"
>
  <div class="operating-container">
    <div class="operating-intro">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="operating-model-title">{heading}</h2>
      <p>{subheading}</p>
    </div>

    <ol class="stage-list">
      {
        steps.map((stage) => (
          <li>
            <p class="stage-number" aria-hidden="true">
              {stage.step}
            </p>
            <h3>{stage.title}</h3>
            <p>{stage.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .operating-model {
    padding-block: var(--section-space);
    border-block-end: var(--border-width) solid var(--color-border);
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }

  .operating-container {
    display: grid;
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
    grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
    align-items: start;
    gap: clamp(3rem, 9vw, 8rem);
  }

  .operating-intro {
    position: sticky;
    top: calc(var(--header-offset) + 2rem);
  }

  .eyebrow,
  .stage-number {
    margin: 0;
    color: var(--color-green);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 20ch;
    margin: 0.75rem 0 0;
    color: var(--color-light);
    font-family: var(--font-sans);
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .operating-intro > p:last-child {
    max-width: 54ch;
    margin: 1.25rem 0 0;
    color: var(--color-text-inverse-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .stage-list {
    display: grid;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block-start: var(--border-width) solid rgb(255 255 255 / 28%);
    border-inline-start: var(--border-width) solid rgb(255 255 255 / 28%);
    list-style: none;
  }

  .stage-list li {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-inline-end: var(--border-width) solid rgb(255 255 255 / 28%);
    border-block-end: var(--border-width) solid rgb(255 255 255 / 28%);
  }

  h3 {
    margin: 1.5rem 0 0;
    color: var(--color-light);
    font-family: var(--font-sans);
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: var(--lh-h4);
    text-wrap: balance;
  }

  .stage-list li > p:last-child {
    margin: 0.75rem 0 0;
    color: var(--color-text-inverse-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  @media (max-width: 58rem) {
    .operating-container {
      grid-template-columns: 1fr;
    }

    .operating-intro {
      position: static;
    }
  }

  @media (max-width: 40rem) {
    .stage-list {
      grid-template-columns: 1fr;
    }
  }

  @media (forced-colors: active) {
    .operating-model,
    .stage-list,
    .stage-list li {
      border-color: CanvasText;
      background: Canvas;
      color: CanvasText;
    }
  }
</style>
