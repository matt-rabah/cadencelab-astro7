---
interface PanelDetail {
  label: string;
  value: string;
}

interface PanelLink {
  label: string;
  href: string;
}

export interface TabPanel {
  id: string;
  label: string;
  number?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  details?: PanelDetail[];
  listLabel?: string;
  items?: string[];
  link?: PanelLink;
}

interface Props {
  idPrefix: string;
  label: string;
  panels: TabPanel[];
  theme?: "light" | "dark";
}

const { idPrefix, label, panels, theme = "light" } = Astro.props;
---

<content-tabs class="content-tabs" data-theme={theme}>
  <div class="tab-list-wrap">
    <div class="tab-list" data-tab-list aria-label={label}>
      {
        panels.map((panel) => (
          <button
            id={`${idPrefix}-tab-${panel.id}`}
            class="tab-trigger"
            type="button"
            data-tab
            aria-controls={panel.id}
          >
            {panel.number && <span aria-hidden="true">{panel.number}</span>}
            <span>{panel.label}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="tab-panels">
    {
      panels.map((panel) => (
        <article
          id={panel.id}
          class="tab-panel"
          data-panel
          aria-labelledby={`${idPrefix}-tab-${panel.id}`}
        >
          <div class="panel-heading">
            <div class="panel-meta">
              {panel.number && <p class="panel-number">{panel.number}</p>}
              {panel.eyebrow && <p class="panel-eyebrow">{panel.eyebrow}</p>}
            </div>
            <h3>{panel.title}</h3>
            {panel.description && (
              <p class="panel-description">{panel.description}</p>
            )}
          </div>

          {panel.details && panel.details.length > 0 && (
            <dl class="panel-details">
              {panel.details.map((detail) => (
                <div>
                  <dt>{detail.label}</dt>
                  <dd>{detail.value}</dd>
                </div>
              ))}
            </dl>
          )}

          {panel.items && panel.items.length > 0 && (
            <div class="panel-list">
              {panel.listLabel && <p>{panel.listLabel}</p>}
              <ul>
                {panel.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )}

          {panel.link && (
            <a class="panel-link" href={panel.link.href}>
              {panel.link.label}
              <span aria-hidden="true">&#8594;</span>
            </a>
          )}
        </article>
      ))
    }
  </div>
</content-tabs>

<script>
  class ContentTabs extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === "true") return;

      const tabList = this.querySelector<HTMLElement>("[data-tab-list]");
      const tabs = Array.from(
        this.querySelectorAll<HTMLButtonElement>("[data-tab]"),
      );
      const panels = Array.from(
        this.querySelectorAll<HTMLElement>("[data-panel]"),
      );

      if (!tabList || tabs.length === 0 || tabs.length !== panels.length) {
        return;
      }

      tabList.setAttribute("role", "tablist");

      const selectTab = (nextIndex: number, moveFocus = false) => {
        tabs.forEach((tab, index) => {
          const selected = index === nextIndex;
          tab.setAttribute("role", "tab");
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
          panels[index].setAttribute("role", "tabpanel");
          panels[index].tabIndex = 0;
          panels[index].hidden = !selected;
        });

        if (moveFocus) tabs[nextIndex].focus();
      };

      const indexFromHash = () =>
        panels.findIndex((panel) => `#${panel.id}` === window.location.hash);

      const initialIndex = indexFromHash();
      selectTab(initialIndex >= 0 ? initialIndex : 0);
      this.dataset.ready = "true";

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => selectTab(index));
        tab.addEventListener("keydown", (event) => {
          let nextIndex = index;

          if (event.key === "ArrowRight") {
            nextIndex = (index + 1) % tabs.length;
          } else if (event.key === "ArrowLeft") {
            nextIndex = (index - 1 + tabs.length) % tabs.length;
          } else if (event.key === "Home") {
            nextIndex = 0;
          } else if (event.key === "End") {
            nextIndex = tabs.length - 1;
          } else {
            return;
          }

          event.preventDefault();
          selectTab(nextIndex, true);
        });
      });

      window.addEventListener("hashchange", () => {
        const nextIndex = indexFromHash();
        if (nextIndex >= 0) selectTab(nextIndex);
      });
    }
  }

  if (!customElements.get("content-tabs")) {
    customElements.define("content-tabs", ContentTabs);
  }
</script>

<style>
  .content-tabs {
    --tabs-accent: var(--color-blue);
    --tabs-signal: #ffce31;

    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-feature-settings: var(--fea-graphik);
  }

  .tab-list-wrap {
    max-width: 100%;
    overflow-x: auto;
    border: var(--border-width) solid var(--color-border-strong);
    border-bottom: 0;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    background: color-mix(
      in oklab,
      var(--tabs-accent) 4%,
      var(--color-surface-muted)
    );
    scrollbar-width: thin;
  }

  .tab-list {
    display: flex;
    width: max-content;
    min-width: 100%;
  }

  .tab-trigger {
    display: inline-flex;
    min-height: var(--control-min-size, 2.75rem);
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem clamp(1rem, 2.5vw, 1.5rem);
    border: 0;
    border-right: var(--border-width) solid var(--color-border);
    border-radius: 0;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.3;
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .tab-trigger::before {
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: transparent;
    content: "";
  }

  .tab-trigger > span:first-child:not(:last-child) {
    color: var(--color-blue);
    font-size: 0.75rem;
    font-feature-settings: var(--fea-tabular);
  }

  .tab-trigger[aria-selected="true"] {
    box-shadow: inset 0 -0.1875rem var(--tabs-accent);
    background: var(--color-surface-pure);
    color: var(--color-ink);
  }

  .tab-trigger[aria-selected="true"]::before {
    background: var(--tabs-signal);
  }

  .tab-trigger:focus-visible,
  .panel-link:focus-visible,
  .tab-panel:focus-visible {
    outline: var(--focus-ring-width, 0.1875rem) solid var(--color-focus);
    outline-offset: calc(var(--focus-ring-offset, 0.1875rem) * -1);
  }

  .tab-panels {
    min-width: 0;
    overflow: clip;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background:
      linear-gradient(
        135deg,
        color-mix(in oklab, var(--tabs-accent) 5%, transparent),
        transparent 42%
      ),
      var(--color-surface-pure);
  }

  .tab-panel {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 3rem);
    scroll-margin-top: calc(var(--header-offset, 8rem) + 1rem);
    opacity: 1;
    translate: 0;
    transition:
      display 180ms,
      opacity 180ms ease-out,
      translate 180ms ease-out;
    transition-behavior: allow-discrete;
  }

  .tab-panel[hidden] {
    display: none;
    opacity: 0;
    translate: 0 0.5rem;
  }

  @starting-style {
    .content-tabs[data-ready="true"] .tab-panel:not([hidden]) {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }

  .panel-heading {
    max-width: 52rem;
  }

  .panel-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .panel-number,
  .panel-eyebrow,
  .panel-list > p {
    margin: 0;
    color: var(--color-blue);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
  }

  .panel-eyebrow {
    color: var(--color-text-muted);
  }

  .tab-panel h3 {
    max-width: 30ch;
    margin: 0.75rem 0 0;
    color: var(--color-ink);
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .panel-description {
    max-width: var(--measure-ui);
    margin: 0.9rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body-ui);
    line-height: var(--lh-ui);
    text-wrap: pretty;
  }

  .panel-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
    overflow: clip;
    border-top: var(--border-width) solid var(--color-border);
    border-left: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .panel-details > div {
    min-width: 0;
    padding: clamp(1rem, 3vw, 1.5rem);
    border-right: var(--border-width) solid var(--color-border);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .panel-details dt {
    color: var(--color-ink);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: 1.4;
  }

  .panel-details dd {
    margin: 0.55rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .panel-list {
    max-width: 52rem;
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
    padding-top: 1.25rem;
    border-top: var(--border-width) solid var(--color-border);
  }

  .panel-list ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 2rem;
    margin: 1rem 0 0;
    padding-inline-start: 1.15rem;
  }

  .panel-list li {
    color: var(--color-text);
    font-size: var(--fs-small);
    line-height: 1.55;
  }

  .panel-list li::marker {
    color: var(--color-blue);
  }

  .panel-link {
    display: inline-flex;
    min-height: var(--control-min-size, 2.75rem);
    align-items: center;
    gap: 0.5rem;
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
    padding: 0.75rem 1rem;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: color-mix(
      in oklab,
      var(--tabs-accent) 5%,
      var(--color-surface-pure)
    );
    color: var(--color-ink);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    text-decoration: none;
    text-underline-offset: 0.25em;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      color var(--transition-fast),
      gap var(--transition-fast);
  }

  .panel-link span {
    color: var(--tabs-accent);
  }

  .content-tabs:not([data-ready="true"]) .tab-list-wrap {
    display: none;
  }

  .content-tabs:not([data-ready="true"]) .tab-panels {
    display: grid;
    gap: 1rem;
    border: 0;
    background: transparent;
  }

  .content-tabs:not([data-ready="true"]) .tab-panel {
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface-pure);
  }

  .content-tabs[data-theme="dark"] {
    color: var(--color-light);
  }

  .content-tabs[data-theme="dark"] .tab-list-wrap {
    border-color: rgb(252 254 255 / 28%);
    background: rgb(252 254 255 / 8%);
  }

  .content-tabs[data-theme="dark"] .tab-trigger {
    border-color: rgb(252 254 255 / 18%);
    color: var(--color-text-inverse-muted);
  }

  .content-tabs[data-theme="dark"]
    .tab-trigger
    > span:first-child:not(:last-child) {
    color: var(--color-green);
  }

  .content-tabs[data-theme="dark"] .tab-trigger[aria-selected="true"] {
    box-shadow: inset 0 -0.1875rem var(--color-green);
    background: var(--color-light);
    color: var(--color-ink);
  }

  .content-tabs[data-theme="dark"] .tab-panels,
  .content-tabs[data-theme="dark"]:not([data-ready="true"]) .tab-panel {
    border-color: rgb(252 254 255 / 28%);
    background: rgb(252 254 255 / 6%);
  }

  .content-tabs[data-theme="dark"] .panel-number,
  .content-tabs[data-theme="dark"] .panel-list > p {
    color: var(--color-green);
  }

  .content-tabs[data-theme="dark"] .panel-eyebrow,
  .content-tabs[data-theme="dark"] .panel-description,
  .content-tabs[data-theme="dark"] .panel-details dd {
    color: var(--color-text-inverse-muted);
  }

  .content-tabs[data-theme="dark"] .tab-panel h3,
  .content-tabs[data-theme="dark"] .panel-details dt,
  .content-tabs[data-theme="dark"] .panel-list li {
    color: var(--color-light);
  }

  .content-tabs[data-theme="dark"] .panel-details,
  .content-tabs[data-theme="dark"] .panel-details > div,
  .content-tabs[data-theme="dark"] .panel-list {
    border-color: rgb(252 254 255 / 22%);
  }

  .content-tabs[data-theme="dark"] .panel-list li::marker {
    color: var(--color-green);
  }

  .content-tabs[data-theme="dark"] .panel-link {
    border-color: rgb(252 254 255 / 36%);
    background: rgb(252 254 255 / 10%);
    color: var(--color-light);
  }

  .content-tabs[data-theme="dark"] .panel-link span {
    color: var(--color-green);
  }

  @media (hover: hover) {
    .tab-trigger:hover {
      background: var(--color-surface-subtle);
      color: var(--color-ink);
    }

    .content-tabs[data-theme="dark"] .tab-trigger:hover {
      background: rgb(252 254 255 / 12%);
      color: var(--color-light);
    }

    .panel-link:hover {
      gap: 0.75rem;
      border-color: var(--tabs-accent);
      background: var(--tabs-accent);
      color: var(--color-light);
    }

    .panel-link:hover span {
      color: currentColor;
    }

    .content-tabs[data-theme="dark"] .panel-link:hover {
      border-color: var(--color-light);
      background: var(--color-light);
      color: var(--color-ink);
    }
  }

  @media (max-width: 44rem) {
    .panel-details,
    .panel-list ul {
      grid-template-columns: 1fr;
    }

    .tab-panel {
      padding: 1.5rem;
    }
  }

  @media (pointer: coarse) {
    .tab-trigger,
    .panel-link {
      min-height: var(--control-min-size-coarse, 3rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-trigger,
    .tab-panel,
    .panel-link {
      transition: none;
    }

    .tab-trigger {
      scroll-behavior: auto;
    }

    .tab-panel,
    .tab-panel[hidden] {
      translate: none;
    }
  }

  @media (forced-colors: active) {
    .tab-list-wrap,
    .tab-trigger,
    .tab-panels,
    .tab-panel,
    .panel-details,
    .panel-details > div,
    .panel-list {
      border-color: CanvasText;
    }

    .tab-trigger[aria-selected="true"] {
      box-shadow: inset 0 -0.1875rem Highlight;
    }

    .tab-panels,
    .panel-link {
      background: Canvas;
    }

    .tab-trigger[aria-selected="true"]::before {
      background: Highlight;
    }
  }
</style>
