---
interface FooterLink {
  label: string;
  href: string;
}

interface FooterSection {
  title: string;
  id: string;
  links: FooterLink[];
}

const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname;

const footerSections: FooterSection[] = [
  {
    title: "Workflows",
    id: "footer-workflows-label",
    links: [
      {
        label: "Salesforce tracing",
        href: "/workflows/salesforce/",
      },
      {
        label: "Cross-functional links",
        href: "/workflows/cross-functional/",
      },
      {
        label: "SLA escalation maps",
        href: "/workflows/escalation/",
      },
      {
        label: "AI-to-human routing",
        href: "/workflows/agent-routing/",
      },
    ],
  },
  {
    title: "Solutions",
    id: "footer-solutions-label",
    links: [
      {
        label: "User adoption fatigue",
        href: "/solutions/adoption-fatigue/",
      },
      {
        label: "Siloed and dirty CRM pipelines",
        href: "/solutions/dirty-data/",
      },
      {
        label: "Executive misalignment",
        href: "/solutions/misalignment/",
      },
      {
        label: "Enterprise frameworks",
        href: "/solutions/enterprise/",
      },
    ],
  },
  {
    title: "AI tooling",
    id: "footer-ai-tooling-label",
    links: [
      {
        label: "Prompt firewalls",
        href: "/ai-tooling/prompt-guard/",
      },
      {
        label: "Variance tracing",
        href: "/ai-tooling/hallucination/",
      },
      {
        label: "PII scrubbing nodes",
        href: "/ai-tooling/compliance/",
      },
      {
        label: "Agent copilots",
        href: "/ai-tooling/co-pilot/",
      },
    ],
  },
];

const legalLinks: FooterLink[] = [
  {
    label: "Privacy policy",
    href: "/privacy/",
  },
  {
    label: "Terms of service",
    href: "/terms/",
  },
  {
    label: "System governance",
    href: "/governance/",
  },
];

const normalizePath = (path: string): string => {
  if (path === "/") return "/";
  return path.endsWith("/") ? path : `${path}/`;
};

const isCurrentPage = (href: string): boolean =>
  normalizePath(currentPath) === normalizePath(href);
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-primary">
      <div class="footer-brand">
        <a
          href="/"
          class="footer-logo-link"
          aria-label="Cadence Lab home"
          aria-current={isCurrentPage("/") ? "page" : undefined}
        >
          <img
            src="/brand/cadencelab-wordmark-dark.svg"
            alt="Cadence Lab"
            width="3858"
            height="500"
            loading="lazy"
            decoding="async"
            class="footer-logo"
          />
        </a>

        <p class="footer-description">
          Cadence Lab helps organizations improve customer experience by
          aligning workflows, systems, teams, and applied AI.
        </p>

        <a
          href="/contact/"
          class="footer-contact-link"
          aria-current={isCurrentPage("/contact/") ? "page" : undefined}
        >
          <span>Start a conversation</span>
          <svg
            aria-hidden="true"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M2.5 8h10"></path>
            <path d="m8.75 4.25 3.75 3.75-3.75 3.75"></path>
          </svg>
        </a>
      </div>

      {
        footerSections.map((section) => (
          <nav class="footer-section" aria-labelledby={section.id}>
            <h2 id={section.id} class="footer-section-label">
              {section.title}
            </h2>

            <ul class="footer-link-list">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={isCurrentPage(link.href) ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer-secondary">
      <p class="footer-copyright">
        <span>&copy; {currentYear} Cadence Lab.</span>
        <span>All rights reserved.</span>
      </p>

      <nav class="footer-legal" aria-label="Legal">
        <ul class="legal-link-list">
          {
            legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrentPage(link.href) ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* APCA Contrast Tokens ($Lc 90+ for text, $Lc 45+ for boundaries) */
    --footer-background: #000504;
    --footer-heading: #ffffff;
    --footer-text: #d0dad7; /* APCA $Lc 88 on #000504 */
    --footer-muted: #aeb9b6; /* APCA $Lc 78 on #000504 */
    --footer-subtle: #8e9b98;
    --footer-border: rgb(252 254 255 / 18%);
    --footer-accent: #a3aaff;
    --footer-focus: #ffffff;

    width: 100%;
    padding: clamp(4rem, 10vw, 7.5rem) var(--page-gutter, 1.5rem)
      clamp(2.5rem, 6vw, 3.5rem);
    border-top: var(--border-width, 1px) solid var(--footer-border);
    background: var(--footer-background);
    color: var(--footer-text);
    font-family: var(--ff-sans);
    font-feature-settings: var(--fea-graphik);
    text-align: left;
  }

  .footer-container {
    width: min(100%, var(--container-page, 80rem));
    margin-inline: auto;
  }

  .footer-primary {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem;
    text-align: left;
  }

  .footer-brand,
  .footer-section {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .footer-logo-link {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: var(--control-min-size, 3rem);
    color: inherit;
    text-decoration: none;
  }

  .footer-logo {
    display: block;
    width: clamp(10rem, 15vw, 12rem);
    height: auto;
  }

  .footer-description {
    max-width: 32rem;
    margin: 1.25rem 0 0;
    color: var(--footer-text);
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.7;
    text-align: left;
    text-wrap: pretty;
  }

  .footer-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    min-height: var(--control-min-size, 3rem);
    margin-top: 1.5rem;
    color: var(--footer-heading);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-color: var(--footer-accent);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.3em;
    transition: color var(--transition-fast, 150ms ease);
  }

  .footer-contact-link svg {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    transition: transform var(--transition-fast, 150ms ease);
  }

  .footer-contact-link:hover {
    color: #ffffff;
  }

  .footer-contact-link:hover svg {
    transform: translateX(0.25rem);
  }

  .footer-section-label {
    margin: 0 0 1.25rem;
    color: var(--footer-heading);
    font-family: var(--ff-sans);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: left;
  }

  .footer-link-list,
  .legal-link-list {
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .footer-link-list {
    display: grid;
    gap: 0.25rem;
  }

  .footer-link-list a {
    display: flex;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    min-height: var(--control-min-size, 3rem);
    padding-block: 0.375rem;
    color: var(--footer-text);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.25em;
    transition:
      color var(--transition-fast, 150ms ease),
      text-decoration-color var(--transition-fast, 150ms ease);
  }

  .footer-link-list a:hover {
    color: var(--footer-heading);
    text-decoration-color: var(--footer-accent);
  }

  .footer-link-list a[aria-current="page"] {
    color: var(--footer-heading);
    font-weight: 600;
    text-decoration-color: var(--footer-accent);
    text-decoration-thickness: 0.12em;
  }

  .footer-secondary {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
    padding-top: 2rem;
    border-top: var(--border-width, 1px) solid var(--footer-border);
    text-align: left;
  }

  .footer-copyright {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    color: var(--footer-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.5;
    text-align: left;
  }

  .legal-link-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
  }

  .legal-link-list li {
    display: inline-flex;
    align-items: center;
  }

  .legal-link-list li:not(:last-child)::after {
    content: "";
    flex: 0 0 auto;
    width: 0.2rem;
    height: 0.2rem;
    margin-inline: 0.85rem;
    border-radius: 50%;
    background: var(--footer-subtle);
  }

  .legal-link-list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-min-size, 3rem);
    color: var(--footer-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: color var(--transition-fast, 150ms ease);
  }

  .legal-link-list a:hover,
  .legal-link-list a[aria-current="page"] {
    color: var(--footer-heading);
    text-decoration-color: var(--footer-accent);
  }

  .site-footer a:focus-visible {
    outline: 2px solid var(--footer-focus);
    outline-offset: 3px;
  }

  @media (min-width: 40rem) {
    .footer-primary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(3rem, 7vw, 5rem);
      row-gap: 3.5rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-secondary {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2rem;
    }

    .legal-link-list {
      justify-content: flex-end;
    }
  }

  @media (min-width: 70rem) {
    .footer-primary {
      grid-template-columns: minmax(18rem, 1.5fr) repeat(3, minmax(0, 1fr));
      gap: clamp(2.5rem, 4.5vw, 5rem);
      align-items: start;
    }

    .footer-brand {
      grid-column: auto;
    }

    .footer-description {
      max-width: 23rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-contact-link,
    .footer-contact-link svg,
    .footer-link-list a,
    .legal-link-list a {
      transition: none;
    }

    .footer-contact-link:hover svg {
      transform: none;
    }
  }
</style>
