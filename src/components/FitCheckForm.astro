---
// src/components/FitCheckForm.astro
import { cn } from "@/lib/utils";

interface Props {
  badge?: string;
  heading?: string;
  description?: string;
  benefits?: string[];
  className?: string;
}

const {
  badge = "Fit Check™",
  heading = "Decide whether your problem is ready for a diagnostic",
  description = "Share the teams, systems, and operating friction involved. We assess fit directly and won't recommend a diagnostic unless there is a clear path to value.",
  benefits = [
    "Direct assessment of whether a diagnostic is right for your team.",
    "Zero high-pressure sales follow-ups or spam.",
    "Tailored recommendations on cross-functional alignment.",
  ],
  className = "",
} = Astro.props;

const hasBenefits = Array.isArray(benefits) && benefits.length > 0;
---

<section
  class={cn(
    "py-20 md:py-32 bg-background text-foreground border-b border-black/10",
    className,
  )}
  id="fit-check">
  <div class="container mx-auto px-6 max-w-6xl">
    <div
      class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16 items-start text-left">
      <!-- Left Column: Executive Copy & Principles -->
      <div class="lg:col-span-5 flex flex-col gap-6 items-start text-left">
        <div>
          <span
            class="text-xs font-mono font-bold uppercase tracking-widest text-[#1823c9] mb-4 block">
            {badge}
          </span>
          <h2
            class="text-3xl sm:text-4xl font-bold tracking-tight text-black text-left leading-tight">
            {heading}
          </h2>
          <p class="mt-6 text-base text-[#4a5056] text-left leading-relaxed">
            {description}
          </p>
        </div>

        {
          hasBenefits && (
            <ul class="flex flex-col gap-4 mt-2 text-left" role="list">
              {benefits.map((benefit) => (
                <li class="flex items-start gap-3 text-left">
                  <span
                    class="flex size-4 shrink-0 items-center justify-center rounded-xs bg-black text-white text-[10px] font-bold mt-1"
                    aria-hidden="true">
                    ✓
                  </span>
                  <span class="text-sm font-medium text-black text-left leading-relaxed">
                    {benefit}
                  </span>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <!-- Right Column: Flat Corporate Form Container -->
      <div
        class="lg:col-span-7 rounded-xs border border-black/10 bg-[#f8f9fa] p-8 sm:p-12 shadow-none w-full">
        <form
          action="/fit-check/"
          method="POST"
          class="flex flex-col gap-6 text-left"
          novalidate>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <!-- First Name -->
            <div class="flex flex-col gap-2 text-left">
              <label
                for="firstName"
                class="text-xs font-bold uppercase tracking-wider text-black text-left">
                First Name <span class="text-[#9f1c12]" aria-hidden="true"
                  >*</span
                >
              </label>
              <input
                id="firstName"
                name="firstName"
                type="text"
                autocomplete="given-name"
                required
                aria-required="true"
                class="flex h-12 w-full rounded-xs border border-black/15 bg-white px-4 py-3 text-base sm:text-sm text-black placeholder:text-[#6c757d] focus-visible:outline-none focus-visible:border-[#1823c9] focus-visible:ring-1 focus-visible:ring-[#1823c9]"
              />
            </div>

            <!-- Last Name -->
            <div class="flex flex-col gap-2 text-left">
              <label
                for="lastName"
                class="text-xs font-bold uppercase tracking-wider text-black text-left">
                Last Name <span class="text-[#9f1c12]" aria-hidden="true"
                  >*</span
                >
              </label>
              <input
                id="lastName"
                name="lastName"
                type="text"
                autocomplete="family-name"
                required
                aria-required="true"
                class="flex h-12 w-full rounded-xs border border-black/15 bg-white px-4 py-3 text-base sm:text-sm text-black placeholder:text-[#6c757d] focus-visible:outline-none focus-visible:border-[#1823c9] focus-visible:ring-1 focus-visible:ring-[#1823c9]"
              />
            </div>
          </div>

          <!-- Work Email -->
          <div class="flex flex-col gap-2 text-left">
            <label
              for="email"
              class="text-xs font-bold uppercase tracking-wider text-black text-left">
              Work Email <span class="text-[#9f1c12]" aria-hidden="true">*</span
              >
            </label>
            <input
              id="email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              required
              aria-required="true"
              placeholder="alex@company.com"
              class="flex h-12 w-full rounded-xs border border-black/15 bg-white px-4 py-3 text-base sm:text-sm text-black placeholder:text-[#6c757d] focus-visible:outline-none focus-visible:border-[#1823c9] focus-visible:ring-1 focus-visible:ring-[#1823c9]"
            />
          </div>

          <!-- Organization -->
          <div class="flex flex-col gap-2 text-left">
            <label
              for="company"
              class="text-xs font-bold uppercase tracking-wider text-black text-left">
              Company / Organization <span
                class="text-[#9f1c12]"
                aria-hidden="true">*</span
              >
            </label>
            <input
              id="company"
              name="company"
              type="text"
              autocomplete="organization"
              required
              aria-required="true"
              class="flex h-12 w-full rounded-xs border border-black/15 bg-white px-4 py-3 text-base sm:text-sm text-black placeholder:text-[#6c757d] focus-visible:outline-none focus-visible:border-[#1823c9] focus-visible:ring-1 focus-visible:ring-[#1823c9]"
            />
          </div>

          <!-- Problem Description -->
          <div class="flex flex-col gap-2 text-left">
            <label
              for="message"
              class="text-xs font-bold uppercase tracking-wider text-black text-left">
              Operating problem & systems involved <span
                class="text-[#9f1c12]"
                aria-hidden="true">*</span
              >
            </label>
            <p id="message-hint" class="text-xs text-[#4a5056] text-left">
              Include platforms involved (e.g., Salesforce, HubSpot, Zendesk)
              and impacted teams.
            </p>
            <textarea
              id="message"
              name="message"
              aria-describedby="message-hint"
              rows={4}
              required
              aria-required="true"
              class="flex min-h-28 w-full rounded-xs border border-black/15 bg-white p-4 text-base sm:text-sm text-black placeholder:text-[#6c757d] focus-visible:outline-none focus-visible:border-[#1823c9] focus-visible:ring-1 focus-visible:ring-[#1823c9]"
            ></textarea>
          </div>

          <!-- Submit Button & Governance Assurance -->
          <div class="flex flex-col gap-4 mt-2 text-left">
            <button
              type="submit"
              class="inline-flex h-12 w-full items-center justify-center rounded-xs bg-black px-8 text-sm font-semibold text-white transition-colors hover:bg-[#1823c9] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#1823c9] focus-visible:ring-offset-2 no-underline!"
              style="color: #ffffff !important; text-decoration: none !important;">
              Submit Fit Check Request
            </button>

            <p
              class="text-xs text-[#4a5056] text-left leading-normal flex items-center gap-1.5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 text-black"
                aria-hidden="true"
                ><rect width="18" height="11" x="3" y="11" rx="2" ry="2"
                ></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
              >
              <span
                >Protected under our <a
                  href="/privacy/"
                  class="underline text-black hover:text-[#1823c9]"
                  >Privacy Policy</a
                >. No spam.</span
              >
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
