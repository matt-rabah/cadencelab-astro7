---
// src/components/FitCheckForm.astro
import { cn } from "@/lib/utils";

interface Props {
  badge?: string;
  heading?: string;
  description?: string;
  benefits?: string[];
  className?: string;
}

const {
  badge = "Fit Check™",
  heading = "Decide whether your problem is ready for a diagnostic",
  description = "Share the teams, systems, and operating friction involved. We assess fit directly and won't recommend a diagnostic unless there is a clear path to value.",
  benefits = [
    "Direct assessment of whether a diagnostic is right for your team.",
    "Zero high-pressure sales follow-ups or spam.",
    "Tailored recommendations on cross-functional alignment.",
  ],
  className = "",
} = Astro.props;

const hasBenefits = Array.isArray(benefits) && benefits.length > 0;
---

<section
  class={cn("fit-check", className)}
  id="fit-check"
  aria-labelledby="fit-check-title"
>
  <div class="fit-check-container">
    <div class="fit-check-copy">
      <p class="eyebrow">{badge}</p>
      <h2 id="fit-check-title">{heading}</h2>
      <p class="description">{description}</p>

      {
        hasBenefits && (
          <ul role="list">
            {benefits.map((benefit) => (
              <li>
                <span class="benefit-marker" aria-hidden="true">
                  &#10003;
                </span>
                <span>{benefit}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <aside class="fit-check-action" aria-labelledby="fit-check-action-title">
      <div class="action-heading">
        <span class="signal-dot" aria-hidden="true"></span>
        <p id="fit-check-action-title">Before you begin</p>
      </div>

      <dl>
        <div>
          <dt>Time</dt>
          <dd>About five minutes</dd>
        </div>
        <div>
          <dt>Useful context</dt>
          <dd>The customer problem, affected teams, systems, and sponsor</dd>
        </div>
        <div>
          <dt>What happens next</dt>
          <dd>Matt reviews the context and responds directly</dd>
        </div>
      </dl>

      <a class="button" href="/fit-check/">
        Start the Fit Check
        <span aria-hidden="true">&#8594;</span>
      </a>

      <p class="privacy-note">
        Responses are used only to assess fit and reply. Review the
        <a href="/privacy/">privacy policy</a>.
      </p>
    </aside>
  </div>
</section>

<style>
  .fit-check {
    padding-block: var(--section-space);
    border-block-end: var(--border-width) solid var(--color-border);
    background:
      linear-gradient(
        135deg,
        color-mix(in oklab, var(--color-blue) 6%, transparent),
        transparent 48%
      ),
      var(--color-surface);
  }

  .fit-check-container {
    display: grid;
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
    grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.72fr);
    align-items: start;
    gap: clamp(3rem, 9vw, 8rem);
  }

  .eyebrow,
  .action-heading p {
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 22ch;
    margin: 0.75rem 0 0;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .description {
    max-width: 60ch;
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: 1.65;
    text-wrap: pretty;
  }

  ul {
    display: grid;
    gap: 0.875rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.55;
  }

  .benefit-marker {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    border: var(--border-width) solid var(--color-ink);
    border-radius: var(--radius-md);
    background: var(--color-ink);
    color: var(--color-light);
    font-size: 0.75rem;
    place-items: center;
  }

  .fit-check-action {
    overflow: clip;
    border: var(--border-width) solid var(--color-border-strong);
    border-block-start: 0.25rem solid var(--color-blue);
    border-radius: var(--radius-lg);
    background: color-mix(
      in oklab,
      var(--color-blue) 4%,
      var(--color-surface-pure)
    );
  }

  .action-heading {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 1.25rem 1.5rem;
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .signal-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #ffce31;
  }

  dl {
    margin: 0;
  }

  dl > div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-block-end: var(--border-width) solid var(--color-border);
  }

  dt,
  dd {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  dt {
    color: var(--color-text-muted);
  }

  dd {
    color: var(--color-ink);
    font-weight: var(--fw-medium);
  }

  .button {
    display: flex;
    min-height: var(--control-min-size);
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 1.5rem;
    padding: 0.8rem 1rem;
    border: var(--border-width) solid var(--color-ink);
    border-radius: var(--radius-md);
    background: var(--color-ink);
    color: var(--color-light);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .privacy-note {
    margin: 0;
    padding: 0 1.5rem 1.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    line-height: 1.55;
  }

  .privacy-note a {
    color: var(--color-ink);
    text-underline-offset: 0.2em;
  }

  :where(.button, .privacy-note a):focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  @media (hover: hover) {
    .button:hover {
      border-color: var(--color-blue);
      background: var(--color-blue);
    }

    .privacy-note a:hover {
      color: var(--color-blue);
    }
  }

  @media (max-width: 58rem) {
    .fit-check-container {
      grid-template-columns: 1fr;
    }

    .fit-check-action {
      max-width: 42rem;
    }
  }

  @media (max-width: 40rem) {
    dl > div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  @media (pointer: coarse) {
    .button {
      min-height: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .fit-check,
    .fit-check-action,
    .action-heading,
    dl > div,
    .button,
    .benefit-marker {
      border-color: CanvasText;
      background: Canvas;
      color: CanvasText;
    }

    .signal-dot {
      background: Highlight;
    }
  }
</style>
