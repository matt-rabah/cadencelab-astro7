---
// src/components/FitCheckForm.astro
import { cn } from "@/lib/utils";

interface Props {
  badge?: string;
  heading?: string;
  description?: string;
  benefits?: string[];
  className?: string;
}

const {
  badge = "Fit Check",
  heading = "Decide whether your problem is ready for a diagnostic",
  description = "Share the teams, systems, and operating friction involved. We assess fit directly and won't recommend a diagnostic unless there is a clear path to value.",
  benefits = [
    "Direct assessment of whether a diagnostic is right for your team.",
    "Zero high-pressure sales follow-ups or spam.",
    "Tailored recommendations on cross-functional alignment.",
  ],
  className = "",
} = Astro.props;

const hasBenefits = Array.isArray(benefits) && benefits.length > 0;
---

<section class={cn("py-20 bg-background", className)} id="fit-check">
  <div class="container mx-auto px-4">
    <div
      class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-8 max-w-6xl mx-auto items-start">
      <div class="flex flex-col gap-6">
        <div>
          <span
            class="inline-block px-3 py-1 text-xs font-semibold tracking-wider text-primary uppercase bg-muted rounded-full mb-4">
            {badge}
          </span>
          <h2
            class="text-3xl font-bold tracking-tight text-foreground md:text-4xl">
            {heading}
          </h2>
          <p class="mt-4 text-muted-foreground text-base leading-relaxed">
            {description}
          </p>
        </div>

        {
          hasBenefits && (
            <ul class="flex flex-col gap-4 mt-2">
              {benefits.map((benefit) => (
                <li class="flex items-start gap-3">
                  <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary mt-0.5">
                    ✓
                  </span>
                  <span class="text-sm font-medium text-foreground">
                    {benefit}
                  </span>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div
        class="rounded-xl border border-border bg-card/60 p-6 sm:p-8 shadow-sm">
        <form class="flex flex-col gap-5">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label
                for="firstName"
                class="text-sm font-medium leading-none text-foreground"
                >First Name</label
              >
              <input
                id="firstName"
                name="firstName"
                type="text"
                placeholder="Alex"
                required
                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
              />
            </div>
            <div class="flex flex-col gap-2">
              <label
                for="lastName"
                class="text-sm font-medium leading-none text-foreground"
                >Last Name</label
              >
              <input
                id="lastName"
                name="lastName"
                type="text"
                placeholder="Smith"
                required
                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
              />
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label
              for="email"
              class="text-sm font-medium leading-none text-foreground"
              >Work Email</label
            >
            <input
              id="email"
              name="email"
              type="email"
              placeholder="alex@company.com"
              required
              class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label
              for="company"
              class="text-sm font-medium leading-none text-foreground"
              >Company / Organization</label
            >
            <input
              id="company"
              name="company"
              type="text"
              placeholder="Acme Corp"
              required
              class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label
              for="message"
              class="text-sm font-medium leading-none text-foreground"
              >Describe your operating problem & systems involved</label
            >
            <textarea
              id="message"
              name="message"
              placeholder="e.g. Onboarding handoffs between Sales and CS are losing context in Salesforce..."
              rows={4}
              required
              class="flex min-h-20 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
            ></textarea>
          </div>

          <button
            type="submit"
            class="inline-flex h-11 w-full items-center justify-center rounded-md bg-primary px-8 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring mt-2">
            Submit Fit Check Request
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
