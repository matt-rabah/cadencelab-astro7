---
// src/components/Stats.astro
import BrandHeading from "./BrandHeading.astro";
import { cn } from "@/lib/utils";

interface StatItem {
  /** FitCheck™ starting-point id (see src/pages/fit-check.astro). */
  id: string;
  problem: string;
  description: string;
  valueStream: string;
  service: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  stats?: StatItem[];
  className?: string;
}

// Each card is one of the four value pillars. The order doesn't matter, so
// the cards aren't numbered. Each names the business value stream it
// protects before naming the diagnostic.
const {
  eyebrow = "",
  heading = "Start with the problem, not the platform.",
  subheading = "New software won’t fix a broken handoff. Pick the problem that sounds like yours.",
  stats = [
    {
      id: "prove-value",
      problem: "We can’t prove CX is worth the budget.",
      description:
        "Scores go up and down, and nobody can say what they’re worth. I tie your CX data to the revenue and retention data in your CRM so the case holds up.",
      valueStream: "Retention and budget",
      service: "CRM Workflow Audit",
      href: "/services/crm-workflow-audit/",
    },
    {
      id: "insight-action",
      problem: "We have the insights. Nothing changes.",
      description:
        "The same themes show up every quarter because nobody owns the fix. I find the handoff that keeps creating them and give it an owner.",
      valueStream: "Cost to serve and retention",
      service: "CX Systems Diagnostic",
      href: "/services/cx-systems-diagnostic/",
    },
    {
      id: "silent-churn",
      problem: "Customers leave without telling us.",
      description:
        "Onboarding stalls and accounts go quiet long before they cancel. I find the warning signs while there’s still time to act.",
      valueStream: "Retention and expansion",
      service: "Lifecycle Risk Review",
      href: "/services/lifecycle-risk-review/",
    },
    {
      id: "ai-trust",
      problem: "We’re rolling out AI and can’t get it wrong.",
      description:
        "Is the workflow ready for AI? Find out, and decide where people need to stay in the loop before customers find the gaps for you.",
      valueStream: "Cost to serve and customer trust",
      service: "AI Service Readiness Review",
      href: "/services/ai-service-readiness-review/",
    },
  ],
  className = "",
} = Astro.props;
---

<section
  class={cn("diagnostics", className)}
  id="diagnostics"
  aria-labelledby="diagnostics-title"
>
  <div class="diagnostics-container">
    <div class="diagnostics-intro">
      <div>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2 id="diagnostics-title"><BrandHeading text={heading} /></h2>
      </div>
      <p>{subheading}</p>
    </div>

    <ul class="diagnostic-list" role="list">
      {
        stats.map((stat) => (
          <li>
            <article aria-labelledby={`diagnostic-${stat.id}`}>
              <h3 id={`diagnostic-${stat.id}`}>{stat.problem}</h3>
              <p class="diagnostic-description">{stat.description}</p>
              <dl class="diagnostic-meta">
                <div>
                  <dt>Protects</dt>
                  <dd>{stat.valueStream}</dd>
                </div>
                <div>
                  <dt>Diagnostic</dt>
                  <dd>{stat.service}</dd>
                </div>
              </dl>
              <div class="diagnostic-links">
                <a href={stat.href}>
                  <span>See the {stat.service}</span>
                  <span class="arrow" aria-hidden="true">
                    &#8594;
                  </span>
                </a>
                <a
                  class="diagnostic-start"
                  href={`/fit-check/?start=${stat.id}#fit-check-form-title`}
                >
                  Start the FitCheck™ here
                </a>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

  </div>
</section>

<style>
  h2:first-child {
    margin-top: 0;
  }

  .diagnostics {
    padding-block: var(--section-space);
    border-block-end: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
  }

  .diagnostics-container {
    display: grid;
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .diagnostics-intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .eyebrow {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
  }

  h2 {
    max-width: 22ch;
    margin: 0.75rem 0 0;
    color: var(--color-ink);
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .diagnostics-intro > p {
    max-width: 58ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body);
    line-height: 1.65;
    text-wrap: pretty;
  }

  /* Editorial rows, not a card wall (DESIGN.md, section 6): the problem in
     the customer's words, why it matters, what's at risk, and the action. */
  .diagnostic-list {
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--color-ink);
    list-style: none;
  }

  .diagnostic-list > li {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  article {
    display: grid;
    grid-template-areas:
      "problem copy meta"
      "problem links meta";
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr);
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
    row-gap: 1rem;
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  h3 {
    grid-area: problem;
    max-width: 18ch;
    margin: 0;
    color: var(--color-ink);
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h3);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .diagnostic-description {
    grid-area: copy;
    max-width: 52ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-body);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .diagnostic-meta {
    display: grid;
    grid-area: meta;
    align-content: start;
    gap: 1rem;
    margin: 0;
  }

  .diagnostic-meta dt {
    color: var(--color-text-muted);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
  }

  .diagnostic-meta dd {
    margin: 0.25rem 0 0;
    color: var(--color-ink);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
  }

  .diagnostic-links {
    display: flex;
    flex-wrap: wrap;
    grid-area: links;
    align-items: center;
    align-self: end;
    column-gap: 1.5rem;
    row-gap: 0.25rem;
  }

  a {
    display: inline-flex;
    min-height: var(--control-min-size);
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    text-decoration-color: var(--color-blue);
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.22em;
    transition: color var(--transition-fast);
  }

  .diagnostic-start {
    color: var(--color-text-muted);
    text-decoration-color: currentColor;
    text-decoration-thickness: 0.06em;
  }

  .arrow {
    color: var(--color-blue);
    text-decoration: none;
  }

  a:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  @media (hover: hover) {
    a:hover {
      color: var(--color-blue);
    }
  }

  @media (max-width: 64rem) {
    article {
      grid-template-areas:
        "problem problem"
        "copy meta"
        "links meta";
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }

    h3 {
      max-width: 28ch;
    }
  }

  @media (max-width: 44rem) {
    .diagnostics-intro {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    article {
      grid-template-areas:
        "problem"
        "copy"
        "meta"
        "links";
      grid-template-columns: 1fr;
    }

    .diagnostic-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (pointer: coarse) {
    a {
      min-height: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .diagnostic-list {
      border-color: CanvasText;
    }
  }
</style>
