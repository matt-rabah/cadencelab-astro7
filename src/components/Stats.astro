---
// src/components/Stats.astro
import { cn } from "@/lib/utils";

interface StatItem {
  value: string;
  label: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  stats?: StatItem[];
  className?: string;
}

const {
  eyebrow = "Diagnostic Impact",
  heading = "Choose the operating problem before choosing the technology.",
  subheading = "Each diagnostic starts with one consequential operating question, builds a shared evidence base, and ends with a practical decision.",
  stats = [
    {
      value: "01 / CX Systems",
      label: "Diagnostic Brief",
      description:
        "Map touchpoints and cross-team boundaries to resolve conflicting explanations of friction.",
    },
    {
      value: "02 / Risk Review",
      label: "Lifecycle Risk",
      description:
        "Identify onboarding drift and quiet accounts before useful intervention windows close.",
    },
    {
      value: "03 / Workflow Audit",
      label: "CRM Workflows",
      description:
        "Eliminate process workarounds and clean up untrusted CRM activity signals.",
    },
    {
      value: "04 / AI Readiness",
      label: "Service Readiness",
      description:
        "Establish human-in-the-loop oversight and guardrails prior to AI deployment.",
    },
  ],
  className = "",
} = Astro.props;
---

<section
  class={cn(
    "py-20 md:py-32 bg-background text-foreground border-b border-border/50",
    className,
  )}
  id="diagnostics">
  <div class="container mx-auto px-6 max-w-6xl">
    <!-- Left-aligned Header -->
    <div class="max-w-3xl flex flex-col items-start text-left mb-16">
      <span
        class="text-xs font-mono font-semibold uppercase tracking-widest text-[#1823c9] mb-4">
        {eyebrow}
      </span>
      <h2
        class="text-3xl sm:text-4xl font-bold tracking-tight text-[#000504] text-left leading-tight">
        {heading}
      </h2>
      <p class="mt-6 text-base text-muted-foreground text-left leading-relaxed">
        {subheading}
      </p>
    </div>

    <!-- Spacious 4-Column Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {
        stats.map((stat) => (
          <div class="p-6 rounded-xl border border-border/60 bg-card/40 flex flex-col justify-between items-start text-left">
            <div>
              <span class="text-xs font-mono font-bold text-[#1823c9] block mb-2">
                {stat.value}
              </span>
              <h3 class="text-lg font-semibold text-[#000504] mb-2 text-left">
                {stat.label}
              </h3>
              <p class="text-xs text-muted-foreground leading-relaxed text-left">
                {stat.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
