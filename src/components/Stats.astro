---
// src/components/Stats.astro
import BrandHeading from "./BrandHeading.astro";
import { cn } from "@/lib/utils";

interface StatItem {
  /** FitCheck™ starting-point id (see src/pages/fit-check.astro). */
  id: string;
  problem: string;
  description: string;
  valueStream: string;
  service: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  stats?: StatItem[];
  className?: string;
}

// Each card is one of the four value pillars. The order doesn't matter, so
// the cards aren't numbered. Each names the business value stream it
// protects before naming the diagnostic.
const {
  eyebrow = "",
  heading = "Start with the problem, not the platform.",
  subheading = "New software won’t fix a broken handoff. Pick the problem that sounds like yours.",
  stats = [
    {
      id: "prove-value",
      problem: "We can’t prove CX is worth the budget.",
      description:
        "Scores go up and down, and nobody can say what they’re worth. I tie your CX data to the revenue and retention data in your CRM so the case holds up.",
      valueStream: "Retention and budget",
      service: "CRM Workflow Audit",
      href: "/services/crm-workflow-audit/",
    },
    {
      id: "insight-action",
      problem: "We have the insights. Nothing changes.",
      description:
        "The same themes show up every quarter because nobody owns the fix. I find the handoff that keeps creating them and give it an owner.",
      valueStream: "Cost to serve and retention",
      service: "CX Systems Diagnostic",
      href: "/services/cx-systems-diagnostic/",
    },
    {
      id: "silent-churn",
      problem: "Customers leave without telling us.",
      description:
        "Onboarding stalls and accounts go quiet long before they cancel. I find the warning signs while there’s still time to act.",
      valueStream: "Retention and expansion",
      service: "Lifecycle Risk Review",
      href: "/services/lifecycle-risk-review/",
    },
    {
      id: "ai-trust",
      problem: "We’re rolling out AI and can’t get it wrong.",
      description:
        "Is the workflow ready for AI? Find out, and decide where people need to stay in the loop before customers find the gaps for you.",
      valueStream: "Cost to serve and customer trust",
      service: "AI Service Readiness Review",
      href: "/services/ai-service-readiness-review/",
    },
  ],
  className = "",
} = Astro.props;
---

<section
  class={cn("diagnostics", className)}
  id="diagnostics"
  aria-labelledby="diagnostics-title"
>
  <div class="diagnostics-container">
    <div class="diagnostics-intro">
      <div>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2 id="diagnostics-title"><BrandHeading text={heading} /></h2>
      </div>
      <p>{subheading}</p>
    </div>

    <ul class="diagnostic-list" role="list">
      {
        stats.map((stat) => (
          <li>
            <article aria-labelledby={`diagnostic-${stat.id}`}>
              <h3 id={`diagnostic-${stat.id}`}>{stat.problem}</h3>
              <p class="diagnostic-description">{stat.description}</p>
              <dl class="diagnostic-meta">
                <div>
                  <dt>Protects</dt>
                  <dd>{stat.valueStream}</dd>
                </div>
                <div>
                  <dt>Diagnostic</dt>
                  <dd>{stat.service}</dd>
                </div>
              </dl>
              <div class="diagnostic-links">
                <a href={stat.href}>
                  <span>See the {stat.service}</span>
                  <span class="arrow" aria-hidden="true">
                    &#8594;
                  </span>
                </a>
                <a
                  class="diagnostic-start"
                  href={`/fit-check/?start=${stat.id}#fit-check-form-title`}
                >
                  Start the FitCheck™ here
                </a>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <p class="scroll-hint">
      Scroll to compare <span aria-hidden="true">&#8594;</span>
    </p>
  </div>
</section>

<style>
  h2:first-child {
    margin-top: 0;
  }

  .diagnostics {
    padding-block: var(--section-space);
    border-block-end: var(--border-width) solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .diagnostics-container {
    display: grid;
    width: min(calc(100% - (2 * var(--page-gutter))), var(--container-page));
    margin-inline: auto;
    gap: clamp(2.75rem, 6vw, 5rem);
  }

  .diagnostics-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 0.7fr);
    align-items: end;
    gap: clamp(2.5rem, 8vw, 7rem);
  }

  .eyebrow {
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 24ch;
    margin: 0.75rem 0 0;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h2);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .diagnostics-intro > p {
    max-width: 58ch;
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .diagnostic-list {
    display: grid;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.875rem, 2vw, 1.25rem);
    list-style: none;
  }

  /* One accent for every card. Per-card colours (blue, green, purple,
     orange) read as a template rather than a system. */
  .diagnostic-list > li {
    --diagnostic-accent: var(--color-blue);

    min-width: 0;
    overflow: clip;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card-ambient);
    background: var(--color-surface-pure);
  }

  article {
    display: flex;
    height: 100%;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  h3 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-h4);
    text-wrap: balance;
  }

  .diagnostic-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;
    border-top: var(--border-width) solid var(--color-border);
  }

  .diagnostic-meta dt {
    color: var(--color-text-muted);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
  }

  .diagnostic-meta dd {
    margin: 0.25rem 0 0;
    color: var(--color-ink);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
  }

  .diagnostic-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1.5rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .diagnostic-description {
    max-width: 52ch;
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1.6;
    text-wrap: pretty;
  }

  a {
    display: inline-flex;
    min-height: var(--control-min-size);
    align-items: center;
    gap: 0.55rem;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    text-decoration-color: var(--diagnostic-accent);
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.22em;
    transition:
      color var(--transition-fast),
      gap var(--transition-fast);
  }

  .diagnostic-start {
    color: var(--color-text-muted);
    text-decoration-color: currentColor;
    text-decoration-thickness: 0.06em;
  }

  .arrow {
    color: var(--diagnostic-accent);
    text-decoration: none;
  }

  .scroll-hint {
    display: none;
    margin: -1.75rem 0 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  a:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  @media (hover: hover) {
    a:hover {
      gap: 0.8rem;
      color: var(--diagnostic-accent);
    }
  }

  @media (max-width: 54rem) {
    .diagnostics-intro {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.5rem;
    }

    .diagnostic-list {
      grid-template-columns: none;
      grid-auto-columns: minmax(17.5rem, 82%);
      grid-auto-flow: column;
      margin-inline: -0.25rem;
      padding: 0.25rem 0.25rem 1rem;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-padding-inline: 0.25rem;
      scroll-snap-type: inline mandatory;
      scrollbar-color: var(--color-border-strong) transparent;
      scrollbar-width: thin;
    }

    .diagnostic-list > li {
      scroll-snap-align: start;
    }

    .scroll-hint {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
  }

  @media (max-width: 40rem) {
    .diagnostic-list {
      grid-auto-columns: minmax(17rem, 88%);
    }
  }

  @media (pointer: coarse) {
    a {
      min-height: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .diagnostics,
    .diagnostic-list > li {
      border-color: CanvasText;
      background: Canvas;
    }
  }
</style>
